**==================================================================================================
** 异质性(5)：东部地区 vs 中西部地区（按银行注册地分组）
**==================================================================================================
****************************************************************************************************

**==================================================================================================
* gen     EastRegion = (省份 == "北京" | 省份 == "上海" | 省份 == "广东"  ///
*     | 省份 == "江苏" | 省份 == "浙江" | 省份 == "山东"                 ///
*     | 省份 == "福建" | 省份 == "天津" | 省份 == "河北"                 ///
*     | 省份 == "辽宁" | 省份 == "海南")
*
* reghdfe Y1  $Controls  DID if EastRegion == 1 & samp == 1,            ///
*     a(year bankid) keepsing vce(cluster bankid)
* est sto h5_1
* reghdfe Y1  $Controls  DID if EastRegion == 0 & samp == 1,            ///
*     a(year bankid) keepsing vce(cluster bankid)
* est sto h5_2
* esttab  h5_1 h5_2, se(%12.3f) b(%12.3f) compress nogap               ///
*     s(N r2_a r2_p ll) star(* 0.1 ** 0.05 *** 0.01) varwidth(20)
**==================================================================================================

**==================================================================================================
* bdiff, group(EastRegion) model(reghdfe Y1 $Controls DID,              ///
*     a(year bankid) keepsing vce(cluster bankid)) reps(1000) bsample
**==================================================================================================
****************************************************************************************************




