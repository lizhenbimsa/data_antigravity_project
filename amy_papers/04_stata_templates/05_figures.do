****************************************************************************************************
**==================================================================================================
**  05_figures.do
**  - 商业银行研究图表生成模板
**  - 包含：平行趋势 coefplot、安慰剂核密度图、RDD 断点图、
**    银行类型分布图、时间趋势图
**==================================================================================================
****************************************************************************************************
set more off
clear all
set scheme s1mono


****************************************************************************************************
**==================================================================================================
** 加载数据
**==================================================================================================
****************************************************************************************************
capture use "data/clean_data.dta", clear
if _rc != 0 {
    use "data/data.dta", clear
}




****************************************************************************************************
**==================================================================================================
**#【一、DID 平行趋势检验 coefplot】
**==================================================================================================
****************************************************************************************************

**==================================================================================================
** 步骤1：运行动态效应回归
**==================================================================================================
* reghdfe  Y  $Controls  pre3-pre1  current  post1-post2 post3new,      ///
*     a(year bankid) keepsing vce(cluster bankid)
**==================================================================================================


**==================================================================================================
** 步骤2：绘制系数图
**==================================================================================================
* coefplot, omitted baselevels                                           ///
*     keep(pre3 pre2 pre1 current post1 post2 post3new)                 ///
*     vertical                                                           ///
*     coeflabels(                                                        ///
*         pre3     = "Pre3"                                              ///
*         pre2     = "Pre2"                                              ///
*         pre1     = "Pre1"                                              ///
*         current  = "Current"                                           ///
*         post1    = "Post1"                                             ///
*         post2    = "Post2"                                             ///
*         post3new = "Post3+"                                            ///
*     )                                                                  ///
*     yline(0, lcolor(black) lwidth(thin) lpattern(solid))               ///
*     xline(4, lcolor(blue) lwidth(thin) lpattern(shortdash))            ///
*     ylabel(, labsize(*0.75))                                           ///
*     ylabel(-1.00(0.20)1.00, format(%3.1f) angle(0))                   ///
*     xlabel(, labsize(*0.75))                                           ///
*     ytitle(`"{fontface "宋体":回}"'                                    ///
*            `"{fontface "宋体":归}"'                                    ///
*            `"{fontface "宋体":系}"'                                    ///
*            `"{fontface "宋体":数}"',                                   ///
*         orientation(horizontal) size(small) margin(small))             ///
*     xtitle(`"{fontface "宋体":政策时点}"',                             ///
*         size(small) margin(small))                                     ///
*     addplot(line @b @at, lwidth(thin))                                 ///
*     ciopts(lpattern(shortdash) recast(rcap) msize(small)              ///
*         lwidth(thin))                                                  ///
*     msymbol(circle_hollow) msize(small) mcolor(blue)                  ///
*     mlwidth(thin)                                                      ///
*     levels(90)                                                         ///
*     scheme(s1mono)
*
* graph export "figures/parallel_trends.png", replace width(1600)
**==================================================================================================
****************************************************************************************************




****************************************************************************************************
**==================================================================================================
**#【二、安慰剂检验核密度图】
**==================================================================================================
****************************************************************************************************

**==================================================================================================
* preserve
*
* use "simulations.dta", clear
*
* dpplot beta,                                                           ///
*     xtitle(`"{fontface "宋体":估计系数}"', size(*0.8))                 ///
*     xlabel(, format(%4.3f) labsize(small))                             ///
*     xline(0, lc(black*0.5) lp(solid))                                 ///
*     xline(0.XXX, lc(black*0.5) lp(dash))                              ///
*     ytitle(`"{fontface "宋体":核密度}"', size(*0.8))                   ///
*     ylabel(, nogrid format(%4.3f) labsize(small))                      ///
*     note("") caption("")                                               ///
*     scheme(s1mono) graphregion(fcolor(white))
*
* graph export "figures/placebo_density.png", replace width(1600)
*
* restore
**==================================================================================================
****************************************************************************************************




****************************************************************************************************
**==================================================================================================
**#【三、RDD 断点回归散点图】
**==================================================================================================
****************************************************************************************************

**==================================================================================================
* local cutoff = 8
*
* rdplot Y X, c(`cutoff')                                               ///
*     graph_options(                                                     ///
*         ytitle(`"{fontface "宋体":被解释变量}"', size(small))          ///
*         xtitle(`"{fontface "宋体":监管指标}"', size(small))            ///
*         scheme(s1mono)                                                 ///
*         graphregion(fcolor(white))                                     ///
*     )
*
* graph export "figures/rdd_scatter.png", replace width(1600)
**==================================================================================================
****************************************************************************************************




****************************************************************************************************
**==================================================================================================
**#【四、按银行类型的因变量时间趋势图】
**==================================================================================================
****************************************************************************************************

**==================================================================================================
** 按银行类型分组计算年度均值
**==================================================================================================
* preserve
* collapse (mean) Y1, by(banktype year)
*
* twoway (connected Y1 year if banktype == 1, msymbol(circle))           ///
*        (connected Y1 year if banktype == 2, msymbol(square))           ///
*        (connected Y1 year if banktype == 3, msymbol(triangle))         ///
*        (connected Y1 year if banktype == 4, msymbol(diamond)),         ///
*     ytitle(`"{fontface "宋体":因变量均值}"', size(small))              ///
*     xtitle(`"{fontface "宋体":年份}"', size(small))                    ///
*     legend(label(1 "国有大行") label(2 "股份制") label(3 "城商行")     ///
*            label(4 "农商行") rows(1) size(small))                      ///
*     scheme(s1mono) graphregion(fcolor(white))
*
* graph export "figures/trend_by_banktype.png", replace width(1600)
*
* restore
**==================================================================================================
****************************************************************************************************




****************************************************************************************************
**==================================================================================================
**#【五、处理组与对照组的因变量时间趋势图】
**==================================================================================================
****************************************************************************************************

**==================================================================================================
* preserve
* collapse (mean) Y1, by(Treat year)
*
* twoway (connected Y1 year if Treat == 1, msymbol(circle) lcolor(blue))  ///
*        (connected Y1 year if Treat == 0, msymbol(square) lcolor(red)),  ///
*     ytitle(`"{fontface "宋体":因变量均值}"', size(small))              ///
*     xtitle(`"{fontface "宋体":年份}"', size(small))                    ///
*     xline(政策年份, lcolor(black) lpattern(dash))                      ///
*     legend(label(1 "处理组") label(2 "对照组") rows(1) size(small))    ///
*     scheme(s1mono) graphregion(fcolor(white))
*
* graph export "figures/trend_treat_control.png", replace width(1600)
*
* restore
**==================================================================================================
****************************************************************************************************




****************************************************************************************************
**==================================================================================================
**#【六、分箱散点图（binscatter）】
**==================================================================================================
****************************************************************************************************

**==================================================================================================
* binscatter Y X, nquantiles(20) controls($Controls)                    ///
*     ytitle(`"{fontface "宋体":因变量（残差）}"', size(small))          ///
*     xtitle(`"{fontface "宋体":自变量（残差）}"', size(small))          ///
*     scheme(s1mono) graphregion(fcolor(white))
*
* graph export "figures/binscatter.png", replace width(1600)
**==================================================================================================
****************************************************************************************************




****************************************************************************************************
**==================================================================================================
**#【图表导出设定说明】
**==================================================================================================
****************************************************************************************************
**  - PNG 格式：width(1600) 或更高
**  - PDF 格式（推荐投稿）：graph export "xx.pdf", replace
**  - 配色方案：s1mono（黑白学术期刊推荐）
****************************************************************************************************


