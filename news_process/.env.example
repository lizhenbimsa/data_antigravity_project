# news_process 环境变量模板（Phase 0 冻结，作为后续重整的契约基线）
# ============================================================================
# 用法：复制本文件为 `.env` 并填入真实密钥。`.env` 已在 .gitignore 中，
#       绝不提交至仓库。本模板仅声明变量"名"清单，所有值留空。
# 冻结依据：news_process-restructure-blueprint Phase 0 — 防止后续重整
#           过程中无声引入新的环境变量名或重命名旧变量。
# 校验：core/config.py 加载时若发现未在本清单内的 ${VAR} 占位符，应给出
#       提示信息（Phase 1 落地）。
# ============================================================================

# LLM API 密钥（用于阶段 21 LLM 情感分析的三模型 ensemble + 阶段 32a/33/34/36/39 验证模块）
# 三个模型独立配置，便于多 key 限速分摊；如使用代理端点（如 yunwu.ai），
# 任意值放此即可，base_url 在 config.yaml 的 tone_llm_processing.models 节点指定。
GPT5NANO_API_KEY=
GEMINI3_API_KEY=
CLAUDE4H_API_KEY=

# Embedding API 密钥（用于阶段 15 文章级政策对齐 + 阶段 27 双极锚点投影）
# 当前模型：text-embedding-3-small（OpenAI 兼容），base_url 在 config.yaml 的
# embedding_api 节点指定（默认 https://yunwu.ai/v1）。
EMBEDDING_API_KEY=
