# news_process 环境变量模板（Phase 0 冻结，Plan-r3 P1-4 重整 — 2026-05-09）
# ============================================================================
# 用法：复制本文件为 `.env` 并填入真实密钥。`.env` 已在 .gitignore 中，
#       绝不提交至仓库。本模板仅声明变量"名"清单，所有值留空。
# 冻结依据：news_process-restructure-blueprint Phase 0 — 防止后续重整
#           过程中无声引入新的环境变量名或重命名旧变量。
# 校验：core/config.py:_validate_env_placeholders() 在 load_config() 末段
#       扫描 cfg 中所有 ${VAR} 占位符, 若发现未在本清单 (含 commented-out
#       行) 内的变量, 抛 warning 提示。
#       (Plan-r3 P1-4 落地; 此前 .env.example 第 7-8 行只是承诺未实现.)
# ============================================================================

# ╔══════════════════════════════════════════════════════════════════════════╗
# ║ 必需 (Required) — yaml 实际引用                                            ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# v6/N7 之后统一的 yunwu.ai 聚合代理 API key (单 key 路由 OpenAI/Google/Grok 三家族)
# 用于阶段 21 LLM 情感分析三模型 ensemble + 阶段 32a/33/34/36/39 验证模块
# + 阶段 15 文章级政策对齐 embedding + 阶段 27 双极锚点投影
# 参见 news_process/config/sentiment.yaml (api_key: ${YUNWU_API_KEY})
YUNWU_API_KEY=

DEEPSEEK_API_KEY=


# Embedding API key — 默认与 YUNWU_API_KEY 同源 (yunwu 代理 OpenAI text-embedding-3-small)
# 若希望用 OpenAI 直连或 Anthropic 等独立 embedding 端点, 可单独设置不同 key
EMBEDDING_API_KEY=${YUNWU_API_KEY}

# 本地 BERT 模型目录 — 仅阶段 23 BERT 情感分析的 finbert2 私有微调模型使用
# 跨机器友好: 留空或路径不存在时, stage 23 graceful skip 该模型, 其余 4 个
# huggingface 模型仍正常工作; 不会让整条流水线崩溃。
# 示例: F:/WiseSearch/data_antigravity_project/FinBERT/Fin-labeler/classifier_models/FinBERT2-base_SC_2
FINBERT2_MODEL_DIR=

# ╔══════════════════════════════════════════════════════════════════════════╗
# ║ 可选 / Legacy (Optional) — yaml 不再引用, 仅保留向后兼容                    ║
# ╚══════════════════════════════════════════════════════════════════════════╝
# 历史 (v3-v5 锁定的三家族独立 key) 已在 v6/N7 收敛到 ${YUNWU_API_KEY}.
# 以下 4 个变量在新生产 code path (tone_llms.py / sentiment.yaml) 中已不再被
# 读取; 仅 scripts/audit/_replan_v5_evidence/ 下的探针脚本以及任何外部调用方
# 仍可能引用. 取消注释并填入仅在你需要这些场景时.
# GPT5NANO_API_KEY=${YUNWU_API_KEY}
# GEMINI3_API_KEY=${YUNWU_API_KEY}
# CLAUDE4H_API_KEY=${YUNWU_API_KEY}    # v3 历史名 -> 现重定向 Grok 4.1
# GROK41_API_KEY=${YUNWU_API_KEY}      # v6 新增 (slot 3 真实身份)



