* ============================================================================
* 11_table2_main_iv_2sls.do — Network 2SLS (Bramoulle 2009)
* Paper: {{PAPER_ID}}
*
* Methodology: Bramoulle, Djebbari, Fortin (2009, JoE Proposition 1) —
*   The 2nd-order peer-tone (W^2 × tone) serves as an exclusion-satisfying IV
*   for 1st-order peer-tone (W × tone), conditional on bank+year FE.
* Manski (1993, RES) reflection problem addressed.
* ============================================================================

version 15
clear all
set more off

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"

use "$data_dir/_prepared_panel.dta", clear

* M1: OLS baseline (no IV) — for comparison with 2SLS coefficient magnitude.
reghdfe {{MAIN_DV}}_w {{MAIN_ENDOG}} $controls, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo M1_ols

* M2: Network 2SLS.
capture which ivreghdfe
if _rc {
    display as error "[ERROR] ivreghdfe required for Table 2"
    exit 199
}
ivreghdfe {{MAIN_DV}}_w ({{MAIN_ENDOG}} = {{MAIN_IV}}) $controls, ///
    absorb(bank_id year) cluster({{CLUSTER_VAR}}) ffirst
eststo M2_net2sls

* M3: 2SLS + centrality control (over-identification check via additional IV).
ivreghdfe {{MAIN_DV}}_w ({{MAIN_ENDOG}} = {{MAIN_IV}}) L_btw L_cons L_broker $controls, ///
    absorb(bank_id year) cluster({{CLUSTER_VAR}}) ffirst
eststo M3_2sls_cent

esttab M1_ols M2_net2sls M3_2sls_cent ///
    using "$tables_dir/table2_main_iv_2sls.tex", replace ///
    star(* 0.10 ** 0.05 *** 0.01) se booktabs label compress b(3) ///
    title("Main IV 2SLS --- brokerage_network (Bramoulle 2009)") ///
    mtitles("OLS" "Net-2SLS" "2SLS+Cent") ///
    addnotes("Bank/year FE; SE clustered at province ({{CLUSTER_VAR}}).")

display "[OK] Table 2 → $tables_dir/table2_main_iv_2sls.tex"
