* ============================================================================
* 11_table2_main_iv_2sls.do — 网络 2SLS (Bramoulle 2009)
* Paper: {{PAPER_ID}}
*
* 方法学来源: Bramoulle, Djebbari, Fortin (2009, JoE Proposition 1) —
*   在银行+年份 FE 条件下, 二阶同业语调 (W^2 × tone) 可作满足排他性约束的
*   工具变量, 识别一阶同业语调 (W × tone) 的效应。
* 应对 Manski (1993, RES) reflection problem (反射问题)。
* 白话: "朋友的朋友"的语调只能通过"朋友"传到我这里, 不会直接碰到我 —
*   所以拿二阶邻居的语调当工具变量, 识别一阶邻居语调对我的真实影响。
* ============================================================================

version 19
clear all
set more off

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"

use "$data_dir/_prepared_panel.dta", clear

* M1: OLS 基准 (无 IV) — 与 2SLS 系数量级对比。
reghdfe {{MAIN_DV}}_w {{MAIN_ENDOG}} $controls, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo M1_ols

* ── fix(IV-6, audit PROJECT_REAUDIT_T18 附录B): 生产机 StataNow 19.5 实测 ivreghdfe 因
*   ftools/reghdfe Mata 版本不兼容恒 r(301) (reghdfe/ivreg2 均正常); 旧版"ivreghdfe 缺失
*   即 exit 199"会让全部 IV 列空缺、整表丢失。改镜像 llm_peer/11: 优先 ivreghdfe,
*   缺失【或运行期 r(301) 等失败】→ 自动回退 ivreg2 + 显式 i.bank_id i.year; capture
*   noisily 防弱识别/退化样本 abort; 两估计器皆失败该列优雅缺席 (动态 esttab)。──

* M2: 网络 2SLS。
local _m2 = 0
capture which ivreghdfe
if !_rc {
    capture noisily ivreghdfe {{MAIN_DV}}_w ({{MAIN_ENDOG}} = {{MAIN_IV}}) $controls, ///
        absorb(bank_id year) cluster({{CLUSTER_VAR}}) ffirst
    if !_rc {
        eststo M2_net2sls
        local _m2 = 1
    }
}
if !`_m2' {
    capture which ivreg2
    if !_rc {
        capture noisily ivreg2 {{MAIN_DV}}_w ({{MAIN_ENDOG}} = {{MAIN_IV}}) $controls i.bank_id i.year, ///
            cluster({{CLUSTER_VAR}}) first
        if !_rc eststo M2_net2sls
    }
    else display "[WARN] ivreghdfe 与 ivreg2 均不可用; M2 跳过"
}

* M3: 2SLS + 中心度控制 (模型仍为恰好识别 just-identified)。
* fix(omni-g-templates-03, 2026-06-11): 注释勘误 — 旧注称 "over-identification check
* via additional IV", 但 L_btw/L_cons/L_broker 在 IV 括号外, 是外生控制而非额外工具;
* 模型仍 1 IV / 1 内生 = 恰好识别, Hansen J 不存在 (df=0), 不得宣称 overid 检验。
local _m3 = 0
capture which ivreghdfe
if !_rc {
    capture noisily ivreghdfe {{MAIN_DV}}_w ({{MAIN_ENDOG}} = {{MAIN_IV}}) L_btw L_cons L_broker $controls, ///
        absorb(bank_id year) cluster({{CLUSTER_VAR}}) ffirst
    if !_rc {
        eststo M3_2sls_cent
        local _m3 = 1
    }
}
if !`_m3' {
    capture which ivreg2
    if !_rc {
        capture noisily ivreg2 {{MAIN_DV}}_w ({{MAIN_ENDOG}} = {{MAIN_IV}}) L_btw L_cons L_broker $controls i.bank_id i.year, ///
            cluster({{CLUSTER_VAR}}) first
        if !_rc eststo M3_2sls_cent
    }
}

* ── fix(IV-2, audit PROJECT_REAUDIT_T18 IV-2 P1): Anderson-Rubin 弱工具稳健 CI ──
*   旧脚注规定 KP F < Stock-Yogo 时改读 AR CI, 却从不提供 AR 统计量 ("声明—实现"缺口)。
*   兑现为真命令 (镜像主线 25_tableA6:122-167 的 proven pattern): 先 ivreg2 重估同规格,
*   紧随 weakiv, level(95) 在 log 输出 AR 95% 置信集 (weakiv 读上一条 ivreg2 估计;
*   不抽脆弱标量, 与主线一致)。capture which 守卫 (未装/退化优雅跳过, T=18 激活)。
local ar_note "Anderson-Rubin weak-IV-robust CI NOT computed (weakiv not installed or sample degenerate T=2; ssc install weakiv). "
capture which weakiv
if !_rc {
    capture which ivreg2
    if !_rc {
        capture noisily ivreg2 {{MAIN_DV}}_w ({{MAIN_ENDOG}} = {{MAIN_IV}}) $controls i.bank_id i.year, ///
            cluster({{CLUSTER_VAR}})
        if !_rc {
            capture noisily weakiv, level(95)
            if !_rc {
                local ar_note "Anderson-Rubin weak-IV-robust 95% CI reported in log (weakiv after ivreg2; Andrews-Stock-Sun 2019 ARE); READ AR CI when KP F < Stock-Yogo 16.38. "
                display "  OK IV-2: weakiv AR CI (main 2SLS) logged (`ar_note')"
            }
        }
    }
}

* ── fix(INFER IV-3, audit PROJECT_REAUDIT_T18 IV-3 P1): 省级聚类 G≈31 < 50 → 渐近聚类 SE
*   失真。主 2SLS 补 wild cluster bootstrap (boottest, Roodman et al. 2019) 在 prov 层,
*   wild p 写入 side-channel CSV。boottest 不支持 ivreghdfe 的 absorb → 用 ivreg2 +
*   显式 i.bank_id i.year (boottest 兼容); capture which 守卫 + N 守卫优雅跳过。──
local boot_note "boottest: ado unavailable / sample degenerate (T=2); production prov-level wild bootstrap"
capture which boottest
if !_rc {
    capture which ivreg2
    if !_rc {
        capture noisily ivreg2 {{MAIN_DV}}_w ({{MAIN_ENDOG}} = {{MAIN_IV}}) $controls i.bank_id i.year, ///
            cluster({{CLUSTER_VAR}}) first
        if !_rc {
            capture boottest {{MAIN_ENDOG}}, reps(9999) bootcluster({{CLUSTER_VAR}}) cluster({{CLUSTER_VAR}}) nograph
            if !_rc {
                capture local boot_p = r(p)
                local boot_note "wild-cluster bootstrap p({{MAIN_ENDOG}})=`boot_p' (boottest 9999 reps, bootcluster=province; Roodman et al. 2019)"
                capture file close _btf
                file open _btf using "$tables_dir/table2_brok_boottest.csv", write replace
                file write _btf "stat,value" _n
                file write _btf "wild_p,`boot_p'" _n
                file write _btf "bootcluster,{{CLUSTER_VAR}}" _n
                file write _btf "note,prov-level wild cluster bootstrap (G~31<50, Cameron-Miller 2015; Roodman 2019)" _n
                file close _btf
                display "  OK Panel-main boottest (prov-level): `boot_note'"
            }
        }
    }
}

* fix(network-metrics-audit, 2026-06-13, P1-2): 弱工具诊断 — M2/M3 的 ffirst 让 ivreghdfe
* 内部算第一阶段, 但旧 esttab 从不在 stats() 提取 e(widstat)=KP rk Wald F → 表内无弱工具
* 证据, 与同日主线 25_tableA6:138-145 标准不一致。补 widstat + Stock-Yogo/AR-CI 脚注。
* 名单动态化 (M2/M3 经 ivreghdfe→ivreg2 回退后仍可能缺席, 不硬点名避免 r(111))。
qui estimates dir
local stored `r(names)'
local cand_models M1_ols M2_net2sls M3_2sls_cent
local cand_titles `""OLS" "Net-2SLS" "2SLS+Cent""'
local models ""
local mtitles `""'
local nmod : word count `cand_models'
forvalues i = 1/`nmod' {
    local m : word `i' of `cand_models'
    if `: list m in stored' {
        local models `models' `m'
        local t : word `i' of `cand_titles'
        local mtitles `"`mtitles' "`t'""'
    }
}
if "`models'" == "" {
    display as error "  [WARN] Table 2 无任何已存储估计 (ivreghdfe/ivreg2 均失败?), 表跳过"
    exit 0
}
esttab `models' ///
    using "$tables_dir/table2_main_iv_2sls.tex", replace ///
    star(* 0.10 ** 0.05 *** 0.01) se booktabs label compress b(3) ///
    stats(N r2 widstat, fmt(0 3 3) labels("N" "R-squared" "KP rk Wald F")) ///
    title("Main IV 2SLS --- brokerage_network (Bramoulle 2009)") ///
    mtitles(`mtitles') ///
    addnotes("Bank/year FE; SE clustered at province ({{CLUSTER_VAR}}); estimator ivreghdfe with ivreg2+i.bank_id i.year runtime fallback (IV-6)." ///
             "KP rk Wald F = Kleibergen-Paap rk Wald first-stage F (e(widstat); blank for OLS / ivreg2 fallback if not stored)." ///
             "Single instrument W2*tone, just-identified (1 IV / 1 endogenous) -> Hansen J undefined (df=0)." ///
             "Stock-Yogo 10% maximal-size critical value (1 instrument) = 16.38; KP F below it => weak IV =>" ///
             "read Anderson-Rubin weak-IV-robust CI, NOT the 2SLS point/SE. `ar_note'" ///
             "Inference: `boot_note' (-> table2_brok_boottest.csv); province clusters G~31<50 (Cameron-Miller 2015) => wild bootstrap preferred over asymptotic cluster SE." ///
             "Exclusion of W2*tone (Bramoulle-Djebbari-Fortin 2009; Manski 1993) is asserted on the mechanical" ///
             "friends-of-friends-only-via-friends argument and must be defended economically in the paper text.")

display "[OK] Table 2 → $tables_dir/table2_main_iv_2sls.tex"
