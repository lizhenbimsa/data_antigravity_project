* ============================================================================
* 01_data_prep.do — Load + xtset + province encode (brokerage_network)
* Paper: {{PAPER_ID}}
*
* Cluster level: {{CLUSTER_VAR}} (province). Rationale: Cameron-Miller 2015 JHR
*   plus consistency with project-level LOO province IV.
* ============================================================================

version 15
clear all
set more off

if "$data_dir" == ""  global data_dir "../data"
if "$panel_dta" == "" global panel_dta "$data_dir/40_panel_yearly.dta"

use "$panel_dta", clear
encode target_bank, gen(bank_id)
xtset bank_id year

* Province encoding for cluster level (project convention).
capture confirm variable {{CLUSTER_VAR}}
if _rc {
    capture confirm variable bank_province
    if _rc {
        display as error "[ERROR] neither {{CLUSTER_VAR}} nor bank_province found"
        exit 198
    }
    encode bank_province, gen({{CLUSTER_VAR}})
}

global controls "{{CONTROLS}}"

* Required: endog tone, IV (2nd-order), centrality vars, treatment dummies.
foreach v in {{MAIN_DV}} {{MAIN_ENDOG}} {{MAIN_IV}} {{CENTRALITY_BTW}} {{CENTRALITY_CONS}} {{CENTRALITY_BROKER}} {{TREATMENT_DCEP}} {{TREATMENT_SANDBOX}} {
    capture confirm variable `v'
    if _rc {
        display as error "[ERROR] required variable `v' missing"
        exit 198
    }
}

* Lagged centrality (avoids contemporaneous reverse causality with policy).
gen L_btw       = L.{{CENTRALITY_BTW}}
gen L_cons      = L.{{CENTRALITY_CONS}}
gen L_broker    = L.{{CENTRALITY_BROKER}}

capture which winsor2
if !_rc winsor2 {{MAIN_DV}}, cuts(1 99) suffix(_w)
else gen {{MAIN_DV}}_w = {{MAIN_DV}}

save "$data_dir/_prepared_panel.dta", replace
display "[OK] data prep N=" _N
