* ============================================================================
* 01_data_prep.do — 加载 + xtset + 省份 encode (brokerage_network)
* Paper: {{PAPER_ID}}
*
* 聚类层级: {{CLUSTER_VAR}} (省份)。依据: Cameron-Miller 2015 JHR,
*   并与项目级 LOO (leave-one-out) 省份 IV 保持一致。
* ============================================================================

version 19
clear all
set more off

if "$data_dir" == ""  global data_dir "../data"
if "$panel_dta" == "" global panel_dta "$data_dir/40_panel_yearly.dta"

use "$panel_dta", clear
encode target_bank, gen(bank_id)
xtset bank_id year

* 省份 encode 为聚类层级 (项目约定)。
capture confirm variable {{CLUSTER_VAR}}
if _rc {
    capture confirm variable bank_province
    if _rc {
        display as error "[ERROR] neither {{CLUSTER_VAR}} nor bank_province found"
        exit 198
    }
    encode bank_province, gen({{CLUSTER_VAR}})
}

global controls "{{CONTROLS}}"
* $bank_controls 保留为 $controls 的兼容性 alias (部分 robustness 模板引用)
global bank_controls "$controls"

* 必需列: 内生 tone、IV (二阶同业)、中心度变量、政策处理 dummy (pipeline 产出)。
foreach v in {{MAIN_ENDOG}} {{MAIN_IV}} {{CENTRALITY_BTW}} {{CENTRALITY_CONS}} {{CENTRALITY_BROKER}} {{TREATMENT_DCEP}} {{TREATMENT_SANDBOX}} {
    capture confirm variable `v'
    if _rc {
        display as error "[ERROR] required variable `v' missing — run stage 24 (herd_decay network) + 45 (panel) first"
        exit 198
    }
}

* fix(omni-g-replication-01, 2026-06-11): MAIN_DV ({{MAIN_DV}}) 是外部财务列 sentinel
* (bank-year panel 无 ROA 列); 缺失时给出明确指引而非裸 "missing" (00_master fail-loud)。
capture confirm variable {{MAIN_DV}}
if _rc {
    display as error "[ERROR] required outcome {{MAIN_DV}} missing — 外部银行财务面板未接入 (config/银行面板2007-2025年.xlsx 待接入)"
    exit 198
}

* 滞后中心度 (避免与政策的同期反向因果)。
gen L_btw       = L.{{CENTRALITY_BTW}}
gen L_cons      = L.{{CENTRALITY_CONS}}
gen L_broker    = L.{{CENTRALITY_BROKER}}

capture which winsor2
if !_rc winsor2 {{MAIN_DV}}, cuts(1 99) suffix(_w)
else gen {{MAIN_DV}}_w = {{MAIN_DV}}

save "$data_dir/_prepared_panel.dta", replace
display "[OK] data prep N=" _N
