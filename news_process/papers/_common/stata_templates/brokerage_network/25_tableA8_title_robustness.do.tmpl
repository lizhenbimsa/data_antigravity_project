* news_process v3.7.4 (Panel D/E) — Table A8: Headline-Only Sentiment Robustness ({{PAPER_ID}})
* ============================================================================
* 25_tableA8_title_robustness.do — v3.7.4 (Panel D/E added; v3.7.3 Plan A v1.0 lineage)
* Paper: {{PAPER_ID}} (brokerage_network)
* Purpose: _title 切片轨稳健性 (网络中心性 × _title tone).
*
* Anchor:
*   - Heston & Sinha (2017) FAJ; LM (2016) JAR §6; Boudoukh et al. (2019) RFS
*   - Burt (1992) Structural Holes (P origin)
*   - Campbell & Fiske (1959) — MTMM
* ============================================================================

version 19
clear all
set more off
set maxvar 32767
set linesize 120

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"

use "$data_dir/_prepared_panel.dta", clear
set seed {{RANDOM_SEED}}

local title_var = subinstr("{{MAIN_TREAT}}", "_ctx", "_title", .)
local title_var = subinstr("`title_var'", "_full", "_title", .)

* ==== v3.7.5 Table A8 hardening (Item 4 no-op fix + F2 reghdfe gating + F5 dynamic esttab) ====
* (a) title_applicable=0 when MAIN_TREAT lacks a _full/_ctx suffix (subinstr no-op -> title_var==MAIN_TREAT);
*     prevents the degenerate Panel A/B that silently re-runs the main regression (e.g. strategic_diff strat_diff_n5).
* (b) has_dv/has_treat gate every reghdfe so an absent MAIN_DV/MAIN_TREAT does not r(111)-abort the .do.
* (c) a8_models/a8_titles drive a dynamic, scoped esttab (3 A/B/C estimates only) so a skipped panel never crashes the table.
local title_applicable = ("`title_var'" != "{{MAIN_TREAT}}")
if !`title_applicable' display "  [WARN] {{MAIN_TREAT}} has no _full/_ctx suffix; no genuine _title variant -> Panels A/B N/A."
capture confirm variable {{MAIN_DV}}
local has_dv = (_rc == 0)
capture confirm variable {{MAIN_TREAT}}
local has_treat = (_rc == 0)
local a8_models ""
local a8_titles ""
* v3.7.6: separate accumulator for Panel D/E stratified models (own table)
local de_models ""

display "  [brokerage] {{PAPER_ID}}: title_var = `title_var'"

capture confirm variable `title_var'
if `title_applicable' & `has_dv' & `has_treat' & !_rc {
    reghdfe {{MAIN_DV}} `title_var' $bank_controls, ///
        absorb(bank_id year) vce(cluster bank_id year)
    eststo m_title_only
    local a8_models "`a8_models' m_title_only"
    local a8_titles `"`a8_titles' "Title-only""'

    reghdfe {{MAIN_DV}} {{MAIN_TREAT}} `title_var' $bank_controls, ///
        absorb(bank_id year) vce(cluster bank_id year)
    eststo m_main_plus_title
    local a8_models "`a8_models' m_main_plus_title"
    local a8_titles `"`a8_titles' "Main+Title""'
    test {{MAIN_TREAT}} = `title_var'
    display "  Wald test: p = " r(p)
}
else {
    display "  [WARN] `title_var' not in panel"
}

capture confirm variable tone_gap_title_full
if `has_dv' & `has_treat' & !_rc {
    reghdfe {{MAIN_DV}} {{MAIN_TREAT}} tone_gap_title_full $bank_controls, ///
        absorb(bank_id year) vce(cluster bank_id year)
    eststo m_with_gap
    local a8_models "`a8_models' m_with_gap"
    local a8_titles `"`a8_titles' "+Gap control""'
}


* ---------------------------------------------------------------------------
* Panel D (v3.7.4): stratify by frac_title_mentions_fintech across 3 thresholds
* {0.3, 0.5, 0.7} — Antweiler-Frank (2004) JF 59(3) subject-relevance
* threshold sensitivity convention. Hassan et al. (2019) QJE §IV.A
* sub-window analysis. Per-cell graceful skip if N < 30.
* ---------------------------------------------------------------------------
capture confirm variable frac_title_mentions_fintech
if `has_dv' & `has_treat' & !_rc {
    foreach tau in 0.3 0.5 0.7 {
        local thr_str = subinstr("`tau'", ".", "p", .)
        quietly count if frac_title_mentions_fintech > `tau' & !missing(frac_title_mentions_fintech)
        local n_above = r(N)
        quietly count if frac_title_mentions_fintech <= `tau' & !missing(frac_title_mentions_fintech)
        local n_below = r(N)
        display "  Panel D τ=`tau': N above=`n_above', N below=`n_below'"
        if `n_above' >= 30 {
            reghdfe {{MAIN_DV}} {{MAIN_TREAT}} $bank_controls ///
                if frac_title_mentions_fintech > `tau' & !missing(frac_title_mentions_fintech), ///
                absorb(bank_id year) vce(cluster bank_id year)
            eststo m_panelD_above_`thr_str'
        local de_models "`de_models' m_panelD_above_`thr_str'"
        }
        else {
            display "    [WARN] Panel D τ=`tau' above: N=`n_above' < 30, skip"
        }
        if `n_below' >= 30 {
            reghdfe {{MAIN_DV}} {{MAIN_TREAT}} $bank_controls ///
                if frac_title_mentions_fintech <= `tau' & !missing(frac_title_mentions_fintech), ///
                absorb(bank_id year) vce(cluster bank_id year)
            eststo m_panelD_below_`thr_str'
        local de_models "`de_models' m_panelD_below_`thr_str'"
        }
        else {
            display "    [WARN] Panel D τ=`tau' below: N=`n_below' < 30, skip"
        }
    }
}
else {
    display "  [WARN] frac_title_mentions_fintech not in panel; Panel D skipped"
}

* ---------------------------------------------------------------------------
* Panel E (v3.7.4): stratify by frac_title_long (bank-year median title length)
* Anchor: Da-Engelberg-Gao (2011) JF 66(5) attention-channel separation
* (short titles → attention channel; long titles → substance channel);
* Tetlock (2007) JF 62(3) length-based information content.
* Per-cell graceful skip if N < 30.
* ---------------------------------------------------------------------------
capture confirm variable frac_title_long
if `has_dv' & `has_treat' & !_rc {
    quietly summarize frac_title_long if !missing(frac_title_long), detail
    local med_ftl = r(p50)
    quietly count if frac_title_long > `med_ftl' & !missing(frac_title_long)
    local n_long = r(N)
    quietly count if frac_title_long <= `med_ftl' & !missing(frac_title_long)
    local n_short = r(N)
    display "  Panel E: N long-title=`n_long', N short-title=`n_short'"
    if `n_long' >= 30 {
        reghdfe {{MAIN_DV}} {{MAIN_TREAT}} $bank_controls ///
            if frac_title_long > `med_ftl' & !missing(frac_title_long), ///
            absorb(bank_id year) vce(cluster bank_id year)
        eststo m_panelE_long
        local de_models "`de_models' m_panelE_long"
    }
    else {
        display "    [WARN] Panel E long: N=`n_long' < 30, skip"
    }
    if `n_short' >= 30 {
        reghdfe {{MAIN_DV}} {{MAIN_TREAT}} $bank_controls ///
            if frac_title_long <= `med_ftl' & !missing(frac_title_long), ///
            absorb(bank_id year) vce(cluster bank_id year)
        eststo m_panelE_short
        local de_models "`de_models' m_panelE_short"
    }
    else {
        display "    [WARN] Panel E short: N=`n_short' < 30, skip"
    }
}
else {
    display "  [WARN] frac_title_long not in panel; Panel E skipped"
}

* ---------------------------------------------------------------------------
* Panel F (v3.7.5, D4): GENUINE 2SLS title robustness for brokerage_network.
* The headline result is IV — peer_tone_lag1 instrumented by the 2nd-order
* network peer tone (peer_tone_2nd_lag1; Bramoulle-Djebbari-Fortin 2009 RES).
* Both _title columns already exist on the panel ($0, no panel change), so we
* report the title-level 2SLS rather than a title OLS-on-endogenous reduced-form.
* ---------------------------------------------------------------------------
capture confirm variable peer_tone_lag1_title
local has_endog_t = (_rc == 0)
capture confirm variable peer_tone_2nd_lag1_title
local has_iv_t = (_rc == 0)
capture confirm variable {{CLUSTER_VAR}}
local has_clu = (_rc == 0)
local m_iv_done = 0
if `has_dv' & `has_endog_t' & `has_iv_t' & `has_clu' {
    * Preferred: ivreghdfe (absorbed HDFE 2SLS), single cluster on the paper's
    * CLUSTER_VAR ({{CLUSTER_VAR}}, NOT an absorbed FE dim) + ffirst.
    capture which ivreghdfe
    if !_rc {
        capture noisily ivreghdfe {{MAIN_DV}} (peer_tone_lag1_title = peer_tone_2nd_lag1_title) $bank_controls, ///
            absorb(bank_id year) cluster({{CLUSTER_VAR}}) ffirst
        if !_rc local m_iv_done = 1
    }
    * Fallback (robust at T=2, where absorbing bank FE makes the HDFE robust VCV
    * degenerate): ivreg2 with explicit FE dummies. Mirrors 11_table2_main_iv_2sls fallback.
    if !`m_iv_done' {
        capture noisily ivreg2 {{MAIN_DV}} (peer_tone_lag1_title = peer_tone_2nd_lag1_title) $bank_controls i.bank_id i.year, ///
            cluster({{CLUSTER_VAR}})
        if !_rc local m_iv_done = 1
    }
    if `m_iv_done' {
        eststo m_iv_title
        local a8_models "`a8_models' m_iv_title"
        local a8_titles `"`a8_titles' "IV-title (2SLS)""'
    }
    else {
        display "  [WARN] Panel F (IV-title): ivreghdfe and ivreg2 both failed; skipped."
    }
}
else {
    display "  [WARN] Panel F (IV-title) skipped: missing peer_tone_lag1_title / peer_tone_2nd_lag1_title / {{CLUSTER_VAR}}."
}

* ==== v3.7.6 Panel D/E export ====
* The Panel D/E stratified models were eststo-only (never tabulated) before
* v3.7.6. Write them to a SEPARATE skip-safe table so the subsample columns
* are not conflated with the A/B/C substitution columns.
if "`de_models'" != "" {
    esttab `de_models' ///
        using "$tables_dir/tableA8_panelDE_strat.tex", ///
        se star(* 0.10 ** 0.05 *** 0.01) replace ///
        title("Table A8 (Panel D/E): Stratified Headline Robustness — {{PAPER_ID}}") ///
        nonotes ///
        addnote("Panel D: subsample by frac_title_mentions_fintech vs tau in {0.3,0.5,0.7} " ///
                "(Antweiler-Frank 2004 JF subject-relevance threshold sensitivity). " ///
                "Panel E: above/below bank-year MEDIAN frac_title_long " ///
                "(attention-channel motivation, Da-Engelberg-Gao 2011 JF). " ///
                "Per-cell N>=30 graceful skip; rows with missing frac excluded.")
    display "  [done] Panel D/E stratified table: $tables_dir/tableA8_panelDE_strat.tex"
}
else display "  [WARN] Panel D/E: no subsample cell with N>=30; stratified table skipped."

if "`a8_models'" == "" {
    display "  [WARN] Table A8: no estimable panel for {{PAPER_ID}}; writing stub .tex."
    file open _a8stub using "$tables_dir/tableA8_title_robustness.tex", write replace
    file write _a8stub "% Table A8 N/A for {{PAPER_ID}}: no usable _title panel (MAIN cols or _title variant absent)." _n
    file close _a8stub
}
else esttab `a8_models' ///
    using "$tables_dir/tableA8_title_robustness.tex", ///
    se star(* 0.10 ** 0.05 *** 0.01) replace ///
    mtitles(`a8_titles') ///
    title("Table A8: Headline Robustness — {{PAPER_ID}} (brokerage_network)") ///
    nonotes ///
    addnote("Panel F (v3.7.5): GENUINE 2SLS title robustness — peer_tone_lag1_title instrumented by the 2nd-order network peer tone peer_tone_2nd_lag1_title (Bramoulle et al. 2009 RES); both columns pre-exist on the panel. " ///
            "Anchors: Heston-Sinha (2017 FAJ); LM (2016 JAR §6); Burt (1992).")

display "  [done] Table A8 written for brokerage_network"
