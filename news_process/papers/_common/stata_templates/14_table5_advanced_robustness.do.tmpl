* news_process v3.2.0 — Table 5: 高阶稳健性 Advanced Robustness (plan v14 §9.2)
*
* 高阶稳健性 (顶刊 standard):
*   1. Placebo test (随机分配处理变量, β 应为 0)
*   2. Permutation inference (无参数化 p-value, MacKinnon & Webb 2020 J.Econometrics 218(2):435-450)
*   3. Sub-period split (前后子样本 β 一致性)
*   4. Drop one bank at a time (influential observation 检验)
*
* Main spec: locus={{MAIN_LOCUS_TRACK}} subst={{MAIN_SUBST_TRACK}} sent={{MAIN_SENT_TRACK}}

version 19

* fix(omni-g-templates-14, 2026-06-11): 隔离估计命名空间 (主线模板链共享 session)
eststo clear

local DV     llm_vote_tone_{{MAIN_SENT_TRACK}}
local LOCUS  tech_frac_{{MAIN_LOCUS_TRACK}}
local SUBST  symb_frac_{{MAIN_SUBST_TRACK}}
local EXPL   digital_frontier

* V5 / st-table2-main-04 fix (2026-06-03): full 轨 (lf/sf) 展开成幻影列
* tech_frac_lf / symb_frac_sf (面板无, 只有裸名 tech_frac/symb_frac 与 ctx 轨
* tech_frac_lc/symb_frac_sc). 缺列时下方 reghdfe 引用为控制变量会 r(111) 崩.
* 加守卫: 缺列则置空, degrade 为不含 LOCUS/SUBST 的稳健性回归.
capture confirm variable `LOCUS' `SUBST'
if _rc {
    display "  ⚠️ LOCUS/SUBST 列缺 (`LOCUS' / `SUBST'): full 轨须用裸名, 见 stata_runner; 稳健性回归 degrade 为不含 LOCUS/SUBST"
    local LOCUS
    local SUBST
}

* --- 5a: Placebo test (随机化处理变量, set seed 12345) ---
* fix(omni-g-templates-15, 2026-06-11) (c): 真置换 (permutation) 替代 iid 重抽 —
* 旧 `bysort bank_id: gen _rand_treat = runiformint(0, 1)` 是逐观测 iid Bernoulli(0.5),
* 既不保留处理变量的边际分布 (处理银行数随机漂移), bysort 无 stable 平局序也非确定,
* 与旧注释"随机置换 (保 bank-level 数量)"不符。现改为银行级真 shuffle (Fisher 置换
* 检验语义): bank-level 处理值在银行之间重排, 处理者数量精确保持。
* 白话: 把"哪些银行算处理组"的标签在银行之间随机洗牌后重跑回归; 假标签也跑出显著
* 结果就说明主结果可疑, 洗牌时处理组银行的总个数保持不变。
preserve
    set seed 12345
    capture confirm variable `EXPL'
    if !_rc {
        * 银行级处理值取 bank 内首值 (digital_frontier 为 bank-level 常量;
        * sort key 含 `EXPL' 保证取值确定); 随机秩 _rank 把值重排到其他银行
        tempname pfr
        frame put bank_id `EXPL', into(`pfr')
        frame `pfr' {
            bysort bank_id (`EXPL'): keep if _n == 1
            gen double _u = runiform()
            sort _u bank_id
            gen long _rank = _n
            sort bank_id
            gen rand_treat = `EXPL'[_rank]
            keep bank_id rand_treat
        }
        frlink m:1 bank_id, frame(`pfr')
        * fix(reaudit-t18-2026-06-14): frget 静默拒绝复制名以下划线开头的变量
        * (实测 "variable not copied: _rand_treat" / 0 copied → 下方 reghdfe r(111) 中断
        * 整张 Table 5, 含本轮 reaudit 的 5d 野聚类 boottest 块永不执行)。改用无下划线
        * 名 rand_treat → frget 正常复制 (置换检验语义不变)。
        frget rand_treat, from(`pfr')

        eststo PLACEBO: reghdfe `DV' rand_treat `LOCUS' `SUBST', ///
            absorb(bank_id year) vce(cluster bank_id)
        frame drop `pfr'
    }
restore

* --- 5b: Sub-period split 子期切分 ---
quietly summarize year
local median_year = floor((r(min) + r(max)) / 2)

* fix(omni-g-templates-15, 2026-06-11) (d): 子期切分零观测守卫 — T=2 面板
* (years={2017,2018}) 下 floor 中位年=2017, `year < 2017` 为空 → reghdfe r(2000) 崩。
* 任一子样本为空时跳过 5b (T≥3 全量面板正常执行)。
quietly count if year < `median_year'
local n_early = r(N)
quietly count if year >= `median_year'
local n_late = r(N)
if `n_early' > 0 & `n_late' > 0 {
    eststo SUB_EARLY: reghdfe `DV' `EXPL' `LOCUS' `SUBST' if year < `median_year', ///
        absorb(bank_id year) vce(cluster bank_id)
    eststo SUB_LATE:  reghdfe `DV' `EXPL' `LOCUS' `SUBST' if year >= `median_year', ///
        absorb(bank_id year) vce(cluster bank_id)
}
else {
    display "  ⚠️ 5b sub-period split 跳过: 早期子样本 N=`n_early' / 晚期 N=`n_late' (T 过短)"
}

* --- 5c: 逐一剔除银行 Drop one bank at a time (influential obs 检验) ---
* 主回归系数稳健性: β across leave-one-out 应在主回归 95% CI 内
* 白话: 每次剔除一家银行重跑回归, 看系数是否仍落在全样本 95% 置信区间内, 防止结果被个别银行带偏。
* fix(omni-g-templates-15, 2026-06-11) (b): 实装 95% CI 判定 — 旧版 n_stable 无条件
* 自增 (b_coef 算出即弃), 表注的稳定性比率恒为 100%, 是装饰性假统计量。现先估全样本
* 主回归取 β̂±1.96·SE, 循环内逐一比较后计数。
quietly reghdfe `DV' `EXPL' `LOCUS' `SUBST', absorb(bank_id year) vce(cluster bank_id)
local b_main  = _b[`EXPL']
local se_main = _se[`EXPL']
local ci_lo = `b_main' - 1.96*`se_main'
local ci_hi = `b_main' + 1.96*`se_main'
quietly levelsof bank_id, local(banks)
local n_banks : word count `banks'
local n_stable = 0
foreach b of local banks {
    quietly reghdfe `DV' `EXPL' `LOCUS' `SUBST' if bank_id != `b', ///
        absorb(bank_id year) vce(cluster bank_id)
    local b_coef = _b[`EXPL']
    if !missing(`b_coef') & inrange(`b_coef', `ci_lo', `ci_hi') {
        local n_stable = `n_stable' + 1
    }
}
display "  Leave-one-out stable specs: `n_stable'/`n_banks' (within full-sample 95% CI [`ci_lo', `ci_hi'])"

* --- 5d: 野聚类自助法 Wild bootstrap (MacKinnon & Webb 2020 J.Econometrics 218(2):435-450, 小聚类数情形) ---
* 必装包: ssc install boottest
* 白话: 银行 (聚类) 个数偏少时, 普通聚类标准误会低估不确定性; wild cluster bootstrap
* 通过对残差反复重抽样重新算 p 值, 给出小样本下更可信的显著性判断。
capture which boottest
if !_rc {
    reghdfe `DV' `EXPL' `LOCUS' `SUBST', absorb(bank_id year) vce(cluster bank_id)
    * fix(omni-g-templates-15, 2026-06-11) (a): 旧 `eststo MAIN_BOOT: estimates store`
    * 是语法错误 (estimates store 必须带名字, 实证 r(100) 'name required'), 且在
    * which boottest 通过分支内无 capture → 装了 boottest 反而整个 do-file 中断。
    * 改为: boottest 后以 estadd 把 wild p 注入 e(), 再裸 eststo 存储 — wild p
    * 进表而非只留 log (boottest 按设计不改写 e(b)/e(V), 结果在 r(p))。
    boottest `EXPL'=0, reps(999) cluster(bank_id) seed(54321) nograph
    local boot_p = r(p)
    estadd scalar p_wild = r(p)
    eststo MAIN_BOOT
    display "  Wild bootstrap p (n_reps=999): `boot_p'"
}
else {
    display "  ⚠️ boottest not installed (ssc install boottest); 5d 跳过"
}

* 输出
* fix(omni-g-templates-15, 2026-06-11): esttab 名单动态化 (PLACEBO/SUB_*/MAIN_BOOT
* 均可能被守卫跳过, 旧版硬点名缺名 r(111) 丢整表); MAIN_BOOT 列入表并报 wild p。
qui estimates dir
local stored `r(names)'
local cand_models PLACEBO SUB_EARLY SUB_LATE MAIN_BOOT
local cand_titles `""Placebo (perm.)" "Pre `=`median_year'-1'" "Post `median_year'" "Main (wild boot)""'
local models ""
local mtitles `""'
local nmod : word count `cand_models'
forvalues i = 1/`nmod' {
    local m : word `i' of `cand_models'
    if `: list m in stored' {
        local models `models' `m'
        local t : word `i' of `cand_titles'
        local mtitles `"`mtitles' "`t'""'
    }
}
if "`models'" == "" {
    display as error "  ⚠️ Table 5 无任何已存储估计, 表跳过"
}
else {
    esttab `models' using "output/tables/table5_advanced_robust.tex", ///
        se star(* 0.10 ** 0.05 *** 0.01) ///
        booktabs replace fragment ///
        stats(N p_wild, fmt(0 3) labels("N" "Wild cluster bootstrap p")) ///
        title("Table 5: Advanced Robustness — Placebo + Sub-period + Leave-one-out + Wild bootstrap") ///
        mtitles(`mtitles') ///
        note("Placebo: bank-level permutation of treatment (treated count preserved); β should be insignificant. " ///
             "Leave-one-out: `n_stable'/`n_banks' bank exclusions yield β within the full-sample 95% CI. " ///
             "MacKinnon & Webb 2020 (J.Econometrics 218(2):435-450) wild cluster bootstrap p reported in the Main column (boottest, 999 reps). " ///
             "IDENTIFICATION NOTE: digital_frontier is a base-year within-bank time-invariant 0/1 classifier, so in every " ///
             "absorb(bank_id ...) column here it is collinear with the bank FE and silently dropped; beta(digital_frontier) " ///
             "is identified only in a no-absorb column (see 11_table2 M1). These robustness columns identify the within-bank " ///
             "time-varying terms (LOCUS/SUBST controls); the frontier main effect is absorbed.")

    * fix(omni-g-esttab-csv, 2026-06-11): CSV side-channel (parse_esttab_csv 消费)
    estout `models' using "output/tables/table5_advanced_robust.csv", replace delimiter(",") ///
        cells(b(star fmt(3)) se(par fmt(3))) stats(N p_wild, fmt(0 3)) ///
        starlevels(* 0.10 ** 0.05 *** 0.01) mlabels(`mtitles')

    display "✅ Table 5 written to output/tables/table5_advanced_robust.tex (+ .csv side-channel)"
}
