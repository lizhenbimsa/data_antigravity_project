* ============================================================================
* 20_attention_fe_saturation_estrobust.do — Table A8 (bank_fintech_attention / P2)
* Paper: {{PAPER_ID}}
*
* 一张多 Panel 稳健性表 (Table A8), 三族互补:
*   Panel A  FE-SAT     固定效应饱和阶梯 (saturated fixed effects ladder)
*   Panel B  ROBUST-EST 离群稳健估计 (outlier-robust estimators: qreg / rreg)
*   Panel C  OSTER      不可观测选择性偏误边界 (Oster 2019 δ)
*
* ── 大白话 ────────────────────────────────────────────────────────────────
*   是什么: 在双向固定效应 (bank+year) 之外, 多换几种"更严格的设定"和"更抗
*           离群点的估计量", 再算一个"看不见的遗漏变量得多强才能翻盘"的边界,
*           三管齐下证明主结论不是靠某一种设定或某几家异常银行撑起来的。
*   为什么: 顶刊审稿人会怀疑 (i) 同省/同区域的共同冲击 (监管、扩散) 被漏控,
*           (ii) 少数高杠杆银行年观测驱动结果, (iii) 不可观测变量的选择性偏误。
*   影响:   只读在盘列 + 全 capture 守卫 → golden-safe; 财务 outcome 未接入时
*           各 Panel 优雅跳过 (wire-ahead), 接入后自动激活, 不改 panel/golden。
*
* ── 文献锚点 (DOI 均已核验) ────────────────────────────────────────────────
*   Panel A  Gormley, T. A., & Matsa, D. A. (2014). Common errors: How to
*            (and not to) control for unobserved heterogeneity. Review of
*            Financial Studies, 27(2), 617-661. doi:10.1093/rfs/hht047
*            → 用饱和 FE (组×时间) 吸收同组共同冲击, 排除遗漏的组×时间混淆。
*   Panel B  Koenker, R., & Bassett, G. (1978). Regression quantiles.
*            Econometrica, 46(1), 33-50. doi:10.2307/1913643
*            (rreg: Huber/Tukey 迭代加权稳健回归, Stata 内置, 无单一 DOI。)
*   Panel C  Oster, E. (2019). Unobservable selection and coefficient
*            stability: Theory and evidence. Journal of Business & Economic
*            Statistics, 37(2), 187-204. doi:10.1080/07350015.2016.1227711
*
* ⚠ spec FORBIDDEN: bank_type × year 交互固定效应。该交互会把 leave-one-out
*   peer-attention IV 变成内生镜像 (corr -0.67~-0.84, 见 spec.identification.iv),
*   故 Panel A 饱和阶梯刻意只含 province×year / zone×year / bank 线性趋势,
*   绝不加 bank_type×year。
* ============================================================================

version 19
clear all
set more off
set maxvar 32767
set linesize 120
eststo clear

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"

use "$data_dir/_prepared_panel.dta", clear

set seed {{RANDOM_SEED}}

* ----------------------------------------------------------------------------
* 公共守卫: outcome / treatment 在不在盘 (financial DV = wire-ahead sentinel)
* ----------------------------------------------------------------------------
local have_dv = 0
capture confirm variable {{MAIN_DV}}
if !_rc local have_dv = 1
local have_treat = 0
capture confirm variable {{MAIN_TREAT}}
if !_rc local have_treat = 1
if `have_dv' == 0 {
    display as text "  [WIRE-AHEAD] {{MAIN_DV}} 不在盘 (外部财务面板待接入); Table A8 各回归 Panel 优雅跳过, 仅写空表占位"
}
if `have_treat' == 0 {
    display as error "  [WARN] {{MAIN_TREAT}} 不在盘 — 上游 stage 14/45 未产出 treatment, Table A8 跳过"
}

* T 守卫: 部分设定 (bank 线性趋势 / 大样本分位回归) 需 T≥3; 当前盘早期试跑 T=2 退化
quietly levelsof year, local(_yrs)
local n_years : word count `_yrs'
display as text "  [INFO] panel T (distinct years) = `n_years' (production T=19 才有线性趋势/分位回归全功效)"

* string 分组列 → 数值化 (factor 变量 i.var#i.year 需 numeric)
capture confirm variable bank_province
if !_rc {
    capture confirm numeric variable bank_province
    if _rc encode bank_province, gen(_prov_id)
    else gen long _prov_id = bank_province
}
capture confirm variable bank_zone
if !_rc {
    capture confirm numeric variable bank_zone
    if _rc encode bank_zone, gen(_zone_id)
    else gen long _zone_id = bank_zone
}

* ============================================================================
* Panel A — FE-SAT 固定效应饱和阶梯
* 白话: 从最朴素的 bank+year 双向 FE 起步, 一级级加上"省份×年""区域×年"和
*       "每家银行各自的线性时间趋势", 看主系数稳不稳。每加一级都吸收掉一类
*       潜在的同组共同冲击。
* ============================================================================
if `have_dv' & `have_treat' {

    * M0 baseline: bank + year 双向 FE (与主回归同设定)
    capture noisily reghdfe {{MAIN_DV}} {{MAIN_TREAT}} $controls, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    if !_rc eststo fesat_m0

    * M1 + province × year (同省监管 / 区域政策冲击)
    capture confirm variable _prov_id
    if !_rc {
        capture noisily reghdfe {{MAIN_DV}} {{MAIN_TREAT}} $controls, ///
            absorb(bank_id year _prov_id#year) vce(cluster {{CLUSTER_VAR}})
        if !_rc eststo fesat_m1_prov
    }

    * M2 + zone × year (同区域 fintech 扩散冲击)
    capture confirm variable _zone_id
    if !_rc {
        capture noisily reghdfe {{MAIN_DV}} {{MAIN_TREAT}} $controls, ///
            absorb(bank_id year _zone_id#year) vce(cluster {{CLUSTER_VAR}})
        if !_rc eststo fesat_m2_zone
    }

    * M3 + bank-specific linear trend (c.year#i.bank_id) — 需 T≥3, 否则与 bank+year
    *     FE 共线 (早期试跑 T=2 时银行趋势不可识别), N/T 守卫优雅跳过。
    if `n_years' >= 3 {
        capture noisily reghdfe {{MAIN_DV}} {{MAIN_TREAT}} $controls, ///
            absorb(bank_id year c.year#i.bank_id) vce(cluster {{CLUSTER_VAR}})
        if !_rc eststo fesat_m3_trend
    }
    else {
        display as text "  [SKIP] Panel A M3 bank 线性趋势: T=`n_years' < 3 (与 bank+year FE 共线, 不可识别); production T=19 激活"
    }
}

* ============================================================================
* Panel B — ROBUST-EST 离群稳健估计
* 白话: qreg(.5) 是"中位数回归", rreg 是 Huber/Tukey 加权的稳健回归; 两者都
*       不被极端的高杠杆银行年观测牵着走, 比单纯缩尾更彻底。qreg/rreg 不能吸收
*       高维 FE, 故改用 i.year (+ T 足够时 i.bank_type 哑变量) 代替, T 小择简。
* ============================================================================
if `have_dv' & `have_treat' {

    * 是否有足够样本跑分位/稳健回归 (非缺失 DV+TREAT 观测数)
    quietly count if !missing({{MAIN_DV}}, {{MAIN_TREAT}})
    local n_est = r(N)

    if `n_est' >= 30 {
        * OLS 对照基准 (同 RHS, i.year 时间哑变量; T 足够再加 i.bank_type)
        local _grp ""
        capture confirm string variable bank_type
        if !_rc & `n_years' >= 3 local _grp "i.bank_type"
        else {
            capture confirm numeric variable bank_type
            if !_rc & `n_years' >= 3 local _grp "i.bank_type"
        }
        * bank_type 为字符串时 i.bank_type 不可直接用 → 临时数值化
        local _grp_term ""
        if "`_grp'" != "" {
            capture confirm numeric variable bank_type
            if _rc {
                capture encode bank_type, gen(_btype_id)
                if !_rc local _grp_term "i._btype_id"
            }
            else local _grp_term "i.bank_type"
        }

        capture noisily regress {{MAIN_DV}} {{MAIN_TREAT}} $controls i.year `_grp_term', ///
            vce(cluster {{CLUSTER_VAR}})
        if !_rc eststo robust_ols

        * qreg(.5) 中位数回归 (Koenker-Bassett 1978)
        *   ⚠ ATT-ROB-02: 裸 qreg 出 iid sparsity SE, 与 robust_ols 的 bank-cluster SE
        *   不可比 → 改 bootstrap 出聚类标准误 (bootstrap, cluster(`CLUSTER_VAR') 重抽
        *   银行整簇), 与 OLS 列对齐到 bank-level 聚类基准, 星号方可横比。bsqreg 仅出
        *   普通 bootstrap SE 不带聚类, 故用 bootstrap 前缀显式 cluster()。
        capture noisily bootstrap, reps(200) cluster({{CLUSTER_VAR}}) seed({{RANDOM_SEED}}) nodots: ///
            qreg {{MAIN_DV}} {{MAIN_TREAT}} $controls i.year `_grp_term', quantile(0.5)
        if !_rc eststo robust_qreg
        else display as text "  [SKIP] Panel B qreg(.5): 估计未收敛或样本退化 (T=`n_years')"

        * rreg Huber/Tukey biweight 稳健回归 (Stata 内置, 有界影响 IRLS M-估计;
        *   非 Yohai 1987 MM-估计 → 表述勿标 'MM')
        *   rreg 不接受 i.year factor 与 vce(cluster); 改用展开的 year 哑变量集。
        *   ⚠ ATT-ROB-03/04: 去掉旧的 `capture confirm variable _yrdum_set` 死守卫
        *   (从不 gen, 无作用) + xi 去 `noomit` (省一个基准档) — noomit 全档哑变量 +
        *   rreg 默认带常数项 = dummy variable trap 完全共线。先 capture drop 防重跑残留。
        capture drop _yr*
        capture noisily xi i.year, prefix(_yr)
        capture noisily rreg {{MAIN_DV}} {{MAIN_TREAT}} $controls _yr*
        if !_rc eststo robust_rreg
        else display as text "  [SKIP] Panel B rreg: 估计未收敛或样本退化 (T=`n_years')"
    }
    else {
        display as text "  [SKIP] Panel B (qreg/rreg): 非缺失观测 N=`n_est' < 30 (分位/稳健回归样本不足); production 全样本激活"
    }
}

* ============================================================================
* Panel C — OSTER (2019) δ 不可观测选择性边界 (psacalc, SSC)
* 白话: 把"已观测 substantive 控制变量解释了多少"外推到"看不见的变量"。psacalc
*       给出一个 δ: 要把主系数推到 0, 不可观测因素得比已观测控制强多少倍。Oster
*       原文阈值 δ≥1; 本表自设更严的 δ≥0.5 作目标。rmax 取 1.3×受控 R²。
*   识别口径: mcontrol 只放展开的 year-FE 哑变量 (_yfe, 非 factor i.year), δ 由 $controls 相对 year-FE 基线的
*       R²-movement 界定 (substantive 控制驱动识别, 不是把 $controls 错当 nuisance)。
* 守卫: 需 psacalc 已装 (capture which) + ≥1 控制 + DV/TREAT 在盘, 否则跳过。
* ============================================================================
capture which psacalc
local have_psacalc = (_rc == 0)
local n_ctrl : word count $controls

if `have_dv' & `have_treat' & `have_psacalc' & `n_ctrl' >= 1 {
    * year-FE 须以**显式哑变量**进受控回归并传 mcontrol: psacalc 的 mcontrol() 按
    *   变量名匹配 e(b) 里的项, **不接受 factor 记号 i.year** (会报 "Unrelated control
    *   not in regression" rc=5001 → Panel C 永远跳过, Oster δ 永不计算)。故先 tab year
    *   展开哑变量, 去基准档 _yc_1 防共线, 把 _yc_2.. 既放进受控 regress 也作 mcontrol
    *   的 year-FE nuisance 集 (对齐 substance/24:203-236 已 Stata 验证范式)。
    capture drop _yc_*
    quietly tab year, gen(_yc_)
    local _yfe ""
    local _yc_first 1
    foreach yc of varlist _yc_* {
        if `_yc_first' {
            local _yc_first 0
        }
        else {
            local _yfe `_yfe' `yc'
        }
    }
    * 先跑受控 OLS (psacalc 读取 e() 里的受控估计与 R²)
    capture noisily regress {{MAIN_DV}} {{MAIN_TREAT}} $controls `_yfe', ///
        vce(cluster {{CLUSTER_VAR}})
    if !_rc {
        * rmax = min(1, 1.3 × 受控 R²); psacalc delta 给出 selection ratio。
        * 注: e(r2) 是 e()-class 标量, 用扩展宏函数直接取, 不可 summarize (会 r(111))。
        local _r2 = e(r2)
        if missing(`_r2') local _r2 = 0
        local _rmax = min(1, 1.3 * `_r2')
        * ⚠ ATT-ROB-01: psacalc 的 mcontrol = "始终包含、不参与识别 δ 的 nuisance"。
        *   要让 δ 由可观测 substantive 控制 ($controls) 相对 year-FE 基线的 R²-movement
        *   驱动, mcontrol 只放展开的 year-FE 哑变量 (`_yfe'), 绝不放 $controls 本身。旧
        *   mcontrol($controls) 把 substantive 控制错当 nuisance, δ 退化为只由 year-FE
        *   移动界定 (识别口径错位)。`_yfe' 空 (单年退化) 时退化为无 mcontrol, δ 由全
        *   $controls 驱动 (口径仍正确)。
        if "`_yfe'" != "" {
            capture noisily psacalc delta {{MAIN_TREAT}}, rmax(`_rmax') mcontrol(`_yfe')
        }
        else {
            capture noisily psacalc delta {{MAIN_TREAT}}, rmax(`_rmax')
        }
        if !_rc {
            * ⚠ ATT-ROB-05: r(delta) 必须在 estimates restore **之前** 先 local 捕获 —
            *   restore 清空 r() (对齐 substance/24:193); 再用 estadd ... : robust_ols
            *   冒号语法写回 stored 估计, 否则 estadd 只进 active 内存, esttab 读 stored
            *   时 OLS 列 Oster δ 空白。
            local _oster_d = r(delta)
            display as result "  [OSTER] δ = `_oster_d'  (rmax=`_rmax', target δ≥0.5 系自设阈值, 非 Oster 原文 δ≥1)"
            capture estadd scalar oster_delta = `_oster_d' : robust_ols
        }
        else display as text "  [SKIP] Panel C psacalc delta: 估计退化 (可能 R²/共线问题, T=`n_years')"
    }
}
else {
    if `have_psacalc' == 0 display as text "  [SKIP] Panel C OSTER: psacalc 未装 (ssc install psacalc) — 正常跳过, 非失败"
    if `n_ctrl' < 1        display as text "  [SKIP] Panel C OSTER: 无在盘控制变量 (财务面板待接入), δ 无意义"
}

* ============================================================================
* 输出: esttab 动态名单 (缺名不点名, 避免 r(111) 丢整表) + CSV side-channel
* ============================================================================
qui estimates dir
local stored `r(names)'
local models ""
foreach m of local stored {
    if strmatch("`m'", "fesat_*") | strmatch("`m'", "robust_*") {
        local models `models' `m'
    }
}

if "`models'" == "" {
    display as text "  [WIRE-AHEAD] Table A8 无任何已存储估计 (financial DV 待接入 / 全 Panel 守卫跳过); 表跳过, 非失败"
}
else {
    esttab `models' using "$tables_dir/tableA8_fe_saturation_estrobust.tex", replace ///
        star(* 0.10 ** 0.05 *** 0.01) se booktabs label compress b(3) ///
        stats(N r2 oster_delta, fmt(0 3 3) ///
              labels("N" "R\textsuperscript{2}" "Oster $\delta$")) ///
        title("Table A8 — FE Saturation, Robust Estimators \& Oster $\delta$ (P2 attention)") ///
        addnotes("Panel A (fesat_*): saturated FE ladder — M0 bank+year; +province$\times$year; +zone$\times$year; +bank linear trend (T$\geq$3)." ///
                 "bank\_type$\times$year deliberately excluded (would make LOO peer-attention IV an endogenous mirror)." ///
                 "Panel B (robust_*): median (qreg .5) and Huber/Tukey biweight (rreg) bounded-influence IRLS M-estimator vs OLS; outlier robustness beyond winsorization." ///
                 "SE basis differs across columns: OLS and qreg report bank-clustered SE (qreg via cluster bootstrap, 200 reps); rreg reports IRLS analytic SE (no clustering). Stars are NOT comparable across the three columns." ///
                 "Panel C: standard Oster (2019) delta in the controlled-OLS column — psacalc with mcontrol = explicit (materialized) year-FE dummies only (psacalc rejects the i.year factor form, rc=5001), so delta is driven by movement of the observable substantive controls relative to the year-FE baseline (rmax = min(1, 1.3 x controlled R2)). Target threshold delta>=0.5 is self-imposed (stricter-than-half-of-Oster's-original delta>=1).")

    * CSV side-channel — parse_esttab_csv 消费 (tables.py read_paper_esttab)
    estout `models' using "$tables_dir/tableA8_fe_saturation_estrobust.csv", replace ///
        delimiter(",") cells(b(star fmt(3)) se(par fmt(3))) ///
        stats(N r2 oster_delta, fmt(0 3 3)) ///
        starlevels(* 0.10 ** 0.05 *** 0.01)

    display "[OK] Table A8 (FE-SAT / ROBUST-EST / OSTER) → $tables_dir/tableA8_fe_saturation_estrobust.tex (+ .csv side-channel)"
}
