* ============================================================================
* 15_attention_main_regression.do — Table 2 M1→M6 progressive (bank_fintech_attention / P2)
* Paper: {{PAPER_ID}}
* Plan: B_route_master_plan_v2 §5.5.2 + §B.2 P2 spec
*
*   DV   = {{MAIN_DV}}    (default ln_fintech_investment per spec.outcome.primary)
*   X    = {{MAIN_TREAT}} (default attention_index_full per spec.treatment.primary)
*   理论锚点 (Theory anchor): Hassan-Hollander-van Lent-Tahoun 2019 QJE 134(4) —
*                  firm-level 政治风险暴露测度 (political risk exposure, intensity DiD)。
*
* M1: 裸回归 (仅 treatment, 无控制无 FE)
* M2: + bank FE (银行固定效应)
* M3: + bank FE + year FE (银行+年份双固定效应)
* M4: + 标准银行层面控制变量
* M5: + 宏观控制 (gdp_growth / m2_growth 存在时; 否则退化复用 M4 规格)
* M6: + attention × post-DCEP-pilot 试点哑变量 INLINE 强度 DiD (intensity-DiD,
*     兑现 spec.event_studies 的事件设定; 仅 T≥3 才可识别, 早期试跑 T=2 帧零方差跳过)
*
* 识别策略: 双向固定效应 (TWFE) 面板回归 (bank FE + year FE)
*                via reghdfe; M1-M6 全为 reghdfe TWFE, 本模板无 csdid 调用.
*                注: spec.identification 概念上锚定 staggered DiD, 但 Callaway-Sant'Anna
*                (2021) staggered DiD estimator 需 T≥3 (多期 pre/post 以识别 group-time
*                ATT); 当前面板早期试跑 T=2 (2017-2018 bank-year), staggered DiD 不可识别, 故
*                baseline 退化为 TWFE — 见 pipeline/panel/iv_did.py docstring 的早期试跑 T=2
*                识别披露. 待 production run 扩到 T≥3 后方可启用 csdid.
*                IV 用 leave-one-out 同业 attention (Bartik 后备由共享模板
*                22_tableA3_bartik_iv 处理)。
* 白话: 想用的分期 DiD 方法至少需要三年数据, 当前试跑面板只有两年, 只能退回普通
* 双向固定效应回归; 等数据扩到多年后再换正式的分期 DiD。
* ============================================================================

version 19
clear all
set more off
set maxvar 32767
set linesize 120

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"

use "$data_dir/_prepared_panel.dta", clear

set seed {{RANDOM_SEED}}

* M1: 裸回归
reghdfe {{MAIN_DV}} {{MAIN_TREAT}}, noabsorb vce(cluster {{CLUSTER_VAR}})
eststo M1

* M2: + bank FE (银行固定效应)
reghdfe {{MAIN_DV}} {{MAIN_TREAT}}, ///
    absorb(bank_id) vce(cluster {{CLUSTER_VAR}})
eststo M2

* M3: + bank FE + year FE (银行内、年份内变异的基准设定)
reghdfe {{MAIN_DV}} {{MAIN_TREAT}}, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo M3

* M4: + 银行层面控制变量
reghdfe {{MAIN_DV}} {{MAIN_TREAT}} $controls, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo M4

* M5: + 宏观控制
capture confirm variable gdp_growth m2_growth
if !_rc {
    reghdfe {{MAIN_DV}} {{MAIN_TREAT}} $controls gdp_growth m2_growth, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    eststo M5
}
else {
    display "  [INFO] gdp_growth / m2_growth 不存在; M5 复用 M4 规格"
    eststo M5: reghdfe {{MAIN_DV}} {{MAIN_TREAT}} $controls, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
}

* M6: + attention × post-policy 交互 = INLINE intensity-DiD (DID-2 修复, 2026-06-14)
* 白话: 把"媒体注意力强度"与"数字人民币 (DCEP) 试点落地后"哑变量相乘, 看政策冲击后
*   高曝光银行的 fintech 投入响应是否更强 (截面强度 DiD, 镜像 collab/19_collab_event_study)。
* DID-2 修复: 旧 M6 喂 post_E1 (post_E*/treat_E* 全 pipeline 零生产者 → 永久空壳)。
*   改接已物化的 dcep_post (同步政策冲击, 而非 staggered cohort) × attention 强度,
*   兑现 spec.event_studies 的 intensity-DiD 设定, 无需新列 → golden-safe。
* ⚠ 早期试跑 T=2 帧 dcep_post 恒 0 (处理年 2019 晚于面板末年) → 零方差守卫静默跳过,
*   T=19 自动激活; sandbox_post 作 fallback (其处理年若更早可有变异)。
local m6_done = 0
foreach _post in dcep_post sandbox_post {
    if `m6_done' continue
    capture confirm variable `_post'
    if !_rc {
        quietly summarize `_post'
        if (r(sd) > 0) & (r(sd) < .) {
            capture drop treat_x_post
            gen double treat_x_post = {{MAIN_TREAT}} * `_post'
            capture noisily reghdfe {{MAIN_DV}} {{MAIN_TREAT}} `_post' treat_x_post $controls, ///
                absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
            if !_rc {
                eststo M6
                local m6_done = 1
                display "  [OK M6] INLINE intensity-DiD: {{MAIN_TREAT}} x `_post' (post-policy interaction)"
            }
        }
    }
}
if `m6_done' == 0 {
    display "  [INFO] dcep_post/sandbox_post 零方差或不在盘 (处理年晚于早期试跑 T=2 面板末年); M6 跳过, T=19 自动激活"
}

* fix(omni-g-templates-07, 2026-06-11): esttab 名单动态化 — M6 依赖 post_E1 (无管道
* 生产者), 守卫跳过后旧版硬点名 M6 → r(111) 丢整表且 master 链中止; 改为仅引用实际
* 已存储估计, mtitle 同步删列防错位。
* 白话: 出表时只点名实际估计成功的模型, 防止某一列缺席导致整张表报错丢失。
qui estimates dir
local stored `r(names)'
local cand_models M1 M2 M3 M4 M5 M6
local cand_titles `""M1 bare" "M2 +bankFE" "M3 +yearFE" "M4 +ctrl" "M5 +macro" "M6 DCEP-DiD""'
local models ""
local mtitles `""'
local nmod : word count `cand_models'
forvalues i = 1/`nmod' {
    local m : word `i' of `cand_models'
    if `: list m in stored' {
        local models `models' `m'
        local t : word `i' of `cand_titles'
        local mtitles `"`mtitles' "`t'""'
    }
}
esttab `models' using "$tables_dir/table2_main.tex", replace ///
    star(* 0.10 ** 0.05 *** 0.01) se booktabs label compress b(3) ///
    title("Main Results --- bank_fintech_attention (P2)") ///
    mtitles(`mtitles') ///
    addnotes("Two-way fixed-effects (TWFE) panel regression; bank and year FE; SE clustered at {{CLUSTER_VAR}}." ///
             "M6 = INLINE intensity-DiD (attention x post-DCEP-pilot); identified only when the policy treatment year falls inside the panel window (T>=3). Callaway-Sant'Anna (2021) staggered DiD requires T>=3 and is not identified on the retired T=2 trial panel (2017-2018)." ///
             "Main treatment attention_index_full is firm-level verified-universe gated (ATT-1 semi-join). DISCLOSURE (SU-2 / ATT-2): the geographic attention family (ft_attn_yr/prov/city, ft_vol_yr/prov/city) is NOT verified-universe gated and feeds only descriptive Table 1 rows, never any regression/IV coefficient; its level drift is absorbed by year FE. Gating asymmetry to be removed (numerator-only) before any geo-IV activation." ///
             "IV first stage in 19_attention_iv_first_stage.do (incl. LOO x Bartik pooled over-id, Hansen J); Bartik fallback in 22_tableA3_bartik_iv.")

* fix(omni-g-esttab-csv, 2026-06-11): CSV side-channel — papers/bank_fintech_attention/
* tables.py:build_table2_main 经 read_paper_esttab('bank_fintech_attention',
* 'table2_main.csv') 消费; estout+delimiter(",") 防 esttab csv 的 ="..." Excel 包裹
* (或 plain 丢 SE 括号) 破坏 stata_postprocess.parse_esttab_csv 解析。
estout `models' using "$tables_dir/table2_main.csv", replace delimiter(",") ///
    cells(b(star fmt(3)) se(par fmt(3))) stats(N r2, fmt(0 3)) ///
    starlevels(* 0.10 ** 0.05 *** 0.01) mlabels(`mtitles')

display "[OK] Table 2 (M1-M6) → $tables_dir/table2_main.tex (+ .csv side-channel)"
