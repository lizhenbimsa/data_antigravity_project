* ============================================================================
* 19_attention_iv_first_stage.do — P2 paper-specific IV first stage
* Paper: {{PAPER_ID}}
* Plan: §5.5.2 P2 extras + §B.2 identification.iv
*
* IV (per spec.identification.iv):
*   primary  = leave_one_out_peer_attention_iv  (firm-level: 4 银行类型分类同业 mean)
*   fallback = bartik_attention_iv              (Bartik shift-share, R1-M22 修订)
* 白话: 担心"媒体注意力"本身内生 (好坏银行被报道得不一样多), 借同类型同业银行的
* 平均注意力 (剔除自己) 当工具变量; 第一阶段先确认工具与内生变量足够相关, 弱工具
* 会让 2SLS 比 OLS 更不可信。
*
* First stage: {{MAIN_TREAT}} ~ IV + controls
* Reduced form / 2SLS 经 ivreg2 实现。
* ============================================================================

version 19
clear all
set more off
set maxvar 32767
set linesize 120

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"

use "$data_dir/_prepared_panel.dta", clear

set seed {{RANDOM_SEED}}

* ID-1 修复 (审计 2026-06-14): 弱工具稳健 AR 置信集 — 模板注释一贯写 "KP F<16.38 时看
* Anderson-Rubin CI", 但此前从不计算 → 复现包无任何弱工具稳健对象。weakiv (Finlay-
* Magnusson-Schaffer; Andrews-Stock-Sun 2019 ARE 11:727-753) 作后估对最近一次 ivreg2
* 计算 AR/CLR/LM 弱工具稳健检验与置信集 (just-identified 列 AR=CLR=LM)。缺 ado 优雅跳过。
capture which weakiv
local has_weakiv = (_rc == 0)
if !`has_weakiv' display "  [INFO] weakiv 未安装 — 弱工具稳健 AR CI 跳过 (复现前: ssc install weakiv)"

* ⚠ FE 锁定 = bank FE + year FE (absorb(bank_id year) / i.bank_id i.year);
*   严禁 bank_type×year 交互 FE — 同业 LOO 工具格内残余 = 自身内生变量的负镜像
*   (实测格内 corr −0.67~−0.84), type×year FE 下工具退化为内生变量镜像、一阶段
*   虚假强、排他性按构造违反 (终审裁决 2026-06-13)。

* ============================================================================
* IV 1: leave_one_out_peer_attention_iv (primary)
* ============================================================================
capture confirm variable leave_one_out_peer_attention_iv
if !_rc {
    * 第一阶段: treat ~ IV + controls + FE
    reghdfe {{MAIN_TREAT}} leave_one_out_peer_attention_iv $controls, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    eststo first_loo

    * 简化式: outcome 直接对 IV 回归
    reghdfe {{MAIN_DV}} leave_one_out_peer_attention_iv $controls, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    eststo reduced_loo

    * 2SLS: outcome ~ 工具化的 treat + controls
    ivreg2 {{MAIN_DV}} ({{MAIN_TREAT}} = leave_one_out_peer_attention_iv) $controls ///
        i.bank_id i.year, cluster({{CLUSTER_VAR}}) first
    eststo tsls_loo
    * ID-1: LOO 2SLS 弱工具稳健 AR 置信集 (KP F<16.38 时主推断对象)
    if `has_weakiv' {
        display "  [weakiv] LOO 2SLS — Anderson-Rubin 弱工具稳健检验/置信集:"
        capture noisily weakiv
    }
}
else {
    display "  [WARN] leave_one_out_peer_attention_iv not in panel (M0.5.X derivation pending)"
}

* ============================================================================
* IV 2: bartik_attention_iv (fallback, R1-M22)
* ============================================================================
capture confirm variable bartik_attention_iv
if !_rc {
    reghdfe {{MAIN_TREAT}} bartik_attention_iv $controls, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    eststo first_bartik

    ivreg2 {{MAIN_DV}} ({{MAIN_TREAT}} = bartik_attention_iv) $controls ///
        i.bank_id i.year, cluster({{CLUSTER_VAR}}) first
    eststo tsls_bartik
    * ID-1: Bartik 2SLS 弱工具稳健 AR 置信集
    if `has_weakiv' {
        display "  [weakiv] Bartik 2SLS — Anderson-Rubin 弱工具稳健检验/置信集:"
        capture noisily weakiv
    }
    * ID-4 披露 (审计 2026-06-14, 核验修订): Bartik 识别 = GPSS 2020 基期份额外生性 (非 BHJ
    * 冲击层外生)。基期份额 = 焦点行同类型共现频率, 可能相关于 T0 媒体显著性 → 须以 Rotemberg
    * 权重诊断 + 高权重份额 placebo + share-vs-pretrend 核验。⚠ Rotemberg 诊断 deferred 的
    * 真实原因: bartik_type_share_* 6 列份额矩阵虽已在面板, 但 per-group 的 shift×share
    * **分量工具** (iv_extensions shift_g) 已坍缩进单列 bartik_attention_iv = Σ_g share_g·shift_g
    * — 面板只留份额矩阵不留分量工具列 → Rotemberg 分解须先暴露 per-group 分量; 论文须披露假设。
    display "  [ID-4] Bartik 识别依赖 GPSS 基期份额外生性; Rotemberg 诊断待暴露 per-group shift×share 分量 (份额矩阵已在盘, 缺分量工具列)"
}

* ============================================================================
* IV 3: ctx 轨镜像 (2026-06-13 终审) — 内生孪生 attention_index_ctx 配 ctx 同业
* LOO 工具 lpeer_attention_iv_ctx, 与 full 轨【各自 just-identified、并排成列】
* 表达双轨互为稳健性; 勿与 full 轨 LOO 合成 overid — 同文两窗 (full=标题+全文/
* ctx=标题+实体窗口) 共同冲击逐字同污染, Hansen J 零功效 (Parente & Santos
* Silva 2012 EL)。
* ============================================================================
capture confirm variable attention_index_ctx lpeer_attention_iv_ctx
if !_rc {
    reghdfe attention_index_ctx lpeer_attention_iv_ctx $controls, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    eststo first_ctx

    ivreg2 {{MAIN_DV}} (attention_index_ctx = lpeer_attention_iv_ctx) $controls ///
        i.bank_id i.year, cluster({{CLUSTER_VAR}}) first
    eststo tsls_ctx
    * ID-1: ctx 轨 2SLS 弱工具稳健 AR 置信集 (just-identified, 与 full 轨并排)
    if `has_weakiv' {
        display "  [weakiv] ctx 2SLS — Anderson-Rubin 弱工具稳健检验/置信集:"
        capture noisily weakiv
    }
}

* fix(omni-g-templates-07, 2026-06-11): esttab 名单动态化 — 全部 5 个估计都在守卫
* 块内 (leave_one_out_peer_attention_iv / bartik_attention_iv 均为派生 pending 列),
* 任一缺失旧版硬点名 → r(111) 丢整表; 全缺时如实告警跳过。
qui estimates dir
local stored `r(names)'
local cand_models first_loo reduced_loo tsls_loo first_bartik tsls_bartik first_ctx tsls_ctx
local cand_titles `""1st LOO" "Reduced LOO" "2SLS LOO" "1st Bartik" "2SLS Bartik" "1st LOO ctx" "2SLS LOO ctx""'
local models ""
local mtitles `""'
local nmod : word count `cand_models'
forvalues i = 1/`nmod' {
    local m : word `i' of `cand_models'
    if `: list m in stored' {
        local models `models' `m'
        local t : word `i' of `cand_titles'
        local mtitles `"`mtitles' "`t'""'
    }
}
if "`models'" == "" {
    display as error "  [WARN] IV first-stage 表无任何已存储估计 (两 IV 列全缺), 表跳过"
}
else {
    esttab `models' ///
        using "$tables_dir/tableA_iv_first_stage.tex", replace ///
        star(* 0.10 ** 0.05 *** 0.01) se booktabs label compress b(3) ///
        title("P2 IV First Stage + 2SLS") ///
        mtitles(`mtitles') ///
        addnotes("Kleibergen-Paap rk-F-stat reported by ivreg2; weak-IV threshold = 16.38 (Stock-Yogo 2005). When KP F<16.38, Anderson-Rubin weak-IV-robust confidence sets are computed via weakiv (Andrews-Stock-Sun 2019 ARE) and logged per 2SLS column (ssc install weakiv to enable)." ///
                 "Bartik identification rests on GPSS (2020) base-period share exogeneity (NOT BHJ shock-level); the Rotemberg-weight diagnostic is deferred because the per-group shift x share component instruments are collapsed into the single pre-synthesized bartik_attention_iv (the share matrix survives to the panel, the component instruments do not) — disclose the base-share assumption." ///
                 "ctx column: entity-window twin attention_index_ctx instrumented by lpeer_attention_iv_ctx, just-identified, side-by-side dual-track robustness — NOT pooled with full-track IV (same-text windows make Hansen J uninformative; Parente-Santos Silva 2012).")

    display "[OK] 19_attention_iv_first_stage → $tables_dir/tableA_iv_first_stage.tex"
}
