* ============================================================================
* 19_attention_iv_first_stage.do — P2 paper-specific IV first stage
* Paper: {{PAPER_ID}}
* Plan: §5.5.2 P2 extras + §B.2 identification.iv
*
* IV (per spec.identification.iv):
*   primary  = leave_one_out_peer_attention_iv  (firm-level: 4 银行类型分类同业 mean)
*   fallback = bartik_attention_iv              (Bartik shift-share, R1-M22 修订)
* 白话: 担心"媒体注意力"本身内生 (好坏银行被报道得不一样多), 借同类型同业银行的
* 平均注意力 (剔除自己) 当工具变量; 第一阶段先确认工具与内生变量足够相关, 弱工具
* 会让 2SLS 比 OLS 更不可信。
*
* First stage: {{MAIN_TREAT}} ~ IV + controls
* Reduced form / 2SLS 经 ivreg2 实现。
* ============================================================================

version 19
clear all
set more off
set maxvar 32767
set linesize 120

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"

use "$data_dir/_prepared_panel.dta", clear

set seed {{RANDOM_SEED}}

* ⚠ FE 锁定 = bank FE + year FE (absorb(bank_id year) / i.bank_id i.year);
*   严禁 bank_type×year 交互 FE — 同业 LOO 工具格内残余 = 自身内生变量的负镜像
*   (实测格内 corr −0.67~−0.84), type×year FE 下工具退化为内生变量镜像、一阶段
*   虚假强、排他性按构造违反 (终审裁决 2026-06-13)。

* ============================================================================
* IV 1: leave_one_out_peer_attention_iv (primary)
* ============================================================================
capture confirm variable leave_one_out_peer_attention_iv
if !_rc {
    * 第一阶段: treat ~ IV + controls + FE
    reghdfe {{MAIN_TREAT}} leave_one_out_peer_attention_iv $controls, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    eststo first_loo

    * 简化式: outcome 直接对 IV 回归
    reghdfe {{MAIN_DV}} leave_one_out_peer_attention_iv $controls, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    eststo reduced_loo

    * 2SLS: outcome ~ 工具化的 treat + controls
    * 注: just-identified 列 (tsls_loo / tsls_bartik / tsls_ctx) 刻意把 i.bank_id i.year
    *   FE 哑变量留在回归内 (不 partial), 系数与 KP rk F 仍有效; 仅 over-id 列须 partial()
    *   才能让 ivreg2 报告 Hansen J (见 :92-98)。
    ivreg2 {{MAIN_DV}} ({{MAIN_TREAT}} = leave_one_out_peer_attention_iv) $controls ///
        i.bank_id i.year, cluster({{CLUSTER_VAR}}) first
    eststo tsls_loo
}
else {
    display "  [WARN] leave_one_out_peer_attention_iv not in panel (M0.5.X derivation pending)"
}

* ============================================================================
* IV 2: bartik_attention_iv (fallback, R1-M22)
* ============================================================================
capture confirm variable bartik_attention_iv
if !_rc {
    reghdfe {{MAIN_TREAT}} bartik_attention_iv $controls, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    eststo first_bartik

    ivreg2 {{MAIN_DV}} ({{MAIN_TREAT}} = bartik_attention_iv) $controls ///
        i.bank_id i.year, cluster({{CLUSTER_VAR}}) first
    eststo tsls_bartik
}

* ============================================================================
* IV 2b: pooled over-id (IV-5 修复, 2026-06-14) — 兑现 paper_spec.identification.iv
*   承诺的跨族 over-id: LOO peer-mean × Bartik shift-share 两套【机制不同】工具
*   (同业反射推力 vs 基期份额×行业 shift) 联合工具化同一内生变量 → Hansen J
*   (df=1) 检验过度识别约束。镜像 benefit/25_tableA12 的 tsls_overid 模式。
* 白话: 用"同类同业关注"和"Bartik 行业曝光推力"两把不同的钥匙一起开同一把锁,
*   若两把钥匙给出一致的结论 (Hansen J 不拒绝), 就增强了工具有效性的可信度。
* ⚠ 合法跨族 over-id 前提 = 两工具机制异质、近正交; 严禁与 ctx 轨 (同文双窗)
*   合成 Hansen J — 同文逐字同污染使 J 零功效 (Parente & Santos Silva 2012 EL)。
* ============================================================================
local rho_fb "n/a"
capture confirm variable leave_one_out_peer_attention_iv bartik_attention_iv
if !_rc {
    * 工具相关性诊断 (GPSS 2020 AER §5: over-id 须报告工具间相关性)
    qui correlate leave_one_out_peer_attention_iv bartik_attention_iv
    local rho_fb : display %5.3f r(rho)

    * pooled 2SLS: 同一内生 {{MAIN_TREAT}} 由 LOO + Bartik 两工具识别 → Hansen J
    * DV 缺列 (ln_fintech_investment 外部财务面板待接入) 时优雅跳过 (镜像 benefit/25)
    * ⚠ IV-5 复发修复 (2026-06-14 烟雾验证 PROJECT_REAUDIT_TOPTIER_T18): ivreg2 携
    *   未 partial 的 i.bank_id i.year 高维哑变量时, 会拒报过度识别统计量 (实测打印
    *   "overidentification statistic not reported"; e(j)=. / e(jp)=. → Hansen J 列恒空),
    *   = IV-5 兑现的 over-id 主交付物 claimed-but-not-run。改 partial(i.bank_id i.year)
    *   把外生 FE 哑变量先 partial out, ivreg2 即报告 e(j)/e(jp) (实测 T=19 合成面板
    *   e(jp)=.775, df=1)。本机 ivreghdfe r(301) 坏 (ftools/reghdfe Mata 不兼容) 故不改走
    *   ivreghdfe; partial() 是 ivreg2 原生、与 cluster() 兼容的等价路径。
    capture confirm variable {{MAIN_DV}}
    if !_rc {
        capture noisily ivreg2 {{MAIN_DV}} ({{MAIN_TREAT}} = leave_one_out_peer_attention_iv bartik_attention_iv) ///
            $controls i.bank_id i.year, cluster({{CLUSTER_VAR}}) partial(i.bank_id i.year) first
        * 回退: 个别 ivreg2/collinearity 退化下 partial() 报错时, 退回不 partial 版本
        *   (至少保留 KP F 列, Hansen J 仍可能空 — 与旧行为一致, 不更糟)。
        if _rc {
            capture noisily ivreg2 {{MAIN_DV}} ({{MAIN_TREAT}} = leave_one_out_peer_attention_iv bartik_attention_iv) ///
                $controls i.bank_id i.year, cluster({{CLUSTER_VAR}}) first
        }
        if !_rc eststo tsls_overid
    }
    else {
        display "  [WIRE-AHEAD] pooled over-id 第二阶段 DV {{MAIN_DV}} 未物化 (外部财务面板待接入); Hansen J 列跳过, T=19 自动激活"
    }
}
display "  [over-id 工具相关性] LOO x Bartik rho=`rho_fb' (近正交→ Hansen J df=1 有功效)"

* ============================================================================
* IV 3: ctx 轨镜像 (2026-06-13 终审) — 内生孪生 attention_index_ctx 配 ctx 同业
* LOO 工具 lpeer_attention_iv_ctx, 与 full 轨【各自 just-identified、并排成列】
* 表达双轨互为稳健性; 勿与 full 轨 LOO 合成 overid — 同文两窗 (full=标题+全文/
* ctx=标题+实体窗口) 共同冲击逐字同污染, Hansen J 零功效 (Parente & Santos
* Silva 2012 EL)。
* ============================================================================
capture confirm variable attention_index_ctx lpeer_attention_iv_ctx
if !_rc {
    reghdfe attention_index_ctx lpeer_attention_iv_ctx $controls, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    eststo first_ctx

    ivreg2 {{MAIN_DV}} (attention_index_ctx = lpeer_attention_iv_ctx) $controls ///
        i.bank_id i.year, cluster({{CLUSTER_VAR}}) first
    eststo tsls_ctx
}

* fix(omni-g-templates-07, 2026-06-11): esttab 名单动态化 — 全部 5 个估计都在守卫
* 块内 (leave_one_out_peer_attention_iv / bartik_attention_iv 均为派生 pending 列),
* 任一缺失旧版硬点名 → r(111) 丢整表; 全缺时如实告警跳过。
qui estimates dir
local stored `r(names)'
local cand_models first_loo reduced_loo tsls_loo first_bartik tsls_bartik tsls_overid first_ctx tsls_ctx
local cand_titles `""1st LOO" "Reduced LOO" "2SLS LOO" "1st Bartik" "2SLS Bartik" "2SLS Overid" "1st LOO ctx" "2SLS LOO ctx""'
local models ""
local mtitles `""'
local nmod : word count `cand_models'
forvalues i = 1/`nmod' {
    local m : word `i' of `cand_models'
    if `: list m in stored' {
        local models `models' `m'
        local t : word `i' of `cand_titles'
        local mtitles `"`mtitles' "`t'""'
    }
}
if "`models'" == "" {
    display as error "  [WARN] IV first-stage 表无任何已存储估计 (两 IV 列全缺), 表跳过"
}
else {
    esttab `models' ///
        using "$tables_dir/tableA_iv_first_stage.tex", replace ///
        star(* 0.10 ** 0.05 *** 0.01) se booktabs label compress b(3) ///
        stats(N r2 widstat jp, fmt(0 3 3 3) labels("N" "R2" "KP rk F" "Hansen J p")) ///
        title("P2 IV First Stage + 2SLS") ///
        mtitles(`mtitles') ///
        addnotes("KP rk F = Kleibergen-Paap rk Wald F (ivreg2 widstat); weak-IV threshold (Stock-Yogo 2005, 10% maximal IV size, 1 endogenous regressor) = 16.38 for the just-identified columns (LOO, Bartik, ctx; 1 instrument each); = 19.93 for the over-identified column (2SLS Overid, 2 instruments). Compare each column's KP rk F against its own threshold; if KP F is below it, read the Anderson-Rubin weak-IV-robust CI (Andrews-Stock-Sun 2019)." ///
                 "2SLS Overid (IV-5): full-track endogenous attention_index_full jointly instrumented by same-type leave-one-out peer mean AND Bartik shift-share — two mechanistically distinct (near-orthogonal) instruments → cross-family Hansen J (df=1) overidentification test, fulfilling spec.identification.iv. LOO x Bartik instrument correlation rho=`rho_fb' (GPSS 2020 AER sec.5)." ///
                 "ctx column: entity-window twin attention_index_ctx instrumented by lpeer_attention_iv_ctx, just-identified, side-by-side dual-track robustness — NOT pooled with full-track IV (same-text windows make Hansen J uninformative; Parente-Santos Silva 2012). Hansen J reported only in the overidentified column.")

    display "[OK] 19_attention_iv_first_stage → $tables_dir/tableA_iv_first_stage.tex"
}
