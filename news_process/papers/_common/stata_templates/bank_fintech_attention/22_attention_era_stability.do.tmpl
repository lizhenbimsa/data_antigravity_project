* ============================================================================
* 22_attention_era_stability.do — Era-stability robustness (bank_fintech_attention / P2)
* Paper: {{PAPER_ID}}
* Audit: PROJECT_REAUDIT_TOPTIER_T18 2026-06-14 CY-2 (P1, $0/golden-safe)
*
* 跨年结构断裂 / 分时代稳定性 (cross-year structural-break / era stability)。
* 2007-2025 横跨多个 fintech regime: 2013 余额宝 / 2016 P2P 整顿 / 2019 DCEP。
* pooled intensity-DiD 若处理效应随 regime 断裂, 会把异质效应平均成有偏均值。
*
* 三时代分段 (per audit: 2007-2012 / 2013-2018 / 2019-2025):
*   (A) 各时代各跑一次主规格 (attention → outcome, bank+year FE) → 系数对照
*   (B) 全样本加 treatment × era 交乘 → Wald 检验三时代系数相等 (H0: 跨时代不变)
*
* ── 大白话 ────────────────────────────────────────────────────────────────
*   是什么: 把 19 年样本切成早 (2007-12) / 中 (2013-18) / 晚 (2019-25) 三段,
*           每段单独看注意力效应, 再用一张全样本表的交乘项 + Wald 检验
*           "三段效应是不是一样大"。
*   为什么: 顶刊审稿人对长面板媒体测度的硬要求 — 年份固定效应只吸收水平漂移,
*           不保证测度跨年含义一致; 分时代稳定性表是 referee 期待的标配。
*   影响:   纯 Stata 层, 只读在盘列 + 全程 capture 守卫; 早期试跑 T=2 帧只有 2017-2018
*           (落在中时代) → 仅一个时代有数据时优雅跳过其余 + Wald 不可算时跳过,
*           不报错不弹框; golden-safe, T=19 自动激活全部三段 + 交乘 + Wald。
*
* ── 文献锚点 ───────────────────────────────────────────────────────────────
*   Bai, J. & Perron, P. (1998). Estimating and testing linear models with
*     multiple structural changes. Econometrica, 66(1), 47-78. doi:10.2307/2998540
*   Hansen, B.E. (2001). The new econometrics of structural change. JEP, 15(4), 117-128.
* ============================================================================

version 19
clear all
set more off
set maxvar 32767
set linesize 120
eststo clear

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"

use "$data_dir/_prepared_panel.dta", clear

set seed {{RANDOM_SEED}}

* ----------------------------------------------------------------------------
* 公共守卫: treatment / outcome / year 在不在盘
* ----------------------------------------------------------------------------
local ok = 1
foreach v in {{MAIN_TREAT}} year {
    capture confirm variable `v'
    if _rc {
        display as error "  [WARN] `v' 不在盘; era-stability 表跳过"
        local ok = 0
    }
}
capture confirm variable {{MAIN_DV}}
if _rc {
    display as text "  [WIRE-AHEAD] {{MAIN_DV}} 不在盘 (外部财务面板待接入); era-stability 回归优雅跳过, T=19 接入后自动激活"
    local ok = 0
}

if `ok' == 0 {
    display "[SKIP] 22_attention_era_stability — 前置列缺失, 不写表 (非失败)"
}
else {
    * ------------------------------------------------------------------------
    * era 分段标签 (1=2007-2012 早 / 2=2013-2018 中 / 3=2019-2025 晚)
    * ------------------------------------------------------------------------
    capture drop era
    gen byte era = .
    replace era = 1 if year >= 2007 & year <= 2012
    replace era = 2 if year >= 2013 & year <= 2018
    replace era = 3 if year >= 2019 & year <= 2025

    * 各 era 的最低观测门控 (与 17/21 small-cell 守卫对齐)
    local min_n = 10

    * (A) 三时代分段主规格 ----------------------------------------------------
    local eras_with_data ""
    forvalues e = 1/3 {
        quietly count if era == `e' & !missing({{MAIN_TREAT}}, {{MAIN_DV}})
        if r(N) >= `min_n' {
            capture noisily reghdfe {{MAIN_DV}} {{MAIN_TREAT}} $controls if era == `e', ///
                absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
            if !_rc {
                eststo era`e'
                local eras_with_data `eras_with_data' `e'
            }
        }
        else {
            display as text "  [SKIP] era==`e': N=" r(N) " < `min_n' (试跑帧仅 2017-2018 落在中时代; production 全样本激活三段)"
        }
    }

    * (B) 全样本 era 交乘 + Wald 三时代系数相等检验 ---------------------------
    * 仅当 ≥2 个时代有数据时交乘/Wald 才有意义 (单一时代退化, 优雅跳过)
    local n_eras : word count `eras_with_data'
    local wald_F "n/a"
    local wald_p "n/a"
    if `n_eras' >= 2 {
        * c.treat#ibn.era = 各时代独立斜率 (ibn = no-base-omit, 三个时代斜率全部可估;
        *   i.era 主效应吸收时代水平差; bank+year FE 照常)。
        * ⚠ 旧版用 c.treat#i.era (默认基准 era) → 基准时代交互项 (1b.era#co.treat) 被省略,
        *   = 基准时代斜率被强制为 0 (设定错误), 且第 111 行 Wald 引用被省略的 base 交互项 →
        *   capture test 报错 → wald_F/wald_p 恒 n/a。改 ibn.era 后 base 交互项真实存在 (CY-2 修复)。
        capture noisily reghdfe {{MAIN_DV}} c.{{MAIN_TREAT}}#ibn.era i.era $controls, ///
            absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
        if !_rc {
            eststo era_interact
            * Wald: 有数据的时代间 treatment 斜率两两相等 (H0: 跨时代不变)
            * 用首个有数据时代作基准, 其余逐一与之比较
            local base : word 1 of `eras_with_data'
            local test_terms ""
            forvalues k = 2/`n_eras' {
                local e : word `k' of `eras_with_data'
                local test_terms `test_terms' (`e'.era#c.{{MAIN_TREAT}} = `base'.era#c.{{MAIN_TREAT}})
            }
            capture test `test_terms'
            if !_rc {
                local wald_F : display %6.3f r(F)
                local wald_p : display %5.3f r(p)
                display "  [era Wald] H0: 三时代 attention 斜率相等  F=`wald_F'  p=`wald_p'"
            }
            else {
                display as text "  [INFO] era Wald 不可算 (基准/对比项被 FE 共线吸收); 跳过"
            }
        }
    }
    else {
        display as text "  [SKIP era 交乘/Wald] 仅 `n_eras' 个时代有数据 (试跑帧退化); production 三段齐全后激活"
    }

    * ------------------------------------------------------------------------
    * 输出: esttab 动态名单 (缺名不点名, 防 r(111))
    * ------------------------------------------------------------------------
    qui estimates dir
    local stored `r(names)'
    local cand_models era1 era2 era3 era_interact
    local cand_titles `""2007-2012" "2013-2018" "2019-2025" "Era interact""'
    local models ""
    local mtitles `""'
    local nmod : word count `cand_models'
    forvalues i = 1/`nmod' {
        local m : word `i' of `cand_models'
        if `: list m in stored' {
            local models `models' `m'
            local t : word `i' of `cand_titles'
            local mtitles `"`mtitles' "`t'""'
        }
    }

    if "`models'" == "" {
        display as text "  [SKIP] era-stability 无任何已存储估计 (单一时代或全守卫跳过); 表跳过, 非失败"
    }
    else {
        esttab `models' using "$tables_dir/tableA_era_stability.tex", replace ///
            star(* 0.10 ** 0.05 *** 0.01) se booktabs label compress b(3) ///
            stats(N r2, fmt(0 3) labels("N" "R\textsuperscript{2}")) ///
            keep({{MAIN_TREAT}} *.era#c.{{MAIN_TREAT}}) ///
            title("Table A: Era Stability (P2 attention) --- 2007-12 / 2013-18 / 2019-25") ///
            mtitles(`mtitles') ///
            addnotes("Era split per audit CY-2: 2007-2012 (pre-yuebao) / 2013-2018 (yuebao-P2P) / 2019-2025 (post-DCEP)." ///
                     "Era-interact column: c.treat#ibn.era = era-specific slopes (ibn=no-base-omit, all three era slopes estimable); i.era main effect absorbs era level shifts; bank+year FE retained." ///
                     "Wald test of equal treatment slopes across eras (H0: cross-era stability): F=`wald_F', p=`wald_p'. Reject => regime-dependent effect (pooled estimate is a biased average; Bai-Perron 1998, Hansen 2001)." ///
                     "the retired T=2 trial frame (2017-2018) falls in era 2 only; off-era columns and the Wald test gracefully skip and auto-activate at T=19.")

        * CSV side-channel — parse_esttab_csv 消费 (tables.py read_paper_esttab)
        estout `models' using "$tables_dir/tableA_era_stability.csv", replace ///
            delimiter(",") cells(b(star fmt(3)) se(par fmt(3))) ///
            stats(N r2, fmt(0 3)) starlevels(* 0.10 ** 0.05 *** 0.01)

        display "[OK] Table A (era stability) → $tables_dir/tableA_era_stability.tex (+ .csv side-channel)"
    }
}
