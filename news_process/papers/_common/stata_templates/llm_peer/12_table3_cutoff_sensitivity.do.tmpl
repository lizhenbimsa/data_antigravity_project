* ============================================================================
* 12_table3_cutoff_sensitivity.do — IV 相似度 cutoff 阈值敏感性 (llm_peer)
* Paper: {{PAPER_ID}}
*
* Cao 2025 §3.4: LLM 定义的同业集合依赖相似度 cutoff τ ∈ {0.70,
*   0.75, 0.80, 0.85, 0.90}。cutoff 越低 → 同业集合越大; 越高 → 越窄。
*   稳健性检验: 主 2SLS 系数应在各 τ 取值下保持稳定。
* 白话: "谁算同行"取决于相似度门槛划在哪; 把门槛从松到紧各试一遍,
*   证明结论不是挑了某个门槛才成立的。
*
* 输出: $tables_dir/table3_cutoff_sensitivity.tex (5 列, 每 τ 一列)
* ============================================================================

version 19
clear all
set more off

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"
capture mkdir "$tables_dir"

use "$data_dir/_prepared_panel.dta", clear

local cutoffs 70 75 80 85 90
* 主估计量为 2SLS — 优先 ivreghdfe (HDFE), 缺失/运行期失败时回退 ivreg2 + 显式 i.bank_id i.year
* (镜像 11_table2 / 18_tableA9 的运行期鲁棒回退: 本机 StataNow 19.5 实测 ivreghdfe 因
*  ftools/reghdfe Mata 版本不兼容恒 r(301), 但 ivreg2 正常 → 旧"仅缺 ivreghdfe 才跳过"会让
*  Table 3 在 ivreghdfe 运行期崩 → 经 plain do 调用时阻断 00_master 整链; 改为各 2SLS
*  调用运行期失败自动回退 ivreg2, 两估计器皆失败该列优雅缺席, 绝不 abort master)。
capture which ivreghdfe
local HAS_IVHDFE = (_rc == 0)
capture which ivreg2
local HAS_IVREG2 = (_rc == 0)
if !`HAS_IVHDFE' & !`HAS_IVREG2' {
    display as error "[ERROR] ivreghdfe / ivreg2 required for Table 3; install via ssc install ivreghdfe ivreg2"
    exit 0
}

foreach c of local cutoffs {
    local iv_var llm_peer_tone_iv_full_`c'
    capture confirm variable `iv_var'
    if _rc {
        display "[WARN] `iv_var' missing; skipping cutoff=`c'"
        continue
    }
    local _crc = 1
    if `HAS_IVHDFE' {
        capture noisily ivreghdfe {{MAIN_DV}}_w ({{TONE_VAR}} = `iv_var') $controls, ///
            absorb(bank_id year) cluster({{CLUSTER_VAR}}) ffirst
        local _crc = _rc
    }
    if `_crc' != 0 & `HAS_IVREG2' {
        capture estimates drop C`c'
        capture noisily ivreg2 {{MAIN_DV}}_w ({{TONE_VAR}} = `iv_var') $controls i.bank_id i.year, ///
            cluster({{CLUSTER_VAR}}) partial(i.bank_id i.year)
        local _crc = _rc
    }
    if `_crc' == 0 eststo C`c'
    else display "[WARN] cutoff=`c' 2SLS 失败 (ivreghdfe r301 且 ivreg2 回退失败), 跳过"
}

* fix(omni-g-templates-04, 2026-06-11): esttab 名单动态化 — 循环内任一 cutoff 列缺失
* 被 continue 跳过后, 旧版硬点名 C70..C90 → 首个缺名估计即 r(111) 整表丢失。
* 改为仅引用实际已存储的估计, mtitle 同步删列防错位。
qui estimates dir
local stored `r(names)'
local models ""
local mtitles `""'
foreach c of local cutoffs {
    if `: list posof "C`c'" in stored' {
        local models `models' C`c'
        local mtitles `"`mtitles' "τ=0.`c'""'
    }
}
if "`models'" == "" {
    display as error "[WARN] Table 3 无任何 cutoff 估计 (llm_peer_tone_iv_full_70..90 全缺); 表跳过"
}
else {
    esttab `models' using "$tables_dir/table3_cutoff_sensitivity.tex", replace ///
        star(* 0.10 ** 0.05 *** 0.01) se booktabs ///
        label compress b(3) ///
        title("Cutoff Threshold Sensitivity --- llm_peer IV 2SLS") ///
        mtitles(`mtitles') ///
        addnotes("Each column re-instruments {{TONE_VAR}} with LLM-peer tone at the given τ." ///
                 "Bank and year FE; cluster-robust SE at {{CLUSTER_VAR}} level.")
}

display "[OK] Table 3 written to $tables_dir/table3_cutoff_sensitivity.tex"
