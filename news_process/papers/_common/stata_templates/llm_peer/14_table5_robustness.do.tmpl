* ============================================================================
* 14_table5_robustness.do — 稳健性组合 (llm_peer)
* Paper: {{PAPER_ID}}
*
* (R1) 覆盖度 IV 替换: {{LLM_PEER_COVERAGE_IV}}
*      (勘误 2026-06-12: 旧称"覆盖度加权"与实现不符 — llm_peer_iv.py 自始为
*      同行 ln_news_coverage 的等权均值, 见 fix omni-g-llm-peer-08)
* (R2) 竞争强度控制: {{COMPETE_IDX}}
* (R3) ctx 轨 tone (以 _ctx 替换 _full)
* (R4) 省级聚类替代 SE (cluster(prov_id), eststo R4)
*      (勘误 2026-06-12: 旧头注称 "leave-one-province-out (clusterboot), 仅诊断
*      不 eststo", 与下方实际实现不符 — 实际为省级聚类并 eststo R4 进表)
*
* 输出: $tables_dir/table5_robustness.tex
* ============================================================================

version 19
clear all
set more off

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"
capture mkdir "$tables_dir"

use "$data_dir/_prepared_panel.dta", clear

* 主估计量为 2SLS — 优先 ivreghdfe (HDFE), 缺失/运行期失败时回退 ivreg2 + 显式 i.bank_id i.year
* (镜像 11_table2 / 18_tableA9: 本机 StataNow 19.5 ivreghdfe 恒 r(301), ivreg2 正常 →
*  旧 bare ivreghdfe 运行期崩 → 经 plain do 调用阻断 00_master 整链; esttab 已动态化,
*  失败列经 estimates dir 自动剔除)。
capture which ivreghdfe
local HAS_IVHDFE = (_rc == 0)
capture which ivreg2
local HAS_IVREG2 = (_rc == 0)
if !`HAS_IVHDFE' & !`HAS_IVREG2' {
    display as error "[ERROR] ivreghdfe / ivreg2 required for Table 5"
    exit 199
}

* R1: 覆盖度 IV 替换 (等权均值口径, 见文件头勘误)
local _crc = 1
if `HAS_IVHDFE' {
    capture noisily eststo R1: ivreghdfe {{MAIN_DV}}_w ({{TONE_VAR}} = {{LLM_PEER_COVERAGE_IV}}) $controls, ///
        absorb(bank_id year) cluster({{CLUSTER_VAR}}) ffirst
    local _crc = _rc
}
if `_crc' != 0 & `HAS_IVREG2' {
    capture estimates drop R1
    capture noisily eststo R1: ivreg2 {{MAIN_DV}}_w ({{TONE_VAR}} = {{LLM_PEER_COVERAGE_IV}}) $controls i.bank_id i.year, ///
        cluster({{CLUSTER_VAR}}) partial(i.bank_id i.year)
}

* R2: + 竞争强度控制
local _crc = 1
if `HAS_IVHDFE' {
    capture noisily eststo R2: ivreghdfe {{MAIN_DV}}_w ({{TONE_VAR}} = {{LLM_PEER_IV}}) {{COMPETE_IDX}} $controls, ///
        absorb(bank_id year) cluster({{CLUSTER_VAR}}) ffirst
    local _crc = _rc
}
if `_crc' != 0 & `HAS_IVREG2' {
    capture estimates drop R2
    capture noisily eststo R2: ivreg2 {{MAIN_DV}}_w ({{TONE_VAR}} = {{LLM_PEER_IV}}) {{COMPETE_IDX}} $controls i.bank_id i.year, ///
        cluster({{CLUSTER_VAR}}) partial(i.bank_id i.year)
}

* R3: ctx 轨内生变量 + IV (若 _ctx 变体存在)
* fix(omni-g-templates-04, 2026-06-11): 旧版连续两条 capture confirm — 后一条覆盖 _rc,
* 第一变量 (llm_vote_tone_ctx) 单独缺失时守卫穿透 → ivreghdfe r(111)。合并为单次
* confirm (多变量语义: 任一缺失即 _rc≠0)。
capture confirm variable llm_vote_tone_ctx llm_peer_tone_iv_ctx
if !_rc {
    local _crc = 1
    if `HAS_IVHDFE' {
        capture noisily eststo R3: ivreghdfe {{MAIN_DV}}_w (llm_vote_tone_ctx = llm_peer_tone_iv_ctx) $controls, ///
            absorb(bank_id year) cluster({{CLUSTER_VAR}}) ffirst
        local _crc = _rc
    }
    if `_crc' != 0 & `HAS_IVREG2' {
        capture estimates drop R3
        capture noisily eststo R3: ivreg2 {{MAIN_DV}}_w (llm_vote_tone_ctx = llm_peer_tone_iv_ctx) $controls i.bank_id i.year, ///
            cluster({{CLUSTER_VAR}}) partial(i.bank_id i.year)
    }
}
else {
    display "[INFO] Ctx-track IV variables not in panel; R3 skipped."
}

* R4: 省级聚类 (替代 SE; 当 CLUSTER_VAR != prov_id 时有信息量)
capture confirm variable prov_id
if !_rc {
    local _crc = 1
    if `HAS_IVHDFE' {
        capture noisily eststo R4: ivreghdfe {{MAIN_DV}}_w ({{TONE_VAR}} = {{LLM_PEER_IV}}) $controls, ///
            absorb(bank_id year) cluster(prov_id) ffirst
        local _crc = _rc
    }
    if `_crc' != 0 & `HAS_IVREG2' {
        capture estimates drop R4
        capture noisily eststo R4: ivreg2 {{MAIN_DV}}_w ({{TONE_VAR}} = {{LLM_PEER_IV}}) $controls i.bank_id i.year, ///
            cluster(prov_id) partial(i.bank_id i.year)
    }
}

* === Winsorization sensitivity (主 2SLS 基准=1% 缩尾; 此处补 raw 与 5% 两档; Fama-French 1993 / Loughran-McDonald 2011) ===
* 与主 2SLS (M3) 同 ({{TONE_VAR}} = {{LLM_PEER_IV}}) 与 ffirst, 仅切换 DV 缩尾力度
local _crc = 1
if `HAS_IVHDFE' {
    capture noisily eststo wsens_raw: ivreghdfe {{MAIN_DV}} ({{TONE_VAR}} = {{LLM_PEER_IV}}) $controls, ///
        absorb(bank_id year) cluster({{CLUSTER_VAR}}) ffirst
    local _crc = _rc
}
if `_crc' != 0 & `HAS_IVREG2' {
    capture estimates drop wsens_raw
    capture noisily eststo wsens_raw: ivreg2 {{MAIN_DV}} ({{TONE_VAR}} = {{LLM_PEER_IV}}) $controls i.bank_id i.year, ///
        cluster({{CLUSTER_VAR}}) partial(i.bank_id i.year)
}
local _crc = 1
if `HAS_IVHDFE' {
    capture noisily eststo wsens_w5: ivreghdfe {{MAIN_DV}}_w5 ({{TONE_VAR}} = {{LLM_PEER_IV}}) $controls, ///
        absorb(bank_id year) cluster({{CLUSTER_VAR}}) ffirst
    local _crc = _rc
}
if `_crc' != 0 & `HAS_IVREG2' {
    capture estimates drop wsens_w5
    capture noisily eststo wsens_w5: ivreg2 {{MAIN_DV}}_w5 ({{TONE_VAR}} = {{LLM_PEER_IV}}) $controls i.bank_id i.year, ///
        cluster({{CLUSTER_VAR}}) partial(i.bank_id i.year)
}

* fix(omni-g-templates-04, 2026-06-11): esttab 名单动态化 — R3/R4 守卫跳过后旧版硬
* 点名 → r(111) 整表丢失; 仅引用实际已存储估计, mtitle 同步删列防错位。
qui estimates dir
local stored `r(names)'
local cand_models R1 R2 R3 R4 wsens_raw wsens_w5
local cand_titles `""Cov-IV" "+CompIdx" "Ctx-track" "Prov-cluster" "No-Winsor" "Winsor 5%""'
local models ""
local mtitles `""'
local nmod : word count `cand_models'
forvalues i = 1/`nmod' {
    local m : word `i' of `cand_models'
    if `: list m in stored' {
        local models `models' `m'
        local t : word `i' of `cand_titles'
        local mtitles `"`mtitles' "`t'""'
    }
}
esttab `models' using "$tables_dir/table5_robustness.tex", replace ///
    star(* 0.10 ** 0.05 *** 0.01) se booktabs ///
    label compress b(3) ///
    title("Robustness Battery --- llm_peer IV 2SLS") ///
    mtitles(`mtitles') ///
    addnotes("R1 swaps {{LLM_PEER_IV}}→{{LLM_PEER_COVERAGE_IV}}." ///
             "R2 adds {{COMPETE_IDX}} as exogenous control." ///
             "R3 replaces _full with _ctx tracks (if available)." ///
             "R4 clusters SE at province (if prov_id available).")

display "[OK] Table 5 written to $tables_dir/table5_robustness.tex"
