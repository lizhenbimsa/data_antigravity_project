* ============================================================================
* 11_table2_main_iv_2sls.do — 主 IV 2SLS 回归 (llm_peer)
* Paper: {{PAPER_ID}}
*
* 方法学来源: Cao, Y., Chen, L., Tucker, J.W., & Wan, C. (2025). Can generative
*   AI help identify peer firms? Review of Accounting Studies, 30(4), 3344-3386.
*   fix(omni-g-templates-05, 2026-06-11): 旧引文 "Cao, Z., Li, W., Wang, Y., &
*   Zhao, Y. … Review of Asset Studies" 为 LLM hallucination (期刊不存在 + 作者全错),
*   refs.bib (cao2025genai) 已改正, 此处对齐 canonical source (llm_peer_iv.py:16-18)。
*
* 估计方程:
*   {{MAIN_DV}}_it = β · {{TONE_VAR}}_it + γ' Controls_it + α_i + δ_t + ε_it
* 内生性担忧: {{TONE_VAR}} 内生 (银行自身报道可能反映同时影响 {{MAIN_DV}} 的
*   行内不可观测因素)。
* 工具变量: {{LLM_PEER_IV}} — LLM 生成同业组的留一法 (leave-one-out) 语调:
*   同业集合由 LLM 语义相似度确定 (baseline cutoff=0.80), 计算均值时剔除
*   该银行自身的报道。
* 识别假设: 在银行/年份 FE 条件下, LLM 定义的同业对焦点银行自身残差外生,
*   同时应对 reflection (Manski 1993) 与 correlated-effects 两类威胁。
* 白话: 担心"自家新闻语调"与"自家业绩"互相纠缠, 于是借 LLM 找出的同行们的
*   语调当杠杆 (算同行均值时不含自己), 用同行风向替自家语调进回归, 把因果
*   方向掰正。
*
* 输出: $tables_dir/table2_main_iv_2sls.tex (booktabs, 4 列: OLS / OLS+X / 2SLS / 2SLS+CompIdx)
* ============================================================================

version 19
clear all
set more off

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"
capture mkdir "$tables_dir"

use "$data_dir/_prepared_panel.dta", clear

* ----------------------------------------------------------------------------
* M1: OLS 基准 (无控制变量)
* ----------------------------------------------------------------------------
reghdfe {{MAIN_DV}}_w {{TONE_VAR}}, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo M1

* ----------------------------------------------------------------------------
* M2: OLS + 控制变量
* ----------------------------------------------------------------------------
reghdfe {{MAIN_DV}}_w {{TONE_VAR}} $controls, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo M2

* ----------------------------------------------------------------------------
* M3: IV 2SLS (Cao 2025 LLM-Peer 工具变量)
* ----------------------------------------------------------------------------
capture which ivreghdfe
if !_rc {
    ivreghdfe {{MAIN_DV}}_w ({{TONE_VAR}} = {{LLM_PEER_IV}}) $controls, ///
        absorb(bank_id year) cluster({{CLUSTER_VAR}}) ffirst
    eststo M3
}
else {
    display "[WARN] ivreghdfe not installed (ssc install ivreghdfe). M3 skipped."
    * 兜底: 改用 ivreg2 不带 absorb (效率较低)。
    capture which ivreg2
    if !_rc {
        ivreg2 {{MAIN_DV}}_w ({{TONE_VAR}} = {{LLM_PEER_IV}}) $controls i.bank_id i.year, ///
            cluster({{CLUSTER_VAR}}) ffirst
        eststo M3
    }
}

* ----------------------------------------------------------------------------
* M4: IV 2SLS + 竞争指数控制 (扩展)
* ----------------------------------------------------------------------------
capture which ivreghdfe
if !_rc {
    ivreghdfe {{MAIN_DV}}_w ({{TONE_VAR}} = {{LLM_PEER_IV}}) {{COMPETE_IDX}} $controls, ///
        absorb(bank_id year) cluster({{CLUSTER_VAR}}) ffirst
    eststo M4
}

* ----------------------------------------------------------------------------
* 输出表格
* ----------------------------------------------------------------------------
esttab M1 M2 M3 M4 using "$tables_dir/table2_main_iv_2sls.tex", replace ///
    star(* 0.10 ** 0.05 *** 0.01) se booktabs ///
    label compress b(3) ///
    title("Main IV 2SLS Results --- llm_peer (Cao et al. 2025)") ///
    mtitles("OLS" "OLS+X" "2SLS" "2SLS+CompIdx") ///
    addnotes("Bank and year fixed effects in all columns. Cluster-robust SE at {{CLUSTER_VAR}} level." ///
             "{{LLM_PEER_IV}} = LLM-defined peer leave-one-out tone (cutoff=0.80).")

display "[OK] Table 2 written to $tables_dir/table2_main_iv_2sls.tex"
