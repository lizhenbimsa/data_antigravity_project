* ============================================================================
* 11_table2_main_iv_2sls.do — 主 IV 2SLS 回归 (llm_peer)
* Paper: {{PAPER_ID}}
*
* 方法学来源: Cao, Y., Chen, L., Tucker, J.W., & Wan, C. (2025). Can generative
*   AI help identify peer firms? Review of Accounting Studies, 30(4), 3344-3386.
*   fix(omni-g-templates-05, 2026-06-11): 旧引文 "Cao, Z., Li, W., Wang, Y., &
*   Zhao, Y. … Review of Asset Studies" 为 LLM hallucination (期刊不存在 + 作者全错),
*   refs.bib (cao2025genai) 已改正, 此处对齐 canonical source (llm_peer_iv.py:16-18)。
*
* 估计方程:
*   {{MAIN_DV}}_it = β · {{TONE_VAR}}_it + γ' Controls_it + α_i + δ_t + ε_it
* 内生性担忧: {{TONE_VAR}} 内生 (银行自身报道可能反映同时影响 {{MAIN_DV}} 的
*   行内不可观测因素)。
* 工具变量: {{LLM_PEER_IV}} — LLM 生成同业组的留一法 (leave-one-out) 语调:
*   同业集合由 LLM 语义相似度确定 (baseline cutoff=0.80), 计算均值时剔除
*   该银行自身的报道。
* 识别假设: 在银行/年份 FE 条件下, LLM 定义的同业对焦点银行自身残差外生,
*   同时应对 reflection (Manski 1993) 与 correlated-effects 两类威胁。
* 白话: 担心"自家新闻语调"与"自家业绩"互相纠缠, 于是借 LLM 找出的同行们的
*   语调当杠杆 (算同行均值时不含自己), 用同行风向替自家语调进回归, 把因果
*   方向掰正。
*
* 输出: $tables_dir/table2_main_iv_2sls.tex (booktabs, 至多 6 列: OLS / OLS+X / 2SLS / 2SLS+CompIdx / 2SLS ctx / 2SLS ss; ctx/ss 列缺孪生列时动态省略)
* ============================================================================

version 19
clear all
set more off

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"
capture mkdir "$tables_dir"

use "$data_dir/_prepared_panel.dta", clear

* ----------------------------------------------------------------------------
* M1: OLS 基准 (无控制变量)
* ----------------------------------------------------------------------------
reghdfe {{MAIN_DV}}_w {{TONE_VAR}}, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo M1

* ----------------------------------------------------------------------------
* M2: OLS + 控制变量
* ----------------------------------------------------------------------------
reghdfe {{MAIN_DV}}_w {{TONE_VAR}} $controls, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo M2

* ----------------------------------------------------------------------------
* M3: IV 2SLS (Cao 2025 LLM-Peer 工具变量)
* ----------------------------------------------------------------------------
* 估计器选择 + 运行期鲁棒回退: 优先 ivreghdfe (HDFE 高效); 若 ivreghdfe 缺失【或
* 运行期失败】→ 自动回退 ivreg2 + 显式 i.bank_id i.year。⚠ 本机 StataNow 19.5 实测
* ivreghdfe 因 ftools/reghdfe Mata 版本不兼容恒 r(301) (reghdfe/ivreg2 均正常) →
* 旧"仅 ivreghdfe 缺失才回退"会让全部 IV 列空缺; 改为运行期失败亦回退, IV 列经
* ivreg2 照常填充。capture noisily 防弱识别/退化样本 abort; 两估计器皆失败 → 该列
* 优雅缺席 (动态 esttab 仅呈现已收敛规格, 同 benefit_society/25 的早期试跑 T=2 graceful-skip)。
local _m3 = 0
capture which ivreghdfe
if !_rc {
    capture noisily ivreghdfe {{MAIN_DV}}_w ({{TONE_VAR}} = {{LLM_PEER_IV}}) $controls, ///
        absorb(bank_id year) cluster({{CLUSTER_VAR}}) ffirst
    if !_rc {
        eststo M3
        local _m3 = 1
    }
}
if !`_m3' {
    capture which ivreg2
    if !_rc {
        capture noisily ivreg2 {{MAIN_DV}}_w ({{TONE_VAR}} = {{LLM_PEER_IV}}) $controls i.bank_id i.year, ///
            cluster({{CLUSTER_VAR}}) partial(i.bank_id i.year)
        if !_rc eststo M3
    }
    else display "[WARN] ivreghdfe 与 ivreg2 均不可用; M3 跳过"
}

* ----------------------------------------------------------------------------
* M4: IV 2SLS + 竞争指数控制 (扩展)
* ----------------------------------------------------------------------------
local _m4 = 0
capture which ivreghdfe
if !_rc {
    capture noisily ivreghdfe {{MAIN_DV}}_w ({{TONE_VAR}} = {{LLM_PEER_IV}}) {{COMPETE_IDX}} $controls, ///
        absorb(bank_id year) cluster({{CLUSTER_VAR}}) ffirst
    if !_rc {
        eststo M4
        local _m4 = 1
    }
}
if !`_m4' {
    capture which ivreg2
    if !_rc {
        capture noisily ivreg2 {{MAIN_DV}}_w ({{TONE_VAR}} = {{LLM_PEER_IV}}) {{COMPETE_IDX}} $controls i.bank_id i.year, ///
            cluster({{CLUSTER_VAR}}) partial(i.bank_id i.year)
        if !_rc eststo M4
    }
}

* ----------------------------------------------------------------------------
* M5: IV 2SLS — ctx 轨双轨稳健性 (2026-06-13 缺口补全)
*   内生孪生 llm_vote_tone_ctx (实体窗口归因) 配 ctx 同业 LOO 工具
*   llm_peer_tone_iv_ctx (llm_peer_iv.py dual-track parity 已物化), 与 full 轨 M3
*   【各自 just-identified、并排成列】表达对归因窗口 (全文 vs 实体窗口) 的稳健性。
*   严禁 full×ctx 合成 Hansen J overid — 同篇两窗共同冲击同污染, J 零功效
*   (Parente & Santos Silva 2012 EL)。ctx 列名硬编码 (非 spec 参数, 轨道恒定),
*   缺列优雅跳过 (旧复现包 / ctx 未落盘时不丢整表); ivreghdfe 失败同 M3 回退 ivreg2。
* ----------------------------------------------------------------------------
* 合并单次多变量 confirm (避免相邻双 confirm 后者覆盖 _rc; 同 14_table5 R3 idiom)
capture confirm variable llm_vote_tone_ctx llm_peer_tone_iv_ctx
if !_rc {
    local _m5 = 0
    capture which ivreghdfe
    if !_rc {
        capture noisily ivreghdfe {{MAIN_DV}}_w (llm_vote_tone_ctx = llm_peer_tone_iv_ctx) $controls, ///
            absorb(bank_id year) cluster({{CLUSTER_VAR}}) ffirst
        if !_rc {
            eststo M5
            local _m5 = 1
        }
    }
    if !`_m5' {
        capture which ivreg2
        if !_rc {
            capture noisily ivreg2 {{MAIN_DV}}_w (llm_vote_tone_ctx = llm_peer_tone_iv_ctx) $controls i.bank_id i.year, ///
                cluster({{CLUSTER_VAR}}) first
            if !_rc eststo M5
        }
    }
}
else {
    display "[WARN] ctx 轨列 (llm_vote_tone_ctx / llm_peer_tone_iv_ctx) 不在面板; M5 跳过"
}

* ----------------------------------------------------------------------------
* M6: IV 2SLS — ss 轨三轨稳健性 (2026-06-14 第三轨 _ss 平价补全)
*   内生孪生 llm_vote_tone_ss (银行+金科同句窗口归因) 配 ss 同业 LOO 工具
*   llm_peer_tone_iv_ss (iv_extensions.py 三轨平价已物化), 与 full 轨 M3 / ctx 轨 M5
*   【各自 just-identified、并排成列】表达对归因窗口 (全文 vs 实体窗口 vs 同句窗口)
*   的稳健性。严禁 full×ctx×ss 任两轨合成 Hansen J overid — 同篇三窗共同冲击同污染,
*   J 零功效 (Parente & Santos Silva 2012 EL)。ss 列名硬编码 (非 spec 参数, 轨道恒定),
*   缺列优雅跳过 (旧复现包 / ss 未落盘时不丢整表); ivreghdfe 失败同 M5 回退 ivreg2。
* ----------------------------------------------------------------------------
* 合并单次多变量 confirm (避免相邻双 confirm 后者覆盖 _rc; 同 M5 idiom)
capture confirm variable llm_vote_tone_ss llm_peer_tone_iv_ss
if !_rc {
    local _m6 = 0
    capture which ivreghdfe
    if !_rc {
        capture noisily ivreghdfe {{MAIN_DV}}_w (llm_vote_tone_ss = llm_peer_tone_iv_ss) $controls, ///
            absorb(bank_id year) cluster({{CLUSTER_VAR}}) ffirst
        if !_rc {
            eststo M6
            local _m6 = 1
        }
    }
    if !`_m6' {
        capture which ivreg2
        if !_rc {
            capture noisily ivreg2 {{MAIN_DV}}_w (llm_vote_tone_ss = llm_peer_tone_iv_ss) $controls i.bank_id i.year, ///
                cluster({{CLUSTER_VAR}}) first
            if !_rc eststo M6
        }
    }
}
else {
    display "[WARN] ss 轨列 (llm_vote_tone_ss / llm_peer_tone_iv_ss) 不在面板; M6 跳过"
}

* ----------------------------------------------------------------------------
* 输出表格 (名单动态化: M3/M4 依赖 ivreghdfe/ivreg2、M5 依赖 ctx 列、M6 依赖 ss 列在盘;
*   任一缺失时该列自动从表剔除而非触发 r(111) 丢整表)
* ----------------------------------------------------------------------------
qui estimates dir
local stored `r(names)'
local cand_models M1 M2 M3 M4 M5 M6
local cand_titles `""OLS" "OLS+X" "2SLS" "2SLS+CompIdx" "2SLS ctx" "2SLS ss""'
local models ""
local mtitles `""'
local nmod : word count `cand_models'
forvalues i = 1/`nmod' {
    local m : word `i' of `cand_models'
    if `: list m in stored' {
        local models `models' `m'
        local t : word `i' of `cand_titles'
        local mtitles `"`mtitles' "`t'""'
    }
}
if "`models'" == "" {
    display as error "  [WARN] Table 2 无任何已存储估计, 表跳过"
}
else {
    esttab `models' using "$tables_dir/table2_main_iv_2sls.tex", replace ///
        star(* 0.10 ** 0.05 *** 0.01) se booktabs ///
        label compress b(3) ///
        title("Main IV 2SLS Results --- llm_peer (Cao et al. 2025)") ///
        mtitles(`mtitles') ///
        addnotes("Bank and year fixed effects in all columns. Cluster-robust SE at {{CLUSTER_VAR}} level." ///
                 "{{LLM_PEER_IV}} = LLM-defined peer leave-one-out tone (cutoff=0.80, full track)." ///
                 "M5 (2SLS ctx): entity-window twin llm_vote_tone_ctx instrumented by llm_peer_tone_iv_ctx, just-identified side-by-side dual-track robustness --- NOT pooled with full-track IV (same-text windows make Hansen J uninformative; Parente-Santos Silva 2012)." ///
                 "M6 (2SLS ss): bank+fintech same-sentence twin llm_vote_tone_ss instrumented by llm_peer_tone_iv_ss, just-identified side-by-side tri-track robustness --- NEVER pooled with full/ctx IV into one Hansen J (same-article windows co-contaminate; Parente-Santos Silva 2012).")

    display "[OK] Table 2 written to $tables_dir/table2_main_iv_2sls.tex"
}
