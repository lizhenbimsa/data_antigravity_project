* ============================================================================
* 30_figure1_first_stage_F.do — 各 cutoff 阈值下的第一阶段 F 统计量
* Paper: {{PAPER_ID}}
*
* 可视化 LLM-Peer IV 在 5 个 cutoff 阈值下的 Kleibergen-Paap (或 Cragg-Donald)
* F 统计量。F > 10 (Stock-Yogo 2005) 提示强工具变量。
* 白话: 第一阶段 F 衡量工具变量和内生变量绑得够不够紧; F 低于 10 说明工具
*       太弱, 第二阶段的因果估计不可信。
*
* 输出: $figures_dir/figure1_first_stage_F.pdf
* ============================================================================

version 19
clear all
set more off

if "$data_dir" == ""     global data_dir "../data"
if "$figures_dir" == ""  global figures_dir "../output/figures"
capture mkdir "$figures_dir"

use "$data_dir/_prepared_panel.dta", clear

* 第一阶段 F 收集器 — 优先 ivreghdfe (HDFE), 缺失/运行期失败时回退 ivreg2 + 显式 i.bank_id i.year
* (镜像 11_table2 / 18_tableA9: 本机 StataNow 19.5 ivreghdfe 恒 r(301), ivreg2 正常且同样
*  报 e(widstat)=KP rk Wald F → 旧 bare ivreghdfe 运行期崩 → 经 plain do 调用阻断 00_master)。
capture which ivreghdfe
local HAS_IVHDFE = (_rc == 0)
capture which ivreg2
local HAS_IVREG2 = (_rc == 0)
if !`HAS_IVHDFE' & !`HAS_IVREG2' {
    display as error "[ERROR] ivreghdfe / ivreg2 required for figure1"
    exit 199
}

* 手工收集第一阶段 F 统计量 (各回归后从 e(widstat) 逐个取出, 见下方循环)。
* 构造 5 行 (cutoff, F) 小数据集后用 twoway 作图 (本图不调用 coefplot)。

tempname F_mat
matrix `F_mat' = J(5, 2, .)

local i = 0
foreach c in 70 75 80 85 90 {
    local ++i
    local iv_var llm_peer_tone_iv_full_`c'
    capture confirm variable `iv_var'
    if _rc continue

    local _crc = 1
    if `HAS_IVHDFE' {
        capture quietly ivreghdfe {{MAIN_DV}}_w ({{TONE_VAR}} = `iv_var') $controls, ///
            absorb(bank_id year) cluster({{CLUSTER_VAR}})
        local _crc = _rc
    }
    if `_crc' != 0 & `HAS_IVREG2' {
        capture quietly ivreg2 {{MAIN_DV}}_w ({{TONE_VAR}} = `iv_var') $controls i.bank_id i.year, ///
            cluster({{CLUSTER_VAR}}) partial(i.bank_id i.year)
        local _crc = _rc
    }
    if `_crc' != 0 continue
    local F_stat = e(widstat)
    matrix `F_mat'[`i', 1] = `c' / 100
    matrix `F_mat'[`i', 2] = `F_stat'
}

* 构造作图用小数据集。
preserve
clear
svmat `F_mat', names(col)
rename c1 cutoff
rename c2 F_stat
list

* 画折线 + 散点, 加 F=10 水平参考线 (Stock-Yogo 临界值)。
twoway (line F_stat cutoff, lcolor(black) lwidth(medium)) ///
       (scatter F_stat cutoff, msize(medium) mcolor(black)) ///
       (function y = 10, range(0.65 0.95) lpattern(dash) lcolor(red)), ///
    legend(order(1 "First-stage F" 3 "Stock-Yogo τ=10")) ///
    xtitle("LLM-Peer cutoff threshold") ytitle("Kleibergen-Paap F") ///
    title("First-stage F across cutoff thresholds (llm_peer)") ///
    scheme(s2color)
graph export "$figures_dir/figure1_first_stage_F.pdf", replace
restore

display "[OK] Figure 1 written to $figures_dir/figure1_first_stage_F.pdf"
