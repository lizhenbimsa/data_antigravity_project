* news_process v3.2.0 — Table 4: 异质性 Heterogeneity (plan v14 §9.2)
*
* 异质性维度:
*   1. Bank type (大型 vs 中小型, by bank_size 中位数)
*   2. Digital frontier (前沿 vs 跟随, by digital_frontier 二元)
*   3. Geographic zone (沿海 vs 内陆, by bank_zone)
*
* Main spec: locus={{MAIN_LOCUS_TRACK}} subst={{MAIN_SUBST_TRACK}} sent={{MAIN_SENT_TRACK}}

version 19

* fix(omni-g-templates-14, 2026-06-11): 隔离估计命名空间 (主线模板链共享 session)
eststo clear

local DV     llm_vote_tone_{{MAIN_SENT_TRACK}}
local LOCUS  tech_frac_{{MAIN_LOCUS_TRACK}}
local SUBST  symb_frac_{{MAIN_SUBST_TRACK}}

* V5 / st-table2-main-04 fix (2026-06-03): full 轨 (lf/sf) 展开成幻影列
* tech_frac_lf / symb_frac_sf (面板无, 只有裸名 tech_frac/symb_frac 与 ctx 轨
* tech_frac_lc/symb_frac_sc). 缺列时下方 reghdfe 引用为控制变量会 r(111) 整表崩.
* 加守卫: 缺列则置空, degrade 为不含 LOCUS/SUBST 的回归.
capture confirm variable `LOCUS' `SUBST'
if _rc {
    display "  ⚠️ LOCUS/SUBST 列缺 (`LOCUS' / `SUBST'): full 轨须用裸名, 见 stata_runner; 异质性回归 degrade 为不含 LOCUS/SUBST"
    local LOCUS
    local SUBST
}

* --- 异质性 1: Bank size 银行规模 (中位数切分) ---
capture confirm variable bank_size
if !_rc {
    quietly summarize bank_size, detail
    local med = r(p50)
    gen byte _large_bank = bank_size > `med' if !missing(bank_size)

    eststo HET1_large:  reghdfe `DV' digital_frontier `LOCUS' `SUBST' if _large_bank == 1, ///
        absorb(bank_id year) vce(cluster bank_id)
    eststo HET1_small:  reghdfe `DV' digital_frontier `LOCUS' `SUBST' if _large_bank == 0, ///
        absorb(bank_id year) vce(cluster bank_id)
}

* --- 异质性 2: Digital frontier 数字化前沿 (二元) ---
capture confirm variable digital_frontier
if !_rc {
    eststo HET2_front:  reghdfe `DV' `LOCUS' `SUBST' if digital_frontier == 1, ///
        absorb(bank_id year) vce(cluster bank_id)
    eststo HET2_back:   reghdfe `DV' `LOCUS' `SUBST' if digital_frontier == 0, ///
        absorb(bank_id year) vce(cluster bank_id)
}

* --- 异质性 3: Geographic zone 地理区域 (Engelberg & Parsons 2011 JF 地理) ---
capture confirm variable bank_zone
if !_rc {
    gen byte _coastal = inlist(bank_zone, "京津冀", "长三角", "珠三角", "东南", "环渤海")
    eststo HET3_coast: reghdfe `DV' digital_frontier `LOCUS' `SUBST' if _coastal == 1, ///
        absorb(bank_id year) vce(cluster bank_id)
    eststo HET3_inland: reghdfe `DV' digital_frontier `LOCUS' `SUBST' if _coastal == 0, ///
        absorb(bank_id year) vce(cluster bank_id)
}

* 输出 6 列对照 (3 异质维度 × 2 sub-samples)
* fix(omni-g-templates-12, 2026-06-11): esttab 名单动态化 — HET1 被 bank_size 守卫
* 跳过时 (bank_size 需 Wind/CSMAR merge, 当前 .dta 不在产), 旧版 esttab 硬引
* HET1_large → r(111) 硬崩且 00_master 的 do 无 capture → 后续 8 个模板永不执行。
* 改为仅引用实际已存储的估计, mtitle 同步删列防错位。
qui estimates dir
local stored `r(names)'
local cand_models HET1_large HET1_small HET2_front HET2_back HET3_coast HET3_inland
local cand_titles `""Large" "Small" "Frontier" "Follower" "Coastal" "Inland""'
local models ""
local mtitles `""'
local nmod : word count `cand_models'
forvalues i = 1/`nmod' {
    local m : word `i' of `cand_models'
    if `: list m in stored' {
        local models `models' `m'
        local t : word `i' of `cand_titles'
        local mtitles `"`mtitles' "`t'""'
    }
}
if "`models'" == "" {
    display as error "  ⚠️ Table 4 无任何已存储估计 (全部异质性切分列缺), 表跳过"
}
else {
    esttab `models' using "output/tables/table4_heterogeneity.tex", ///
        se star(* 0.10 ** 0.05 *** 0.01) ///
        booktabs replace fragment ///
        title("Table 4: Heterogeneity — Bank Size × Digital Frontier × Geography") ///
        mtitles(`mtitles') ///
        note("Robust SEs clustered at bank. Bank size split by median. Coastal = {京津冀, 长三角, 珠三角, 东南, 环渤海}.")

    * fix(omni-g-esttab-csv, 2026-06-11): CSV side-channel (parse_esttab_csv 消费)
    estout `models' using "output/tables/table4_heterogeneity.csv", replace delimiter(",") ///
        cells(b(star fmt(3)) se(par fmt(3))) stats(N r2, fmt(0 3)) ///
        starlevels(* 0.10 ** 0.05 *** 0.01) mlabels(`mtitles')

    display "✅ Table 4 written to output/tables/table4_heterogeneity.tex (+ .csv side-channel)"
}
