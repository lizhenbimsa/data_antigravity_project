* ============================================================================
* 01_data_prep.do — 加载面板 + xtset + 全局宏 (benefit_society)
* Paper: {{PAPER_ID}}
* ============================================================================

version 19
clear all
set more off

if "$data_dir" == ""  global data_dir "../data"
if "$panel_dta" == "" global panel_dta "$data_dir/40_panel_yearly.dta"

use "$panel_dta", clear
encode target_bank, gen(bank_id)
xtset bank_id year

global controls "{{CONTROLS}}"
* $bank_controls 保留为 $controls 的兼容性 alias (部分 robustness 模板引用)
global bank_controls "$controls"

* 管线必产变量校验 (stage 21/24/45 产出)
foreach v in {{ATTITUDE_VAR}} {{MECHANISM_TOKEN}} {{MECHANISM_HIDDEN}} {{MECHANISM_SUBST}} {
    capture confirm variable `v'
    if _rc {
        display as error "[ERROR] required variable `v' missing — run stage 21 (tone_llms) + 24 (herd_decay) + 45 (panel) first"
        exit 198
    }
}

* fix(omni-g-replication-01, 2026-06-11): MAIN_DV ({{MAIN_DV}}) 是外部财务列 sentinel
* (bank-year panel 无 ROA/CAR 列); 缺失时给出明确指引而非裸 "missing" (00_master fail-loud)。
capture confirm variable {{MAIN_DV}}
if _rc {
    display as error "[ERROR] required outcome {{MAIN_DV}} missing — 外部银行财务面板未接入 (CSMAR / config/银行面板2007-2025年.xlsx 待接入, 见 spec.outcome.enrichment_source)"
    exit 198
}

* fix(omni-g-replication-01, 2026-06-11): 非致命外部数据列的显式披露 (此前
* 仅靠下游模板 capture confirm 静默跳过整表, 复现者无从知晓缺哪些数据):
* {{ROBUSTNESS_DV}} 缺失 → Table 3 机制 M1 跳过; {{HET_VAR}} 缺失 → Table 4 整表跳过。
foreach v in {{ROBUSTNESS_DV}} {{HET_VAR}} {
    capture confirm variable `v'
    if _rc {
        display as error "[WARN] optional external variable `v' missing — 对应机制/异质性表将跳过 (外部银行财务面板待接入: config/银行面板2007-2025年.xlsx)"
    }
}

capture which winsor2
if !_rc winsor2 {{MAIN_DV}}, cuts(1 99) suffix(_w)
else gen {{MAIN_DV}}_w = {{MAIN_DV}}

* 缩尾敏感性 (winsorization-sensitivity 稳健性): 额外 5% 档 _w5 (raw {{MAIN_DV}} 由 suffix 保留, 仅作稳健性对照)
capture which winsor2
if !_rc winsor2 {{MAIN_DV}}, cuts(5 95) suffix(_w5)
else gen {{MAIN_DV}}_w5 = {{MAIN_DV}}

save "$data_dir/_prepared_panel.dta", replace
display "[OK] data prep N=" _N
