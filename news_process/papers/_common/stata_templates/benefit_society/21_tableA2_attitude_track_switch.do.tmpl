* v3.9.0: ss 轨 neg_frac 规格 (银行+金科同句; 缺列时 capture confirm 优雅跳过)
capture confirm variable {{BENEFIT_NEG_FRAC_SS}}
if !_rc {
    reghdfe {{MAIN_DV}}_w {{BENEFIT_NEG_FRAC_SS}} $controls, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    scalar b_neg_ss = _b[{{BENEFIT_NEG_FRAC_SS}}]
    if `has_boottest' {
