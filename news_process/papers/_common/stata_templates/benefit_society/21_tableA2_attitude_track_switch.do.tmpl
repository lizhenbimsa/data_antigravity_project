* ============================================================================
* 21_tableA2_attitude_track_switch.do — 双轨主规格对比
* Paper: {{PAPER_ID}}
*
* PAP v1.0-final §2 H3 证据 (审计冻结):
*   2 规格切换: full vs ctx
*   H3 验收标准:
*     (1) sign(beta_full) == sign(beta_ctx)
*     (2) min(|beta_full|, |beta_ctx|) / max(|beta_full|, |beta_ctx|) > 0.5
*   3 个维度联合评估 (mean / pos_frac / neg_frac, F-H3)。
* 白话: 同一个回归用全文口径和实体上下文口径各跑一遍, 两边系数得同号、
* 大小差距不超过一倍, 才算"换口径结论不变"。
*
* 野聚类自助法推断 (F-H4 / F-R5-H1), 经 boottest:
*   boottest 不直接接受 reghdfe e-class; 思路是先把 FE partial out 进残差,
*   再 regress + boottest。实现上依赖 boottest 对 reghdfe 的内建支持 (boottest >= 4.0)。
* ============================================================================

version 19
clear all
set more off

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"

use "$data_dir/_prepared_panel.dta", clear

set seed {{RANDOM_SEED}}

* fix(omni-gapfill-16, 2026-06-12): WCB 推断真正进表 — 此前 boottest 只对 full 轨
* 主回归跑一条且 r(p) 仅 display 到 log, esttab/.tex 的星标/SE 全是渐近 cluster
* 却加注 'Wild cluster bootstrap inference' (名实不符)。现 6 个规格逐一 boottest
* 并以 estadd 注入 e(p_wild) → esttab stats 行呈现; SE 括号仍如实为渐近 cluster。
capture which boottest
local has_boottest = (_rc == 0)
if !`has_boottest' {
    display "  [WARN] boottest not installed; Wild boot p row will be empty. " ///
            "Run: do 00_install_packages.do"
}

* ----- 2 规格主回归: full vs ctx, 3 个维度 = 共 6 个规格 -----
reghdfe {{MAIN_DV}}_w {{ATTITUDE_FULL}} $controls, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
scalar b_mean_full = _b[{{ATTITUDE_FULL}}]
scalar se_mean_full = _se[{{ATTITUDE_FULL}}]
if `has_boottest' {
    boottest {{ATTITUDE_FULL}}=0, reps({{BOOTSTRAP_REPS}}) cluster({{CLUSTER_VAR}}) ///
        seed({{RANDOM_SEED}}) nograph
    estadd scalar p_wild = r(p)
}
eststo M_mean_full

capture confirm variable {{ATTITUDE_CTX}}
if !_rc {
    reghdfe {{MAIN_DV}}_w {{ATTITUDE_CTX}} $controls, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    scalar b_mean_ctx = _b[{{ATTITUDE_CTX}}]
    scalar se_mean_ctx = _se[{{ATTITUDE_CTX}}]
    if `has_boottest' {
        boottest {{ATTITUDE_CTX}}=0, reps({{BOOTSTRAP_REPS}}) cluster({{CLUSTER_VAR}}) ///
            seed({{RANDOM_SEED}}) nograph
        estadd scalar p_wild = r(p)
    }
    eststo M_mean_ctx
}

capture confirm variable {{BENEFIT_POS_FRAC_FULL}} {{BENEFIT_POS_FRAC_CTX}}
if !_rc {
    reghdfe {{MAIN_DV}}_w {{BENEFIT_POS_FRAC_FULL}} $controls, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    scalar b_pos_full = _b[{{BENEFIT_POS_FRAC_FULL}}]
    if `has_boottest' {
        boottest {{BENEFIT_POS_FRAC_FULL}}=0, reps({{BOOTSTRAP_REPS}}) ///
            cluster({{CLUSTER_VAR}}) seed({{RANDOM_SEED}}) nograph
        estadd scalar p_wild = r(p)
    }
    eststo M_pos_full

    reghdfe {{MAIN_DV}}_w {{BENEFIT_POS_FRAC_CTX}} $controls, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    scalar b_pos_ctx = _b[{{BENEFIT_POS_FRAC_CTX}}]
    if `has_boottest' {
        boottest {{BENEFIT_POS_FRAC_CTX}}=0, reps({{BOOTSTRAP_REPS}}) ///
            cluster({{CLUSTER_VAR}}) seed({{RANDOM_SEED}}) nograph
        estadd scalar p_wild = r(p)
    }
    eststo M_pos_ctx
}

capture confirm variable {{BENEFIT_NEG_FRAC_FULL}} {{BENEFIT_NEG_FRAC_CTX}}
if !_rc {
    reghdfe {{MAIN_DV}}_w {{BENEFIT_NEG_FRAC_FULL}} $controls, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    scalar b_neg_full = _b[{{BENEFIT_NEG_FRAC_FULL}}]
    if `has_boottest' {
        boottest {{BENEFIT_NEG_FRAC_FULL}}=0, reps({{BOOTSTRAP_REPS}}) ///
            cluster({{CLUSTER_VAR}}) seed({{RANDOM_SEED}}) nograph
        estadd scalar p_wild = r(p)
    }
    eststo M_neg_full

    reghdfe {{MAIN_DV}}_w {{BENEFIT_NEG_FRAC_CTX}} $controls, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    scalar b_neg_ctx = _b[{{BENEFIT_NEG_FRAC_CTX}}]
    if `has_boottest' {
        boottest {{BENEFIT_NEG_FRAC_CTX}}=0, reps({{BOOTSTRAP_REPS}}) ///
            cluster({{CLUSTER_VAR}}) seed({{RANDOM_SEED}}) nograph
        estadd scalar p_wild = r(p)
    }
    eststo M_neg_ctx
}

* ----- H3 符号 + min/max 比例检查 (3 个维度) -----
quietly {
    foreach dim in mean pos neg {
        capture {
            scalar b_full = b_`dim'_full
            scalar b_ctx  = b_`dim'_ctx
            scalar sign_match_`dim' = sign(b_full) == sign(b_ctx)
            scalar ratio_`dim' = ///
                min(abs(b_full), abs(b_ctx)) / max(abs(b_full), abs(b_ctx))
            scalar h3_pass_`dim' = sign_match_`dim' & ratio_`dim' > 0.5
        }
        if _rc {
            scalar sign_match_`dim' = .
            scalar ratio_`dim' = .
            scalar h3_pass_`dim' = .
        }
    }
}

display _newline "H3 dual-track consistency (PAP v1.0-final §2):"
display "  mean   : sign_match=" sign_match_mean ", ratio=" ratio_mean ", pass=" h3_pass_mean
display "  pos    : sign_match=" sign_match_pos  ", ratio=" ratio_pos  ", pass=" h3_pass_pos
display "  neg    : sign_match=" sign_match_neg  ", ratio=" ratio_neg  ", pass=" h3_pass_neg

scalar h3_total_pass = (h3_pass_mean == 1) + (h3_pass_pos == 1) + (h3_pass_neg == 1)
display "  TOTAL  : " h3_total_pass " / 3 dimensions pass (>=2 required)"

* ----- 输出 Table A2 -----
* fix(omni-gapfill-16, 2026-06-12): Wild boot p stats 行呈现逐规格 boottest
* p 值 (estadd 注入, 见上方); 表注如实区分渐近 cluster SE 与 WCB p。
esttab M_mean_full M_mean_ctx M_pos_full M_pos_ctx M_neg_full M_neg_ctx ///
    using "$tables_dir/tableA2_attitude_track_switch.tex", replace ///
    star(* 0.10 ** 0.05 *** 0.01) se booktabs label compress b(3) ///
    title("Table A2: Dual-Track Switch Sensitivity (full vs ctx, 3 dimensions)") ///
    mgroups("benefit_mean" "benefit_pos_frac" "benefit_neg_frac", ///
            pattern(1 0 1 0 1 0)) ///
    mtitles("Full" "Ctx" "Full" "Ctx" "Full" "Ctx") ///
    stats(N r2 p_wild, fmt(0 3 3) labels("N" "R2" "Wild boot p")) ///
    addnotes("PAP v1.0-final §2 H3: sign_match AND min/max ratio > 0.5 across >=2/3 dimensions." ///
             "SE in parentheses: asymptotic cluster-robust ({{CLUSTER_VAR}})." ///
             "Wild boot p row: per-spec wild cluster bootstrap p-values (boottest, B={{BOOTSTRAP_REPS}}, F-R5-H1).")

* fix(omni-gapfill-08, 2026-06-12): CSV side-channel — papers/benefit_society/
* tables.py:build_table_a2_attitude_track_switch 经 read_paper_esttab(...,
* 'tableA2_attitude_track_switch.csv') 消费 (parse_esttab_csv 格式)。
estout M_mean_full M_mean_ctx M_pos_full M_pos_ctx M_neg_full M_neg_ctx ///
    using "$tables_dir/tableA2_attitude_track_switch.csv", replace delimiter(",") ///
    cells(b(star fmt(3)) se(par fmt(3))) stats(N r2 p_wild, fmt(0 3 3)) ///
    starlevels(* 0.10 ** 0.05 *** 0.01) ///
    mlabels("Mean-Full" "Mean-Ctx" "Pos-Full" "Pos-Ctx" "Neg-Full" "Neg-Ctx")

display _newline "[OK] Table A2 written to $tables_dir/tableA2_attitude_track_switch.tex (+ .csv side-channel)"
