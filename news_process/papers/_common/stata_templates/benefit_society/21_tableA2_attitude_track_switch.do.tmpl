* ----- H3 符号 + min/max 比例检查 (3 个维度) -----
quietly {
    foreach dim in mean pos neg {
        capture {
            scalar b_full = b_`dim'_full
            scalar b_ctx  = b_`dim'_ctx
            scalar sign_match_`dim' = sign(b_full) == sign(b_ctx)
            scalar ratio_`dim' = ///
                min(abs(b_full), abs(b_ctx)) / max(abs(b_full), abs(b_ctx))
            scalar h3_pass_`dim' = sign_match_`dim' & ratio_`dim' > 0.5
        }
        if _rc {
            scalar sign_match_`dim' = .
            scalar ratio_`dim' = .
            scalar h3_pass_`dim' = .
        }
    }
}

* 注: H3 验收准则 (PAP v1.0-final §2, 审计冻结) 仅基于 full×ctx 两轨; ss 为 v3.9.0
* 新增并列第三轨, 作补充佐证 (其系数另行 echo), 不改 H3 pass 判定逻辑。
display _newline "H3 full-vs-ctx consistency (PAP v1.0-final §2, 冻结准则):"
display "  mean   : sign_match=" sign_match_mean ", ratio=" ratio_mean ", pass=" h3_pass_mean
display "  pos    : sign_match=" sign_match_pos  ", ratio=" ratio_pos  ", pass=" h3_pass_pos
display "  neg    : sign_match=" sign_match_neg  ", ratio=" ratio_neg  ", pass=" h3_pass_neg

scalar h3_total_pass = (h3_pass_mean == 1) + (h3_pass_pos == 1) + (h3_pass_neg == 1)
display "  TOTAL  : " h3_total_pass " / 3 dimensions pass (>=2 required)"

* v3.9.0: ss 轨 (银行+金科同句) 系数补充展示 (非 H3 判定; 缺列时 scalar 未定义→capture)
display _newline "ss-track (银行+金科同句) 系数补充 (非 H3 判定):"
foreach dim in mean pos neg {
    capture display "  `dim'_ss : beta=" b_`dim'_ss
    if _rc display "  `dim'_ss : (ss 列缺失, 未估)"
}

* ----- 输出 Table A2 -----
* fix(omni-gapfill-16, 2026-06-12): Wild boot p stats 行呈现逐规格 boottest
* p 值 (estadd 注入, 见上方); 表注如实区分渐近 cluster SE 与 WCB p。
* v3.9.0: 三轨化 (full/ctx/ss) — 模型/mtitle/mlabel/mgroup pattern 动态构建,
*   每个维度内按 stored 估计逐 track (full/ctx/ss) 追加; ss 估计缺失时该列自动省略
*   → 表从满列 9 退化到 6 (full/ctx), esttab 不因点名缺失估计而 r(111) 崩。
qui estimates dir
local stored `r(names)'
local models ""
local mtitles `""'
local mlabels `""'
local pat ""
local grp_titles `""'
* 3 个维度, 各维度内逐 track (full/ctx/ss) 追加已存储估计; ss 列名后缀 _ss。
* 维度键 (d) / 分组标题 (gtitle) / mlabel 短名 (short) 三条平行 local, 按位对应。
local dim_keys    mean        pos              neg
local dim_titles  benefit_mean benefit_pos_frac benefit_neg_frac
local dim_shorts  Mean        Pos              Neg
local ndim : word count `dim_keys'
forvalues di = 1/`ndim' {
    local d      : word `di' of `dim_keys'
    local gtitle : word `di' of `dim_titles'
    local short  : word `di' of `dim_shorts'
    local first_in_group 1
    foreach trk in full ctx ss {
        local m M_`d'_`trk'
        if `: list m in stored' {
            local models `models' `m'
            * track 列标签: Full / Ctx / SS (银行+金科同句)
            if "`trk'" == "full"      local tlab "Full"
            else if "`trk'" == "ctx"  local tlab "Ctx"
            else                       local tlab "SS"
            local mtitles `"`mtitles' "`tlab'""'
            local mlabels `"`mlabels' "`short'-`tlab'""'
            local pat `pat' `first_in_group'
            if `first_in_group' {
                local grp_titles `"`grp_titles' "`gtitle'""'
                local first_in_group 0
            }
        }
    }
}

if "`models'" == "" {
    display as error "  ⚠️ Table A2 无任何已存储 attitude 规格估计, 表跳过"
}
else {
    * fix(reaudit-t18-2026-06-15): esttab addnotes() 内的英文【单引号】 ('Wild boot p')
    * 触发 r(109) type mismatch (本机 StataNow 19.5 + esttab: addnotes 字符串里的 ' 被
    * 误解析为宏引用/引号失衡)。经 probe 隔离: 同款 addnotes 去掉单引号即 rc=0 (title /
    * CJK 均无关)。解: addnotes 内不使用英文单引号 ('Wild boot p' → Wild boot p)。
    esttab `models' ///
        using "$tables_dir/tableA2_attitude_track_switch.tex", replace ///
        star(* 0.10 ** 0.05 *** 0.01) se booktabs label compress b(3) ///
        title("Table A2: Tri-Track Switch Sensitivity (full / ctx / ss=bank+fintech same-sentence, 3 dimensions)") ///
        mgroups(`grp_titles', pattern(`pat')) ///
        mtitles(`mtitles') ///
        stats(N r2 p_wild, fmt(0 3 3) labels("N" "R2" "Wild boot p")) ///
        addnotes("PAP v1.0-final Sec.2 H3 (full x ctx frozen criterion): sign_match AND min/max ratio greater than 0.5 across at least 2 of 3 dimensions." ///
                 "ss (bank+fintech same-sentence) is the v3.9.0 third parallel track: supplementary evidence, not part of the H3 decision." ///
                 "SE in parentheses: asymptotic cluster-robust ({{CLUSTER_VAR}})." ///
                 "Wild boot p row: per-spec wild cluster bootstrap p-values (boottest, B={{BOOTSTRAP_REPS}}, F-R5-H1).")

    * fix(omni-gapfill-08, 2026-06-12): CSV side-channel — papers/benefit_society/
    * tables.py:build_table_a2_attitude_track_switch 经 read_paper_esttab(...,
    * 'tableA2_attitude_track_switch.csv') 消费 (parse_esttab_csv 格式)。
    estout `models' ///
        using "$tables_dir/tableA2_attitude_track_switch.csv", replace delimiter(",") ///
        cells(b(star fmt(3)) se(par fmt(3))) stats(N r2 p_wild, fmt(0 3 3)) ///
        starlevels(* 0.10 ** 0.05 *** 0.01) ///
        mlabels(`mlabels')

    display _newline "[OK] Table A2 written to $tables_dir/tableA2_attitude_track_switch.tex (+ .csv side-channel; `: word count `models'' specs)"
}
