* news_process v3.7.3 — Table (paper-specific ext): Headline-Only Sentiment Robustness ({{PAPER_ID}})
* ============================================================================
* 26_bs_title_robustness.do — v3.7.3 Plan A v1.0 (execution-period correction v1.0.1)
* Paper: {{PAPER_ID}} (benefit_society)
* Purpose: _title 切片轨稳健性 (LLM-Embedding 双极锚点投影 × _title tone).
*
* NOTE: benefit_society 的 tA8 slot 已被 v3.5.1 A3 num_intensity 占用
* (19_bs_num_intensity_robustness), 故本 _title robustness 使用 paper-specific
* extension key `title_robustness_table` 而非 tables.tA8 (execution-period v1.0.1 correction).
*
* Anchor:
*   - Heston & Sinha (2017) FAJ; LM (2016) JAR §6; Boudoukh (2019) JFE
*   - Larcker & Watts (2020 JAE) — ESG measurement (benefit_society origin)
*   - Campbell & Fiske (1959) — MTMM
*
* Note: benefit_society main = LLM-Embedding 双极锚点投影 (attitude intensity);
* _title robustness 仅做 sentiment direction 校验, 不替换 main attitude measure.
* ============================================================================

version 19
clear all
set more off
set maxvar 32767
set linesize 120

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"

use "$data_dir/_prepared_panel.dta", clear
set seed {{RANDOM_SEED}}

local title_var = subinstr("{{MAIN_TREAT}}", "_ctx", "_title", .)
local title_var = subinstr("`title_var'", "_full", "_title", .)

display "  [benefit_society] {{PAPER_ID}}: title_var = `title_var'"

* Panel A: substitute main attitude with _title sentiment as direction check
capture confirm variable `title_var'
if !_rc {
    reghdfe {{MAIN_DV}} `title_var' $bank_controls, ///
        absorb(bank_id year) vce(cluster bank_id year)
    eststo bs_m_title_only

    reghdfe {{MAIN_DV}} {{MAIN_TREAT}} `title_var' $bank_controls, ///
        absorb(bank_id year) vce(cluster bank_id year)
    eststo bs_m_main_plus_title
}
else {
    display "  [WARN] `title_var' not in panel — bs Table A8 ext. Panel A skipped"
}

* Panel B: add tone_gap_title_full (Engelberg 2008 control)
capture confirm variable tone_gap_title_full
if !_rc {
    reghdfe {{MAIN_DV}} {{MAIN_TREAT}} tone_gap_title_full $bank_controls, ///
        absorb(bank_id year) vce(cluster bank_id year)
    eststo bs_m_with_gap
}

esttab bs_m_title_only bs_m_main_plus_title bs_m_with_gap ///
    using "$tables_dir/bs_title_robustness.tex", ///
    se star(* 0.10 ** 0.05 *** 0.01) replace ///
    mtitles("Title-only" "Main+Title" "+Gap control") ///
    title("Table: Headline-Only Sentiment Robustness — benefit_society") ///
    nonotes ///
    addnote("benefit_society tA8 slot 已被 A3 num_intensity 占用 (Plan A v1.0.1 correction). " ///
            "Anchors: Heston-Sinha (2017 FAJ); LM (2016 JAR §6); Larcker-Watts (2020 JAE).")

display "  [done] benefit_society title robustness table written"
