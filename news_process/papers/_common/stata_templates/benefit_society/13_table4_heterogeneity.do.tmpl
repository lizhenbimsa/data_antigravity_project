* ============================================================================
* 13_table4_heterogeneity.do — SOE × attitude (benefit_society)
* Paper: {{PAPER_ID}}
* ============================================================================

version 19
clear all
set more off

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"

use "$data_dir/_prepared_panel.dta", clear

capture confirm variable {{HET_VAR}}
if _rc {
    display "[INFO] {{HET_VAR}} not in panel; Table 4 skipped."
    exit 0
}

gen attitude_x_het = {{ATTITUDE_VAR}} * {{HET_VAR}}

* H1: full sample with interaction
reghdfe {{MAIN_DV}}_w {{ATTITUDE_VAR}} attitude_x_het {{HET_VAR}} $controls, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo H1

* H2 / H3: split-sample by HET_VAR
preserve
keep if {{HET_VAR}} == 0
reghdfe {{MAIN_DV}}_w {{ATTITUDE_VAR}} $controls, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo H2_low
restore

preserve
keep if {{HET_VAR}} == 1
reghdfe {{MAIN_DV}}_w {{ATTITUDE_VAR}} $controls, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo H3_high
restore

esttab H1 H2_low H3_high using "$tables_dir/table4_heterogeneity.tex", replace ///
    star(* 0.10 ** 0.05 *** 0.01) se booktabs label compress b(3) ///
    title("Heterogeneity by {{HET_VAR}} --- benefit_society") ///
    mtitles("Pooled+Int" "{{HET_VAR}}=0" "{{HET_VAR}}=1") ///
    addnotes("Brambor-Clark-Golder (2006) interaction; bank/year FE.")

display "[OK] Table 4 → $tables_dir/table4_heterogeneity.tex"
