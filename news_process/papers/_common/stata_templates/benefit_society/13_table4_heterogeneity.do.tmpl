* ============================================================================
* 13_table4_heterogeneity.do — 探索性异质性 (benefit_society)
* Paper: {{PAPER_ID}}
*
* PAP v1.0-final §6 (探索性, 不属 H 假设系列):
*   {{HET_VAR}} = is_listed (DP-9 / F-R3-H2)
*   FE: absorb(bank_type year) — 按 F-R5-H2 不用 absorb(bank_id year)
*       (2 年面板 + 仅类型内变异)
* ============================================================================

version 19
clear all
set more off

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"

use "$data_dir/_prepared_panel.dta", clear

set seed {{RANDOM_SEED}}

capture confirm variable {{HET_VAR}}
if _rc {
    display "[INFO] {{HET_VAR}} not in panel; Table 4 skipped (exploratory)."
    exit 0
}

gen attitude_x_het = {{ATTITUDE_VAR}} * {{HET_VAR}}

* H1: 全样本 + 交互项
reghdfe {{MAIN_DV}}_w {{ATTITUDE_VAR}} attitude_x_het {{HET_VAR}} $controls, ///
    absorb(bank_type year) vce(cluster {{CLUSTER_VAR}})
eststo H1

* H2/H3: 分样本回归 (F-R5-H2: absorb(bank_type year), 不用 bank_id)
preserve
keep if {{HET_VAR}} == 0
reghdfe {{MAIN_DV}}_w {{ATTITUDE_VAR}} $controls, ///
    absorb(bank_type year) vce(cluster {{CLUSTER_VAR}})
eststo H2_low
restore

preserve
keep if {{HET_VAR}} == 1
reghdfe {{MAIN_DV}}_w {{ATTITUDE_VAR}} $controls, ///
    absorb(bank_type year) vce(cluster {{CLUSTER_VAR}})
eststo H3_high
restore

esttab H1 H2_low H3_high using "$tables_dir/table4_heterogeneity.tex", replace ///
    star(* 0.10 ** 0.05 *** 0.01) se booktabs label compress b(3) ///
    title("Heterogeneity by {{HET_VAR}} (exploratory, PAP §6) --- benefit_society") ///
    mtitles("Pooled+Int" "{{HET_VAR}}=0" "{{HET_VAR}}=1") ///
    addnotes("Brambor-Clark-Golder (2006) interaction; bank_type/year FE (NOT bank FE per F-R5-H2)." ///
             "EXPLORATORY: not in H series; subsample n approx 40-80, power < 0.50.")

* fix(omni-gapfill-08, 2026-06-12): CSV side-channel — papers/benefit_society/
* tables.py:build_table4_heterogeneity 经 read_paper_esttab(...,
* 'table4_heterogeneity.csv') 消费 (parse_esttab_csv 格式)。
estout H1 H2_low H3_high using "$tables_dir/table4_heterogeneity.csv", ///
    replace delimiter(",") ///
    cells(b(star fmt(3)) se(par fmt(3))) stats(N r2, fmt(0 3)) ///
    starlevels(* 0.10 ** 0.05 *** 0.01) ///
    mlabels("Pooled+Int" "{{HET_VAR}}=0" "{{HET_VAR}}=1")

display "[OK] Table 4 → $tables_dir/table4_heterogeneity.tex (+ .csv side-channel)"
