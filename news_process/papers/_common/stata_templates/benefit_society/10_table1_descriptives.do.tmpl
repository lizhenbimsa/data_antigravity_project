* ============================================================================
* 10_table1_descriptives.do — Descriptive stats (benefit_society)
* Paper: {{PAPER_ID}}
* ============================================================================

version 15
clear all
set more off

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"

use "$data_dir/_prepared_panel.dta", clear

estpost summarize {{MAIN_DV}} {{ATTITUDE_VAR}} {{MECHANISM_TOKEN}} {{MECHANISM_HIDDEN}} {{MECHANISM_SUBST}} $controls, detail

esttab using "$tables_dir/table1_descriptives.tex", replace ///
    cells("count mean(fmt(3)) sd(fmt(3)) min(fmt(3)) p25(fmt(3)) p50(fmt(3)) p75(fmt(3)) max(fmt(3))") ///
    label nomtitle nonumber booktabs ///
    title("Descriptive Statistics --- benefit_society panel")

display "[OK] Table 1 → $tables_dir/table1_descriptives.tex"
