* ============================================================================
* 17b_table8b_shrinkage_dual.do — 贝叶斯收缩双轨伴生表
* Paper: {{PAPER_ID}}
*
* PAP v1.0-final §5 R5 双轨扩展 (F-H3 / F-R3-H1):
*   Panel A (full): 原始 / 收缩 / 逆权重 (= Table 8 已涵盖)
*   Panel B (ctx) : 原始 / 收缩 / 逆权重 (本模板)
*
* 前置列 (由 papers/benefit_society/shrinkage.py --track ctx 生成):
*   {{ATTITUDE_CTX}}_shrunk, {{ATTITUDE_CTX}}_shrunk_weight
* ============================================================================

version 19
clear all
set more off

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"

use "$data_dir/_prepared_panel.dta", clear

set seed {{RANDOM_SEED}}

capture confirm variable {{ATTITUDE_CTX}}
if _rc {
    display "[INFO] {{ATTITUDE_CTX}} absent; Table 8b skipped."
    exit 0
}

* ctx 轨原始 (未收缩)
reghdfe {{MAIN_DV}}_w {{ATTITUDE_CTX}} $controls, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo Sc_raw

* ctx 轨收缩后
capture confirm variable {{ATTITUDE_CTX}}_shrunk
if _rc != 0 {
    display "[INFO] {{ATTITUDE_CTX}}_shrunk absent. " ///
            "Run: python -m news_process.papers.benefit_society.shrinkage --track ctx"
    exit 0
}
reghdfe {{MAIN_DV}}_w {{ATTITUDE_CTX}}_shrunk $controls, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo Sc_shrunk

* 逆权重
capture confirm variable {{ATTITUDE_CTX}}_shrunk_weight
if _rc == 0 {
    gen analytic_weight_ctx = 1 - {{ATTITUDE_CTX}}_shrunk_weight
    reghdfe {{MAIN_DV}}_w {{ATTITUDE_CTX}} $controls ///
        [aweight=analytic_weight_ctx], ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    eststo Sc_aweighted
}

esttab Sc_* using "$tables_dir/table8b_shrinkage_dual.tex", replace ///
    star(* 0.10 ** 0.05 *** 0.01) se booktabs label compress b(3) ///
    title("R5 Robustness: Bayesian Shrinkage (ctx track companion)") ///
    mtitles("Raw" "Shrunk" "Inv-Weight") ///
    addnotes("Companion to Table 8 (full track). Joint acceptance: " ///
             "(a) full + ctx both same-sign; (b) |beta_diff|/|beta_raw| < 30%.")

* fix(omni-gapfill-08, 2026-06-12): CSV side-channel — papers/benefit_society/
* tables.py:build_table_8b_shrinkage_dual 经 read_paper_esttab(...,
* 'table8b_shrinkage_dual.csv') 消费 (parse_esttab_csv 格式)。
estout Sc_* using "$tables_dir/table8b_shrinkage_dual.csv", replace delimiter(",") ///
    cells(b(star fmt(3)) se(par fmt(3))) stats(N r2, fmt(0 3)) ///
    starlevels(* 0.10 ** 0.05 *** 0.01) mlabels("Raw" "Shrunk" "Inv-Weight")

display "[OK] Table 8b shrinkage ctx --> $tables_dir/table8b_shrinkage_dual.tex (+ .csv side-channel)"
