* ============================================================================
* 23_tableA10_placebo_business_lines.do — S1 J-L-M §4.2 placebo industries
* Paper: {{PAPER_ID}}
*
* V2.0 J-L-M 2026 robustness alignment plan §3 Phase 2 P2.S1:
*   Apply MAIN 10-anchor fintech direction to NON-fintech article subsets
*   (4 business lines + 1 neutral baseline). If main signal is fintech-
*   specific, placebo β should be near-zero.
*
* Acceptance (AC-S1, plan §4):
*   |β_placebo / β_main_fintech| < 0.3 for >=4/5 placebo specs.
*
* Data dependency: this template expects the audit-only panel
*   data/processed/27c_alt_anchor_and_placebo_panel.parquet
* to be merged into _prepared_panel.dta with these columns:
*   benefit_placebo_housing_loans_mean / _credit_cards_mean /
*   _intermediate_business_mean / _branch_channel_mean / _general_corporate_mean
*
* Anchor design rationale (V2.0 plan §2 N2 + S1 design):
*   J-L-M 2026 §4.2 changes anchors (coal/paper/tobacco) to test method
*   generality. benefit_society inverts: keeps fintech anchors fixed, changes
*   ARTICLE FILTER. If fintech anchors are domain-meaningful, projection onto
*   non-fintech text should NOT predict ROA.
* ============================================================================

version 19
clear all
set more off

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"

use "$data_dir/_prepared_panel.dta", clear

set seed {{RANDOM_SEED}}

* ----- Baseline: main fintech β (for scaling acceptance) -----
reghdfe {{MAIN_DV}}_w {{ATTITUDE_VAR}} $controls, ///
    absorb(bank_type year) vce(cluster {{CLUSTER_VAR}})
eststo P0_main
scalar b_main = _b[{{ATTITUDE_VAR}}]
display "[INFO] Main β reference: " b_main

* ----- 4 business-line placebos -----
local placebos housing_loans credit_cards intermediate_business branch_channel general_corporate
local i = 1
foreach pl of local placebos {
    local col benefit_placebo_`pl'_mean
    capture confirm variable `col'
    if _rc == 0 {
        reghdfe {{MAIN_DV}}_w `col' $controls, ///
            absorb(bank_type year) vce(cluster {{CLUSTER_VAR}})
        eststo P`i'_`pl'
        * Acceptance check: |β_placebo / β_main| < 0.3
        scalar b_pl = _b[`col']
        scalar ratio_`pl' = abs(b_pl) / abs(b_main)
        scalar accept_`pl' = ratio_`pl' < 0.3
        display "[CHECK] " "`pl'" ": β=" b_pl " ratio=" ratio_`pl' " accept=" accept_`pl'
    }
    else {
        display "[INFO] Column `col' not in panel (run 27c_placebo_and_alt_anchor.py first); skipping"
    }
    local i = `i' + 1
}

* ----- Final acceptance tally -----
quietly {
    scalar n_accept = 0
    foreach pl of local placebos {
        capture {
            if accept_`pl' == 1 scalar n_accept = n_accept + 1
        }
    }
}
display _newline "AC-S1 Acceptance Scoreboard (plan §4): " n_accept " / 5 placebos pass (>=4 required)"

esttab P0_main P*_* using "$tables_dir/tableA10_placebo_business_lines.tex", replace ///
    star(* 0.10 ** 0.05 *** 0.01) se booktabs label compress b(3) ///
    title("Placebo Business-Line Robustness (V2.0 plan S1; J-L-M 2026 §4.2)") ///
    mtitles("Main" "Housing" "Cards" "Inter-Biz" "Branch" "Neutral") ///
    addnotes("Main = fintech-specific 10-anchor direction on full article corpus." ///
             "Placebos = same direction on keyword-filtered subsets (non-fintech business lines)." ///
             "AC-S1: |beta_placebo / beta_main| < 0.3 for >=4/5 placebo specs.")

display "[OK] Table A10 placebo --> $tables_dir/tableA10_placebo_business_lines.tex"
