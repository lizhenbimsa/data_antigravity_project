* ============================================================================
* 23_tableA10_placebo_business_lines.do — S1 J-L-M §4.2 placebo 业务线安慰剂检验
* Paper: {{PAPER_ID}}
*
* V2.0 J-L-M 2026 稳健性对齐计划 §3 Phase 2 P2.S1:
*   把主测度的 10 锚点 fintech 方向向量套到"非 fintech"文章子集上
*   (4 个业务线 + 1 个中性基线)。若主信号确为 fintech 特异,
*   placebo β 应接近 0。
* 白话: 用"金融科技"专用的尺子去量住房贷款、信用卡等不相干的新闻,
* 量出来不应该再有解释力; 若 placebo 也显著, 说明主结果可能只是
* 在捕捉笼统的"好消息"而非 fintech 本身。
*
* 验收标准 (AC-S1, plan §4):
*   ≥4/5 个 placebo 规格满足 |β_placebo / β_main_fintech| < 0.3。
*
* 数据依赖: 本模板要求 audit-only 面板
*   data/processed/80_alt_anchor_and_placebo_panel.parquet
* 已 merge 进 _prepared_panel.dta, 含以下列:
*   benefit_placebo_housing_loans_mean / _credit_cards_mean /
*   _intermediate_business_mean / _branch_channel_mean / _general_corporate_mean
*
* 锚点设计理据 (V2.0 plan §2 N2 + S1 design):
*   J-L-M 2026 §4.2 是换锚点 (coal/paper/tobacco) 检验方法普适性;
*   benefit_society 反向操作: 固定 fintech 锚点不动, 换"文章过滤器"。
*   若 fintech 锚点确有领域含义, 投影到非 fintech 文本上不应预测 ROA。
* ============================================================================

version 19
clear all
set more off

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"

use "$data_dir/_prepared_panel.dta", clear

set seed {{RANDOM_SEED}}

* ----- 基线: 主 fintech β (作验收比例的分母) -----
reghdfe {{MAIN_DV}}_w {{ATTITUDE_VAR}} $controls, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo P0_main
scalar b_main = _b[{{ATTITUDE_VAR}}]
display "[INFO] Main β reference: " b_main

* ----- 4 个业务线 placebo (+1 中性基线) -----
local placebos housing_loans credit_cards intermediate_business branch_channel general_corporate
local i = 1
foreach pl of local placebos {
    local col benefit_placebo_`pl'_mean
    capture confirm variable `col'
    if _rc == 0 {
        reghdfe {{MAIN_DV}}_w `col' $controls, ///
            absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
        eststo P`i'_`pl'
        * 验收检查: |β_placebo / β_main| < 0.3
        scalar b_pl = _b[`col']
        scalar ratio_`pl' = abs(b_pl) / abs(b_main)
        scalar accept_`pl' = ratio_`pl' < 0.3
        display "[CHECK] " "`pl'" ": β=" b_pl " ratio=" ratio_`pl' " accept=" accept_`pl'
    }
    else {
        display "[INFO] Column `col' not in panel (run 80_placebo_and_alt_anchor.py first); skipping"
    }
    local i = `i' + 1
}

* ----- 最终验收计数 -----
quietly {
    scalar n_accept = 0
    foreach pl of local placebos {
        capture {
            if accept_`pl' == 1 scalar n_accept = n_accept + 1
        }
    }
}
display _newline "AC-S1 Acceptance Scoreboard (plan §4): " n_accept " / 5 placebos pass (>=4 required)"

esttab P0_main P*_* using "$tables_dir/tableA10_placebo_business_lines.tex", replace ///
    star(* 0.10 ** 0.05 *** 0.01) se booktabs label compress b(3) ///
    title("Placebo Business-Line Robustness (V2.0 plan S1; J-L-M 2026 §4.2)") ///
    mtitles("Main" "Housing" "Cards" "Inter-Biz" "Branch" "Neutral") ///
    addnotes("Main = fintech-specific 10-anchor direction on full article corpus." ///
             "Placebos = same direction on keyword-filtered subsets (non-fintech business lines)." ///
             "AC-S1: |beta_placebo / beta_main| < 0.3 for >=4/5 placebo specs.")

* fix(omni-gapfill-08, 2026-06-12): CSV side-channel — papers/benefit_society/
* tables.py:build_table_a10_placebo 与 figures.py:plot_placebo_comparison 经
* read_paper_esttab(...,'tableA10_placebo_business_lines.csv') 消费
* (parse_esttab_csv 格式; 首列为 Main 主回归列, 其余为 placebo)。
estout P0_main P*_* using "$tables_dir/tableA10_placebo_business_lines.csv", ///
    replace delimiter(",") ///
    cells(b(star fmt(3)) se(par fmt(3))) stats(N r2, fmt(0 3)) ///
    starlevels(* 0.10 ** 0.05 *** 0.01) ///
    mlabels("Main" "Housing" "Cards" "Inter-Biz" "Branch" "Neutral")

display "[OK] Table A10 placebo --> $tables_dir/tableA10_placebo_business_lines.tex (+ .csv side-channel)"
