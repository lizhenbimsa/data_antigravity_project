* ============================================================================
* 17_table8_shrinkage_robustness.do — R5 贝叶斯收缩稳健性 Bayesian shrinkage
* Paper: {{PAPER_ID}}
*
* PAP v1.0-final §5 R5 (按 F-H3 升级为双轨):
*   (a) 原始 {{ATTITUDE_FULL}}
*   (b) 收缩后 {{ATTITUDE_FULL}}_shrunk
*   (c) Ctx 轨收缩版 (伴生表: 17b_table8b_shrinkage_dual)
*
* 验收标准: beta 符号不变; |beta_shrunk - beta_raw| / |beta_raw| < 30%。
* 白话: 新闻很少的银行算出的态度分数噪音大; 贝叶斯收缩把这类不可靠的分数往组内
* 平均值"拉一拉"再重跑回归, 若结果基本不变, 说明主结论不是噪音观测撑起来的。
* ============================================================================

version 19
clear all
set more off

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"

use "$data_dir/_prepared_panel.dta", clear

set seed {{RANDOM_SEED}}

* 原始 (未收缩)
reghdfe {{MAIN_DV}}_w {{ATTITUDE_FULL}} $controls, ///
    absorb(bank_type year) vce(cluster {{CLUSTER_VAR}})
eststo S_raw

* 收缩后
capture confirm variable {{ATTITUDE_FULL}}_shrunk
if _rc != 0 {
    display "[INFO] {{ATTITUDE_FULL}}_shrunk not in panel. " ///
            "Run: python -m news_process.papers.benefit_society.shrinkage --track full"
    exit 0
}
reghdfe {{MAIN_DV}}_w {{ATTITUDE_FULL}}_shrunk $controls, ///
    absorb(bank_type year) vce(cluster {{CLUSTER_VAR}})
eststo S_shrunk

* 逆权重回归 (异方差校正)
capture confirm variable {{ATTITUDE_FULL}}_shrunk_weight
if _rc == 0 {
    gen analytic_weight = 1 - {{ATTITUDE_FULL}}_shrunk_weight
    reghdfe {{MAIN_DV}}_w {{ATTITUDE_FULL}} $controls ///
        [aweight=analytic_weight], ///
        absorb(bank_type year) vce(cluster {{CLUSTER_VAR}})
    eststo S_aweighted
}

esttab S_* using "$tables_dir/table8_shrinkage_robust.tex", replace ///
    star(* 0.10 ** 0.05 *** 0.01) se booktabs label compress b(3) ///
    title("R5 Robustness: Bayesian Shrinkage (full track)") ///
    mtitles("Raw" "Shrunk" "Inv-Weight") ///
    addnotes("Shrinkage: empirical Bayes, group = bank_type x province. " ///
             "Acceptance: same sign; |beta_diff/beta_raw| < 30%. " ///
             "Dual-track ctx version: Table 8b (17b_table8b_shrinkage_dual.do).")

display "[OK] Table 8 shrinkage --> $tables_dir/table8_shrinkage_robust.tex"
