* ============================================================================
* 12_table3_mechanism.do — Token/Hidden/Subst 机制检验 (benefit_society)
* Paper: {{PAPER_ID}}
*
* 方法论: Distel-Grimpe-Poetz (2026, Research Policy §3.2.1) —
*   Token (象征性采纳) vs Hidden (实质性采纳) 的脱耦 decoupling。
*   制度理论基础: Westphal & Zajac (2001, ASQ)。
*
* M1: Token → 短期市场反应 (用 ROBUSTNESS_DV = CAR)
* M2: Hidden → 长期基本面 (用 MAIN_DV = ROA)
* M3: Substantive (言行一致) → 基本面
* M4: Token + Hidden + Subst 联合
*
* V2.0 plan §3 P2.B2 (Round 9 fracreg + LPM 双模型):
*   M5/M6: 分数 logit (Papke-Wooldridge 1996 J. Applied Econometrics)
*          + OLS LPM, 用于取值有界的分数型 Y (token_adopt ∈ [0, 1])。
*   注: fracreg 不支持 absorb(); 改用 bank_id 哑变量
*   (Greene 2004 伴生参数问题 caveat, 见 §6.1 Limitations)。
* 白话: 检验"嘴上说"与"实际做"两条机制 — 只发公关稿不落地 (Token) 应只影响短期股价,
* 真投入 (Hidden) 才影响长期盈利; Y 是 0 到 1 之间的占比时, 普通回归可能预测出界,
* 故 M5 用专门处理占比因变量的分数 logit, M6 用普通线性模型互为印证。
* ============================================================================

version 19
clear all
set more off

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"

use "$data_dir/_prepared_panel.dta", clear

* M1: Token → CAR (短期市场反应)
capture confirm variable {{ROBUSTNESS_DV}}
if !_rc {
    reghdfe {{ROBUSTNESS_DV}} {{MECHANISM_TOKEN}} $controls, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    eststo M1_token_CAR
}

* M2: Hidden → ROA (长期基本面)
reghdfe {{MAIN_DV}}_w {{MECHANISM_HIDDEN}} $controls, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo M2_hidden_ROA

* M3: Substantive (token 与 hidden 的一致性) → ROA
reghdfe {{MAIN_DV}}_w {{MECHANISM_SUBST}} $controls, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo M3_subst_ROA

* M4: Token + Hidden + Subst 联合
reghdfe {{MAIN_DV}}_w {{MECHANISM_TOKEN}} {{MECHANISM_HIDDEN}} {{MECHANISM_SUBST}} $controls, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo M4_joint

* ============================================================================
* V2.0 plan §3 P2.B2 双模型列 (Round 9): 分数 logit + LPM,
* 用于分数型 Y (token_adopt_kw_p50 ∈ [0,1]; 经面板实查核实)。
* ============================================================================

* M5: 分数 logit (Papke-Wooldridge 1996), 用于 Token 采纳占比
capture confirm variable {{MECHANISM_TOKEN}}
if !_rc {
    quietly summarize {{MECHANISM_TOKEN}}, detail
    if r(min) >= 0 & r(max) <= 1 {
        * fracreg 要求 Y 在 [0, 1]; 因不支持 absorb(), bank_id 以哑变量进入
        capture fracreg logit {{MECHANISM_TOKEN}} {{ATTITUDE_VAR}} $controls i.bank_id i.year, ///
            vce(cluster {{CLUSTER_VAR}})
        if _rc == 0 {
            eststo M5_token_fracreg
            display "[OK] M5 fracreg logit converged"
        }
        else {
            display "[WARN] M5 fracreg did not converge (rc=" _rc "); see Limitations §6.1"
        }
    }
    else {
        display "[INFO] {{MECHANISM_TOKEN}} not in [0,1]; skipping fracreg"
    }
}

* M6: 同一 Y 的 OLS LPM (互为印证 sanity check; 标准面板 FE)
capture confirm variable {{MECHANISM_TOKEN}}
if !_rc {
    reghdfe {{MECHANISM_TOKEN}} {{ATTITUDE_VAR}} $controls, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    eststo M6_token_lpm
}

esttab M1_token_CAR M2_hidden_ROA M3_subst_ROA M4_joint M5_token_fracreg M6_token_lpm ///
    using "$tables_dir/table3_mechanism.tex", replace ///
    star(* 0.10 ** 0.05 *** 0.01) se booktabs label compress b(3) ///
    title("Mechanism --- Token vs Hidden Adoption (Distel 2026 + Westphal-Zajac 2001)") ///
    mtitles("Token→CAR" "Hidden→ROA" "Subst→ROA" "Joint" "Token-FracReg" "Token-LPM") ///
    addnotes("Bank/year FE; SE clustered at {{CLUSTER_VAR}}." ///
             "FracReg: Papke-Wooldridge 1996 for fraction Y in [0,1] (V2.0 plan P2.B2)." ///
             "LPM: standard FE OLS sanity check.")

* fix(omni-gapfill-08, 2026-06-12): CSV side-channel — papers/benefit_society/
* tables.py:build_table3_mechanism 经 read_paper_esttab(...,'table3_mechanism.csv')
* 消费 (parse_esttab_csv 格式; estout+delimiter 防 esttab csv 的 ="..." 包裹)。
estout M1_token_CAR M2_hidden_ROA M3_subst_ROA M4_joint M5_token_fracreg M6_token_lpm ///
    using "$tables_dir/table3_mechanism.csv", replace delimiter(",") ///
    cells(b(star fmt(3)) se(par fmt(3))) stats(N r2, fmt(0 3)) ///
    starlevels(* 0.10 ** 0.05 *** 0.01) ///
    mlabels("Token→CAR" "Hidden→ROA" "Subst→ROA" "Joint" "Token-FracReg" "Token-LPM")

display "[OK] Table 3 → $tables_dir/table3_mechanism.tex (+ .csv side-channel)"
