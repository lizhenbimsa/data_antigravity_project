* ============================================================================
* 25_tableA12_iv_2sls.do — benefit_society IV (2026-06-13 IV 补全)
* Paper: benefit_society (Jha, Liu & Manela 2026 RFS 经营效益态度测度)
*
* 内生变量: benefit_mean_full (媒体经营效益态度均值, paper_spec treatment.primary)
* IV (paper_spec identification.iv, iv_extensions.py 物化):
*   primary  = leave_one_out_peer_benefit_iv (同银行类型×年 LOO 态度均值;
*              滞后稳健性变体 leave_one_out_peer_benefit_iv_lag1)
*   fallback = zone_leave1out_benefit_iv     (同经济圈跨省 LOO 态度均值,
*              区域共同冲击粒度, 与 iv_did.compute_zone_leave1out 同构)
* 白话: 媒体对一家银行"是否有利经营"的态度可能被该行业绩反向驱动; 借
* "同类型/同区域其他银行被媒体如何评价"当外生推力 — 行业/区域层面的舆论
* 风向推得动对本行的态度, 但不直接由本行当期业绩决定。
*
* 第二阶段 DV: roa (外部财务面板待接入; 缺列时 2SLS 优雅跳过, 第一阶段照常输出)。
* ============================================================================

version 19
clear all
set more off
set maxvar 32767
set linesize 120

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"
capture mkdir "$tables_dir"   * 防 esttab 写出目录不存在 r(603) (与 11_table2 模板对齐)

use "$data_dir/_prepared_panel.dta", clear

local TX   benefit_mean_full
local IV1  leave_one_out_peer_benefit_iv
local IV2  zone_leave1out_benefit_iv
local DV   roa
* ctx 轨镜像 (2026-06-13 终审): 内生孪生 benefit_mean_ctx 配 ctx 同业 LOO 工具
* lpeer_benefit_iv_ctx, 与 full 轨【各自 just-identified、并排成列】表达双轨互为
* 稳健性; 勿与 full 轨 LOO 合成 overid — 同文两窗共同冲击同污染, Hansen J
* 零功效 (Parente & Santos Silva 2012 EL)。注: 既有 type×zone overid 是两套不同
* 分组 (bank_type vs bank_zone) 的合法跨族 overid, 与被否决的 full×ctx 无关。
local TXC  benefit_mean_ctx
local IVC  lpeer_benefit_iv_ctx
local IV2C zone_leave1out_benefit_iv_ctx

* ⚠ FE 锁定 = bank FE + year FE; 严禁 bank_type×year 交互 FE — 同业 LOO 工具
*   格内残余 = 自身内生变量的负镜像, type×year FE 下工具退化、排他性按构造违反。
capture confirm variable `TX'
if _rc {
    display "  [WARN] 内生变量 `TX' 不在面板; 表跳过"
    exit 0
}
capture which ivreg2
if _rc {
    display "  [WARN] ivreg2 not installed (ssc install ivreg2); 表跳过"
    exit 0
}

* 第一阶段 (现有面板即可运行)
capture confirm variable `IV1'
if !_rc {
    eststo first_type: reghdfe `TX' `IV1' $controls, ///
        absorb(bank_id year) vce(cluster bank_id)
}
capture confirm variable `IV2'
if !_rc {
    eststo first_zone: reghdfe `TX' `IV2' $controls, ///
        absorb(bank_id year) vce(cluster bank_id)
}
* ctx 轨一阶段 (benefit_mean_ctx ~ ctx 同业 LOO 工具; 缺列优雅跳过)
capture confirm variable `TXC' `IVC'
if !_rc {
    eststo first_ctx: reghdfe `TXC' `IVC' $controls, ///
        absorb(bank_id year) vce(cluster bank_id)
}
* ctx 轨 zone 一阶段 (benefit_mean_ctx ~ ctx 经济圈 LOO 工具; 2026-06-13 双轨补全)
capture confirm variable `TXC' `IV2C'
if !_rc {
    eststo first_zone_ctx: reghdfe `TXC' `IV2C' $controls, ///
        absorb(bank_id year) vce(cluster bank_id)
}

* 2SLS (DV 待外部财务数据; 缺列优雅跳过)
capture confirm variable `DV'
if _rc {
    display "  [WARN] 第二阶段 DV `DV' 未物化 (外部财务面板未接入); 仅输出第一阶段"
}
else {
    capture confirm variable `IV1'
    if !_rc {
        eststo tsls_type: ivreg2 `DV' (`TX' = `IV1') $controls ///
            i.bank_id i.year, cluster(bank_id) first
    }
    capture confirm variable `IV1' `IV2'
    if !_rc {
        * 过度识别列 (跨族 2 工具 1 内生 → Hansen J df=1; type-LOO×zone-LOO 两套
        * 不同分组、识别假设异质, 合法 overid — 区别于被否决的 full×ctx 同文双窗)
        eststo tsls_overid: ivreg2 `DV' (`TX' = `IV1' `IV2') $controls ///
            i.bank_id i.year, cluster(bank_id) first
    }
    * ctx 轨 just-identified 2SLS (与 full 轨 tsls_type 并排; 同一 DV, 双轨各自工具)
    capture confirm variable `TXC' `IVC'
    if !_rc {
        eststo tsls_ctx: ivreg2 `DV' (`TXC' = `IVC') $controls ///
            i.bank_id i.year, cluster(bank_id) first
    }
    * ctx 轨过度识别列 (ctx 同业-LOO × ctx 经济圈-LOO 两套不同分组 = 合法跨族
    * overid, Hansen J df=1; 与 full 轨 tsls_overid 镜像, 同样区别于被否决的
    * full×ctx 同文双窗)
    capture confirm variable `TXC' `IVC' `IV2C'
    if !_rc {
        eststo tsls_overid_ctx: ivreg2 `DV' (`TXC' = `IVC' `IV2C') $controls ///
            i.bank_id i.year, cluster(bank_id) first
    }
}

* ── 跨族 over-id 工具相关性诊断 (GPSS 2020 AER §5: overid 须报告工具间相关性) ──
* full 轨 (type-LOO × zone-LOO) 与 ctx 轨 (type-LOO × zone-LOO) 各算一对 pairwise
* corr。合法跨族 overid 的前提是两【分组维度】近正交; |rho| 高 → Hansen J (df=1)
* 欠功效 (与被否决的 full×ctx 同文双窗同病灶, Parente-Santos Silva 2012)。缺列 → n/a。
local rho_full "n/a"
local rho_ctx  "n/a"
capture confirm variable `IV1' `IV2'
if !_rc {
    qui correlate `IV1' `IV2'
    local rho_full : display %5.3f r(rho)
}
capture confirm variable `IVC' `IV2C'
if !_rc {
    qui correlate `IVC' `IV2C'
    local rho_ctx : display %5.3f r(rho)
}
display "  [over-id 工具相关性] full type-zone rho=`rho_full'  ctx type-zone rho=`rho_ctx'"

* esttab 名单动态化 (缺估计不点名, 防 r(111) 丢整表)
qui estimates dir
local stored `r(names)'
local cand_models first_type first_zone first_ctx first_zone_ctx tsls_type tsls_overid tsls_ctx tsls_overid_ctx
local cand_titles `""1st Type-LOO" "1st Zone-LOO" "1st LOO ctx" "1st Zone ctx" "2SLS Type" "2SLS Overid" "2SLS LOO ctx" "2SLS Overid ctx""'
local models ""
local mtitles `""'
local nmod : word count `cand_models'
forvalues i = 1/`nmod' {
    local m : word `i' of `cand_models'
    if `: list m in stored' {
        local models `models' `m'
        local t : word `i' of `cand_titles'
        local mtitles `"`mtitles' "`t'""'
    }
}
if "`models'" == "" {
    display as error "  [WARN] IV 表无任何已存储估计 (IV 列全缺), 表跳过"
}
else {
    esttab `models' ///
        using "$tables_dir/tableA12_benefit_iv_2sls.tex", replace ///
        star(* 0.10 ** 0.05 *** 0.01) se booktabs label compress b(3) ///
        stats(N r2 widstat jp, fmt(0 3 3 3) labels("N" "R²" "KP F" "Hansen J p")) ///
        title("Table A12: Benefit-Attitude IV — Type LOO + Zone LOO (First Stage + 2SLS)") ///
        mtitles(`mtitles') ///
        addnotes("IV1 = same-bank-type leave-one-out benefit-attitude mean; IV2 = same-economic-zone (cross-province) leave-one-out mean (regional common shocks; cf. iv_did.compute_zone_leave1out)." ///
                 "Exclusion caveats for peer-mean instruments (Manski 1993; Leary-Roberts 2014 JF) must be disclosed; lag-1 variant leave_one_out_peer_benefit_iv_lag1 as robustness." ///
                 "ctx columns: entity-window twin benefit_mean_ctx instrumented by ctx peer-LOO (lpeer_benefit_iv_ctx) and ctx zone-LOO (zone_leave1out_benefit_iv_ctx); just-identified + cross-family ctx over-id, side-by-side dual-track robustness — NOT pooled with full-track IV (same-text windows make Hansen J uninformative; Parente-Santos Silva 2012)." ///
                 "Cross-family over-id instrument correlations (GPSS 2020 AER sec.5): full type-LOO x zone-LOO rho=`rho_full'; ctx rho=`rho_ctx'. Distinct grouping dimensions (bank_type vs bank_zone) are near-orthogonal by construction; high |rho| would render the df=1 Hansen J underpowered." ///
                 "KP F = Kleibergen-Paap rk Wald F; if < 16.38 (Stock-Yogo 2005), use Anderson-Rubin CI (Andrews-Stock-Sun 2019). Hansen J only in overidentified column.")

    display "[OK] 25_tableA12_iv_2sls → $tables_dir/tableA12_benefit_iv_2sls.tex"
}
