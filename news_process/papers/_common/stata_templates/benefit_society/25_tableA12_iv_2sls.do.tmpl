* ============================================================================
* 25_tableA12_iv_2sls.do — benefit_society IV (2026-06-13 IV 补全)
* Paper: benefit_society (Jha, Liu & Manela 2026 RFS 经营效益态度测度)
*
* 内生变量: benefit_mean_full (媒体经营效益态度均值, paper_spec treatment.primary)
* IV (paper_spec identification.iv, iv_extensions.py 物化):
*   primary  = leave_one_out_peer_benefit_iv (同银行类型×年 LOO 态度均值;
*              滞后稳健性变体面板原名 leave_one_out_peer_benefit_iv_lag1 超
*              Stata 32 字符上限, .dta 实名 = l1o_peer_benefit_iv_lag1)
*   fallback = zone_leave1out_benefit_iv     (同经济圈跨省 LOO 态度均值,
*              区域共同冲击粒度, 与 iv_did.compute_zone_leave1out 同构)
* 白话: 媒体对一家银行"是否有利经营"的态度可能被该行业绩反向驱动; 借
* "同类型/同区域其他银行被媒体如何评价"当外生推力 — 行业/区域层面的舆论
* 风向推得动对本行的态度, 但不直接由本行当期业绩决定。
*
* 第二阶段 DV: {{MAIN_DV}} (外部财务面板待接入; 缺列时 2SLS 优雅跳过, 第一阶段照常输出)。
*
* IV-2 (2026-06-14 顶刊重审): 在已有 Hansen J over-id 基础上补 weakiv 弱工具稳健
*   AR-CI 块 — 把头注"KP F < Stock-Yogo 时改读 Anderson-Rubin CI"的声明落为真实
*   命令 (weakiv/condivreg/rivtest 三层回退 + capture which 守卫), AR-CI 经 esttab
*   note lockstep 进表 (Andrews-Stock-Sun 2019 ARE; Lee et al. 2022 AER tF)。
* ============================================================================

version 19
clear all
set more off
set maxvar 32767
set linesize 120

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"
* nested mkdir 防御 (主链 master 已建; 独立重跑/dry-run 时 $tables_dir 可能不存在 -> esttab r(603))
capture mkdir "$tables_dir"

use "$data_dir/_prepared_panel.dta", clear

local TX   benefit_mean_full
local IV1  leave_one_out_peer_benefit_iv
local IV2  zone_leave1out_benefit_iv
local DV   {{MAIN_DV}}
* ctx 轨镜像 (2026-06-13 终审): 内生孪生 benefit_mean_ctx 配 ctx 同业 LOO 工具
* lpeer_benefit_iv_ctx, 与 full 轨【各自 just-identified、并排成列】表达双轨互为
* 稳健性; 勿与 full 轨 LOO 合成 overid — 同文两窗共同冲击同污染, Hansen J
* 零功效 (Parente & Santos Silva 2012 EL)。注: 既有 type×zone overid 是两套不同
* 分组 (bank_type vs bank_zone) 的合法跨族 overid, 与被否决的 full×ctx 无关。
local TXC  benefit_mean_ctx
local IVC  lpeer_benefit_iv_ctx
local IV2C zone_leave1out_benefit_iv_ctx
* ss 轨镜像 (2026-06-14 第三轨 _ss 平价补全): 内生孪生 benefit_mean_ss 配 ss 同业
* LOO 工具 lpeer_benefit_iv_ss + ss 经济圈 LOO zone_leave1out_benefit_iv_ss, 与
* full / ctx 轨【各自 just-identified、并排成列】表达三轨互为稳健性; 严禁 full/ctx/ss
* 任两轨 LOO 合成 overid — 同文三窗共同冲击同污染, Hansen J 零功效 (Parente &
* Santos Silva 2012 EL)。注: ss 轨内 type×zone overid 仍是两套不同分组的合法跨族 overid。
local TXS  benefit_mean_ss
local IVS  lpeer_benefit_iv_ss
local IV2S zone_leave1out_benefit_iv_ss

* ⚠ FE 锁定 = bank FE + year FE; 严禁 bank_type×year 交互 FE — 同业 LOO 工具
*   格内残余 = 自身内生变量的负镜像, type×year FE 下工具退化、排他性按构造违反。
capture confirm variable `TX'
if _rc {
    display "  [WARN] 内生变量 `TX' 不在面板; 表跳过"
    exit 0
}
capture which ivreg2
if _rc {
    display "  [WARN] ivreg2 not installed (ssc install ivreg2); 表跳过"
    exit 0
}

* 第一阶段 (现有面板即可运行)
capture confirm variable `IV1'
if !_rc {
    eststo first_type: reghdfe `TX' `IV1' $controls, ///
        absorb(bank_id year) vce(cluster bank_id)
}
capture confirm variable `IV2'
if !_rc {
    eststo first_zone: reghdfe `TX' `IV2' $controls, ///
        absorb(bank_id year) vce(cluster bank_id)
}
* ctx 轨一阶段 (benefit_mean_ctx ~ ctx 同业 LOO 工具; 缺列优雅跳过)
capture confirm variable `TXC' `IVC'
if !_rc {
    eststo first_ctx: reghdfe `TXC' `IVC' $controls, ///
        absorb(bank_id year) vce(cluster bank_id)
}
* ctx 轨 zone 一阶段 (benefit_mean_ctx ~ ctx 经济圈 LOO 工具; 2026-06-13 双轨补全)
capture confirm variable `TXC' `IV2C'
if !_rc {
    eststo first_zone_ctx: reghdfe `TXC' `IV2C' $controls, ///
        absorb(bank_id year) vce(cluster bank_id)
}
* ss 轨一阶段 (benefit_mean_ss ~ ss 同业 LOO 工具; 缺列优雅跳过)
capture confirm variable `TXS' `IVS'
if !_rc {
    eststo first_ss: reghdfe `TXS' `IVS' $controls, ///
        absorb(bank_id year) vce(cluster bank_id)
}
* ss 轨 zone 一阶段 (benefit_mean_ss ~ ss 经济圈 LOO 工具; 三轨平价补全)
capture confirm variable `TXS' `IV2S'
if !_rc {
    eststo first_zone_ss: reghdfe `TXS' `IV2S' $controls, ///
        absorb(bank_id year) vce(cluster bank_id)
}

* 2SLS (DV 待外部财务数据; 缺列优雅跳过)
capture confirm variable `DV'
if _rc {
    display "  [WARN] 第二阶段 DV `DV' 未物化 (外部财务面板未接入); 仅输出第一阶段"
}
else {
    capture confirm variable `IV1'
    if !_rc {
        eststo tsls_type: ivreg2 `DV' (`TX' = `IV1') $controls ///
            i.bank_id i.year, cluster(bank_id) first
    }
    capture confirm variable `IV1' `IV2'
    if !_rc {
        * 过度识别列 (跨族 2 工具 1 内生 → Hansen J df=1; type-LOO×zone-LOO 两套
        * 不同分组、识别假设异质, 合法 overid — 区别于被否决的 full×ctx 同文双窗)
        * fix(2026-06-14 smoke): partial(i.bank_id i.year) — 高维 bank/year 哑变量 +
        *   bank 聚类下 ivreg2 否则判 moment-cov 秩亏 'overid stat not reported' → jp
        *   恒空 (claimed-but-not-run); partial 后 moment-cov 满秩, Hansen J df=1 真报告
        *   (同 attention/19 IV-5 修复, Stata /b 合成 T=18 验证)。
        eststo tsls_overid: ivreg2 `DV' (`TX' = `IV1' `IV2') $controls ///
            i.bank_id i.year, cluster(bank_id) partial(i.bank_id i.year) first
    }
    * ctx 轨 just-identified 2SLS (与 full 轨 tsls_type 并排; 同一 DV, 双轨各自工具)
    capture confirm variable `TXC' `IVC'
    if !_rc {
        eststo tsls_ctx: ivreg2 `DV' (`TXC' = `IVC') $controls ///
            i.bank_id i.year, cluster(bank_id) first
    }
    * ctx 轨过度识别列 (ctx 同业-LOO × ctx 经济圈-LOO 两套不同分组 = 合法跨族
    * overid, Hansen J df=1; 与 full 轨 tsls_overid 镜像, 同样区别于被否决的
    * full×ctx 同文双窗)
    capture confirm variable `TXC' `IVC' `IV2C'
    if !_rc {
        * fix(2026-06-14 smoke): partial(i.bank_id i.year) 同 full 轨 tsls_overid —
        *   令 ctx 跨族 Hansen J (df=1) 真报告 (否则 ivreg2 秩亏不报)。
        eststo tsls_overid_ctx: ivreg2 `DV' (`TXC' = `IVC' `IV2C') $controls ///
            i.bank_id i.year, cluster(bank_id) partial(i.bank_id i.year) first
    }
    * ss 轨 just-identified 2SLS (与 full 轨 tsls_type / ctx 轨 tsls_ctx 并排;
    * 同一 DV, 三轨各自工具; 三轨各自 just-id 绝不合并 Hansen J)
    capture confirm variable `TXS' `IVS'
    if !_rc {
        eststo tsls_ss: ivreg2 `DV' (`TXS' = `IVS') $controls ///
            i.bank_id i.year, cluster(bank_id) first
    }
    * ss 轨过度识别列 (ss 同业-LOO × ss 经济圈-LOO 两套不同分组 = 合法跨族 overid,
    * Hansen J df=1; 与 full / ctx 轨 tsls_overid 镜像, 同样区别于被否决的同文跨窗拼接)
    capture confirm variable `TXS' `IVS' `IV2S'
    if !_rc {
        * fix(2026-06-14): partial(i.bank_id i.year) 同 full/ctx 轨 — 令 ss 跨族
        *   Hansen J (df=1) 真报告 (否则 ivreg2 秩亏不报)。
        eststo tsls_overid_ss: ivreg2 `DV' (`TXS' = `IVS' `IV2S') $controls ///
            i.bank_id i.year, cluster(bank_id) partial(i.bank_id i.year) first
    }
}

* ── IV-2 弱工具稳健推断 (Anderson-Rubin CI; Andrews-Stock-Sun 2019 ARE) ──
* 把头注"KP F < Stock-Yogo 临界值时改读 AR CI"的声明落为真实命令: 对每个已估计的
* 2SLS 规格紧随其后跑 weak-IV-robust AR 置信集 (weakiv, ivreg2 后端), 写进 esttab note
* (lockstep)。三层回退: weakiv (over-id/恰好识别通用) → condivreg (恰好识别 AR/CLR) →
* rivtest。全程 capture which 守卫: 未装 ado 时优雅跳过 (诊断照常输出 KP F)。T=2 退化
* 或 DV 缺列时 AR 检验报错 → capture noisily 吞错, 不阻断主表输出。
* (镜像主线 25_tableA6_tone_iv_2sls 的 weakiv 块; benefit 第二阶段含 $controls +
*  i.bank_id i.year 外生集, IV 工具集随列而变。)
local ar_note ""
capture which weakiv
local has_weakiv = (_rc == 0)
capture which condivreg
local has_condivreg = (_rc == 0)
capture which rivtest
local has_rivtest = (_rc == 0)
* 仅当第二阶段 DV 在盘 (2SLS 列实际跑过) 才有 AR CI 可算
capture confirm variable `DV'
local has_dv = (_rc == 0)
if `has_dv' & (`has_weakiv' | `has_condivreg' | `has_rivtest') {
    * 6 列 (tag : 内生变量 : 工具集) — 与上方 eststo 同规格重估后立即调 weakiv
    foreach iv_spec in tsls_type tsls_overid tsls_ctx tsls_overid_ctx tsls_ss tsls_overid_ss {
        capture estimates restore `iv_spec'
        if _rc continue
        * 按列设定内生变量 `_en' 与工具集 `_ivset' (Stata 无 `;` 行内分隔, 逐行赋值)
        local _en ""
        local _ivset ""
        if "`iv_spec'" == "tsls_type" {
            local _en `TX'
            local _ivset `IV1'
        }
        if "`iv_spec'" == "tsls_overid" {
            local _en `TX'
            local _ivset `IV1' `IV2'
        }
        if "`iv_spec'" == "tsls_ctx" {
            local _en `TXC'
            local _ivset `IVC'
        }
        if "`iv_spec'" == "tsls_overid_ctx" {
            local _en `TXC'
            local _ivset `IVC' `IV2C'
        }
        if "`iv_spec'" == "tsls_ss" {
            local _en `TXS'
            local _ivset `IVS'
        }
        if "`iv_spec'" == "tsls_overid_ss" {
            local _en `TXS'
            local _ivset `IVS' `IV2S'
        }
        display ""
        display as text "── 弱工具稳健推断 (`iv_spec'): Anderson-Rubin CI ──"
        local _did_ar = 0
        if `has_weakiv' {
            capture noisily ivreg2 `DV' (`_en' = `_ivset') $controls ///
                i.bank_id i.year, cluster(bank_id)
            if !_rc {
                capture noisily weakiv, level(95)
                if !_rc local _did_ar = 1
            }
        }
        * condivreg 仅恰好识别 (单工具) 适用; 过度识别 (overid) 列跳过
        local _niv : word count `_ivset'
        if !`_did_ar' & `has_condivreg' & `_niv' == 1 {
            capture noisily condivreg `DV' $controls i.bank_id i.year (`_en' = `_ivset'), test(0)
            if !_rc local _did_ar = 1
        }
        if !`_did_ar' & `has_rivtest' {
            capture noisily ivreg2 `DV' (`_en' = `_ivset') $controls ///
                i.bank_id i.year, cluster(bank_id)
            if !_rc {
                capture noisily rivtest, ci
                if !_rc local _did_ar = 1
            }
        }
        if `_did_ar' {
            display as text "  (AR 弱工具稳健 CI 见上方 `iv_spec' 输出; 弱工具下以此 CI 解读, 勿凭 t 检验)"
        }
        else {
            display as text "  ⚠️ `iv_spec' AR CI 未能计算 (退化/缺 ado), 弱工具时须改用 AR-robust 推断"
        }
    }
    local ar_note "Anderson-Rubin weak-IV-robust CIs are reported in the log for each 2SLS column (weakiv/condivreg/rivtest, run inline after each fit). When KP F is below the Stock-Yogo critical value (16.38 for 5% maximal bias), READ the AR CI rather than the 2SLS t-ratio (Andrews-Stock-Sun 2019 ARE; Lee et al. 2022 AER tF). "
}
else {
    if !`has_dv' display as text "  [INFO] 第二阶段 DV `DV' 缺列, 无 2SLS 列; AR CI 跳过"
    else display as text "  ⚠️ weakiv / condivreg / rivtest 均未安装 (ssc install weakiv); 弱工具 AR CI 跳过"
    local ar_note "Anderson-Rubin weak-IV-robust CI NOT computed (weakiv/condivreg/rivtest unavailable, or 2SLS DV not yet merged; ssc install weakiv). If KP F < Stock-Yogo critical value, 2SLS t-inference is invalid — install weakiv and re-run for AR CI. "
}

* ── 跨族 over-id 工具相关性诊断 (GPSS 2020 AER §5: overid 须报告工具间相关性) ──
* full 轨 (type-LOO × zone-LOO) 与 ctx 轨 (type-LOO × zone-LOO) 各算一对 pairwise
* corr。合法跨族 overid 的前提是两【分组维度】近正交; |rho| 高 → Hansen J (df=1)
* 欠功效 (与被否决的 full×ctx 同文双窗同病灶, Parente-Santos Silva 2012)。缺列 → n/a。
local rho_full "n/a"
local rho_ctx  "n/a"
local rho_ss   "n/a"
capture confirm variable `IV1' `IV2'
if !_rc {
    qui correlate `IV1' `IV2'
    local rho_full : display %5.3f r(rho)
}
capture confirm variable `IVC' `IV2C'
if !_rc {
    qui correlate `IVC' `IV2C'
    local rho_ctx : display %5.3f r(rho)
}
capture confirm variable `IVS' `IV2S'
if !_rc {
    qui correlate `IVS' `IV2S'
    local rho_ss : display %5.3f r(rho)
}
display "  [over-id 工具相关性] full type-zone rho=`rho_full'  ctx type-zone rho=`rho_ctx'  ss type-zone rho=`rho_ss'"

* esttab 名单动态化 (缺估计不点名, 防 r(111) 丢整表)
qui estimates dir
local stored `r(names)'
local cand_models first_type first_zone first_ctx first_zone_ctx first_ss first_zone_ss tsls_type tsls_overid tsls_ctx tsls_overid_ctx tsls_ss tsls_overid_ss
local cand_titles `""1st Type-LOO" "1st Zone-LOO" "1st LOO ctx" "1st Zone ctx" "1st LOO ss" "1st Zone ss" "2SLS Type" "2SLS Overid" "2SLS LOO ctx" "2SLS Overid ctx" "2SLS LOO ss" "2SLS Overid ss""'
local models ""
local mtitles `""'
local nmod : word count `cand_models'
forvalues i = 1/`nmod' {
    local m : word `i' of `cand_models'
    if `: list m in stored' {
        local models `models' `m'
        local t : word `i' of `cand_titles'
        local mtitles `"`mtitles' "`t'""'
    }
}
if "`models'" == "" {
    display as error "  [WARN] IV 表无任何已存储估计 (IV 列全缺), 表跳过"
}
else {
    esttab `models' ///
        using "$tables_dir/tableA12_benefit_iv_2sls.tex", replace ///
        star(* 0.10 ** 0.05 *** 0.01) se booktabs label compress b(3) ///
        stats(N r2 widstat jp, fmt(0 3 3 3) labels("N" "R²" "KP F" "Hansen J p")) ///
        title("Table A12: Benefit-Attitude IV — Type LOO + Zone LOO (First Stage + 2SLS)") ///
        mtitles(`mtitles') ///
        addnotes("IV1 = same-bank-type leave-one-out benefit-attitude mean; IV2 = same-economic-zone (cross-province) leave-one-out mean (regional common shocks; cf. iv_did.compute_zone_leave1out)." ///
                 "Exclusion caveats for peer-mean instruments (Manski 1993; Leary-Roberts 2014 JF) must be disclosed; lag-1 variant l1o_peer_benefit_iv_lag1 (.dta short name of panel column leave_one_out_peer_benefit_iv_lag1) as robustness." ///
                 "ctx columns: entity-window twin benefit_mean_ctx instrumented by ctx peer-LOO (lpeer_benefit_iv_ctx) and ctx zone-LOO (zone_leave1out_benefit_iv_ctx); just-identified + cross-family ctx over-id, side-by-side dual-track robustness — NOT pooled with full-track IV (same-text windows make Hansen J uninformative; Parente-Santos Silva 2012)." ///
                 "ss columns: bank+fintech same-sentence twin benefit_mean_ss instrumented by ss peer-LOO (lpeer_benefit_iv_ss) and ss zone-LOO (zone_leave1out_benefit_iv_ss); just-identified + cross-family ss over-id, side-by-side tri-track robustness — full/ctx/ss are NEVER pooled into one Hansen J (same-article windows co-contaminate; Parente-Santos Silva 2012)." ///
                 "Cross-family over-id instrument correlations (GPSS 2020 AER sec.5): full type-LOO x zone-LOO rho=`rho_full'; ctx rho=`rho_ctx'; ss rho=`rho_ss'. Distinct grouping dimensions (bank_type vs bank_zone) are near-orthogonal by construction; high |rho| would render the df=1 Hansen J underpowered." ///
                 "KP F = Kleibergen-Paap rk Wald F; if < 16.38 (Stock-Yogo 2005), use Anderson-Rubin CI (Andrews-Stock-Sun 2019). Hansen J only in overidentified column." ///
                 "`ar_note'")

    display "[OK] 25_tableA12_iv_2sls → $tables_dir/tableA12_benefit_iv_2sls.tex"
}
