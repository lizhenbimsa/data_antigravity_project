* ============================================================================
* 14_table5_robustness.do — Robustness battery (benefit_society)
* Paper: {{PAPER_ID}}
*
* PAP v1.0-final §5 (R8 + R11 removed per F-R3-H1):
*   R1: P25 threshold (relaxed)
*   R2: P75 threshold (strict)
*   R3: INT track (TF-IDF×SIF weighted)
*   R4: Ctx track attitude (dual-track; full main comparison in Table A2)
*   R5: Pos/Neg fraction decomposition (now dual-track, F-H3)
* ============================================================================

version 19
clear all
set more off

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"

use "$data_dir/_prepared_panel.dta", clear

set seed {{RANDOM_SEED}}

local kw_p25 token_adopt_kw_p25 hidden_adopt_kw_p25
local kw_p75 token_adopt_kw_p75 hidden_adopt_kw_p75
local int_p50 token_adopt_int_p50 hidden_adopt_int_p50

* fix(omni-g-templates-04, 2026-06-11): R1-R3 守卫重写。旧 R1 的
* `foreach v { capture confirm; if _rc continue }` 中 continue 只跳 foreach 本轮、
* 不跳过紧随其后的回归 — 守卫是 no-op, 缺列时回归照样 r(111); R2/R3 干脆无守卫。
* 改为单次多变量 confirm (任一缺失即 _rc≠0) 包裹整块 (与 R4/R5 同模式)。
* R1: P25 threshold
capture confirm variable `kw_p25'
if !_rc {
    reghdfe {{MAIN_DV}}_w `kw_p25' $controls, ///
        absorb(bank_type year) vce(cluster {{CLUSTER_VAR}})
    eststo R1_p25
}
else {
    display "  [WARN] P25 threshold 列缺失 (`kw_p25'); R1 跳过"
}

* R2: P75 threshold
capture confirm variable `kw_p75'
if !_rc {
    reghdfe {{MAIN_DV}}_w `kw_p75' $controls, ///
        absorb(bank_type year) vce(cluster {{CLUSTER_VAR}})
    eststo R2_p75
}
else {
    display "  [WARN] P75 threshold 列缺失 (`kw_p75'); R2 跳过"
}

* R3: INT track
capture confirm variable `int_p50'
if !_rc {
    reghdfe {{MAIN_DV}}_w `int_p50' $controls, ///
        absorb(bank_type year) vce(cluster {{CLUSTER_VAR}})
    eststo R3_int
}
else {
    display "  [WARN] INT track 列缺失 (`int_p50'); R3 跳过"
}

* R4: Ctx track attitude (dual-track main comparison; full vs ctx)
capture confirm variable {{ATTITUDE_CTX}}
if !_rc {
    reghdfe {{MAIN_DV}}_w {{ATTITUDE_CTX}} $controls, ///
        absorb(bank_type year) vce(cluster {{CLUSTER_VAR}})
    eststo R4_ctx
}

* R5 (dual-track Pos/Neg fraction): full + ctx side-by-side, F-H3
capture confirm variable {{BENEFIT_POS_FRAC_FULL}} {{BENEFIT_NEG_FRAC_FULL}}
if !_rc {
    reghdfe {{MAIN_DV}}_w {{BENEFIT_POS_FRAC_FULL}} {{BENEFIT_NEG_FRAC_FULL}} $controls, ///
        absorb(bank_type year) vce(cluster {{CLUSTER_VAR}})
    eststo R5_frac_full
}
capture confirm variable {{BENEFIT_POS_FRAC_CTX}} {{BENEFIT_NEG_FRAC_CTX}}
if !_rc {
    reghdfe {{MAIN_DV}}_w {{BENEFIT_POS_FRAC_CTX}} {{BENEFIT_NEG_FRAC_CTX}} $controls, ///
        absorb(bank_type year) vce(cluster {{CLUSTER_VAR}})
    eststo R5_frac_ctx
}

* fix(omni-g-templates-04, 2026-06-11): esttab 名单动态化 — R1-R5 全部在守卫块内,
* 任一被跳过后旧版硬点名 → r(111) 整表丢失; mtitle 同步删列防错位。
qui estimates dir
local stored `r(names)'
local cand_models R1_p25 R2_p75 R3_int R4_ctx R5_frac_full R5_frac_ctx
local cand_titles `""P25" "P75" "INT" "Ctx" "Pos/Neg-Full" "Pos/Neg-Ctx""'
local models ""
local mtitles `""'
local nmod : word count `cand_models'
forvalues i = 1/`nmod' {
    local m : word `i' of `cand_models'
    if `: list m in stored' {
        local models `models' `m'
        local t : word `i' of `cand_titles'
        local mtitles `"`mtitles' "`t'""'
    }
}
if "`models'" == "" {
    display as error "  [WARN] Table 5 无任何已存储估计 (R1-R5 全被守卫跳过), 表跳过"
}
else {
    esttab `models' ///
        using "$tables_dir/table5_robustness.tex", replace ///
        star(* 0.10 ** 0.05 *** 0.01) se booktabs label compress b(3) ///
        title("Robustness Battery (PAP §5, R8/R11 removed) --- benefit_society") ///
        mtitles(`mtitles') ///
        addnotes("bank_type/year FE; SE clustered at {{CLUSTER_VAR}}." ///
                 "R8 (1y-change) + R11 (NCD spread) removed per audit F-R3-H1.")

    * fix(omni-gapfill-08, 2026-06-12): CSV side-channel — papers/benefit_society/
    * tables.py:build_table5_robustness 经 read_paper_esttab(...,
    * 'table5_robustness.csv') 消费 (parse_esttab_csv 格式; 动态 `models' 名单)。
    estout `models' using "$tables_dir/table5_robustness.csv", replace delimiter(",") ///
        cells(b(star fmt(3)) se(par fmt(3))) stats(N r2, fmt(0 3)) ///
        starlevels(* 0.10 ** 0.05 *** 0.01) mlabels(`mtitles')
}

display "[OK] Table 5 → $tables_dir/table5_robustness.tex (+ .csv side-channel)"
