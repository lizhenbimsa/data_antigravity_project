* news_process v3.7.3 — Table A8: Headline-Only Sentiment Robustness (P3 {{PAPER_ID}})
* ============================================================================
* 25_tableA8_title_robustness.do — v3.7.3 Plan A v1.0
* Paper: {{PAPER_ID}} (P3 bank_fintech_substance)
* Purpose: _title 切片轨稳健性 (W&Z 实质/象征二元 in headline).
*
* Anchor:
*   - Heston & Sinha (2017) FAJ; LM (2016) JAR §6; Boudoukh (2019) JFE
*   - Westphal & Zajac (1994 / 2001) — substantive vs symbolic action (P3 origin)
*   - Campbell & Fiske (1959) — MTMM
*
* P3 specific caveat: W&Z substantive/symbolic 二元判断在标题级 LLM
* confidence 可能 < 0.6 (stage 39g audit), 此情况下 Panel A 退化为 sentiment-only;
* 仅看 _title sentiment direction 而非 substance dimension.
* ============================================================================

version 19
clear all
set more off
set maxvar 32767
set linesize 120

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"

use "$data_dir/_prepared_panel.dta", clear
set seed {{RANDOM_SEED}}

local title_var = subinstr("{{MAIN_TREAT}}", "_ctx", "_title", .)
local title_var = subinstr("`title_var'", "_full", "_title", .)

display "  [P3] {{PAPER_ID}}: title_var = `title_var'"

capture confirm variable `title_var'
if !_rc {
    reghdfe {{MAIN_DV}} `title_var' $bank_controls, ///
        absorb(bank_id year) vce(cluster bank_id year)
    eststo m_title_only

    reghdfe {{MAIN_DV}} {{MAIN_TREAT}} `title_var' $bank_controls, ///
        absorb(bank_id year) vce(cluster bank_id year)
    eststo m_main_plus_title
    test {{MAIN_TREAT}} = `title_var'
    display "  Wald test: p = " r(p)
}
else {
    display "  [WARN] `title_var' not in panel — P3 substance 二元在标题级可能 confidence 不足"
}

capture confirm variable tone_gap_title_full
if !_rc {
    reghdfe {{MAIN_DV}} {{MAIN_TREAT}} tone_gap_title_full $bank_controls, ///
        absorb(bank_id year) vce(cluster bank_id year)
    eststo m_with_gap
}


* ---------------------------------------------------------------------------
* Panel D (v3.7.4): stratify by frac_title_mentions_fintech across 3 thresholds
* {0.3, 0.5, 0.7} — Antweiler-Frank (2004) JF 59(3) subject-relevance
* threshold sensitivity convention. Hassan et al. (2019) QJE §IV.A
* sub-window analysis. Per-cell graceful skip if N < 30.
* ---------------------------------------------------------------------------
capture confirm variable frac_title_mentions_fintech
if !_rc {
    foreach tau in 0.3 0.5 0.7 {
        local thr_str = subinstr("`tau'", ".", "p", .)
        quietly count if frac_title_mentions_fintech > `tau'
        local n_above = r(N)
        quietly count if frac_title_mentions_fintech <= `tau'
        local n_below = r(N)
        display "  Panel D τ=`tau': N above=`n_above', N below=`n_below'"
        if `n_above' >= 30 {
            reghdfe {{MAIN_DV}} {{MAIN_TREAT}} $bank_controls ///
                if frac_title_mentions_fintech > `tau', ///
                absorb(bank_id year) vce(cluster bank_id year)
            eststo m_panelD_above_`thr_str'
        }
        else {
            display "    [WARN] Panel D τ=`tau' above: N=`n_above' < 30, skip"
        }
        if `n_below' >= 30 {
            reghdfe {{MAIN_DV}} {{MAIN_TREAT}} $bank_controls ///
                if frac_title_mentions_fintech <= `tau', ///
                absorb(bank_id year) vce(cluster bank_id year)
            eststo m_panelD_below_`thr_str'
        }
        else {
            display "    [WARN] Panel D τ=`tau' below: N=`n_below' < 30, skip"
        }
    }
}
else {
    display "  [WARN] frac_title_mentions_fintech not in panel; Panel D skipped"
}

* ---------------------------------------------------------------------------
* Panel E (v3.7.4): stratify by frac_title_long (bank-year median title length)
* Anchor: Da-Engelberg-Gao (2011) JF 66(5) attention-channel separation
* (short titles → attention channel; long titles → substance channel);
* Tetlock (2007) JF 62(3) length-based information content.
* Per-cell graceful skip if N < 30.
* ---------------------------------------------------------------------------
capture confirm variable frac_title_long
if !_rc {
    quietly count if frac_title_long > 0.5
    local n_long = r(N)
    quietly count if frac_title_long <= 0.5
    local n_short = r(N)
    display "  Panel E: N long-title=`n_long', N short-title=`n_short'"
    if `n_long' >= 30 {
        reghdfe {{MAIN_DV}} {{MAIN_TREAT}} $bank_controls ///
            if frac_title_long > 0.5, ///
            absorb(bank_id year) vce(cluster bank_id year)
        eststo m_panelE_long
    }
    else {
        display "    [WARN] Panel E long: N=`n_long' < 30, skip"
    }
    if `n_short' >= 30 {
        reghdfe {{MAIN_DV}} {{MAIN_TREAT}} $bank_controls ///
            if frac_title_long <= 0.5, ///
            absorb(bank_id year) vce(cluster bank_id year)
        eststo m_panelE_short
    }
    else {
        display "    [WARN] Panel E short: N=`n_short' < 30, skip"
    }
}
else {
    display "  [WARN] frac_title_long not in panel; Panel E skipped"
}

esttab m_title_only m_main_plus_title m_with_gap ///
    using "$tables_dir/tableA8_title_robustness.tex", ///
    se star(* 0.10 ** 0.05 *** 0.01) replace ///
    mtitles("Title-only" "Main+Title" "+Gap control") ///
    title("Table A8: Headline Robustness — {{PAPER_ID}} (P3 substance)") ///
    nonotes ///
    addnote("Anchors: Heston-Sinha (2017 FAJ); LM (2016 JAR §6); W&Z (1994/2001).")

display "  [done] Table A8 written for P3"
