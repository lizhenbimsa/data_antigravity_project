* ============================================================================
* 16_substance_mechanism.do — Table 3 dual outcome (P3 bank_fintech_substance)
* Paper: {{PAPER_ID}}
* Plan: §5.5.2 P3 mechanism (R7-M03 + R11-m02)
*
*   NB: P3 用 dual outcome regression 而非 Baron-Kenny mediation.
*   Template name `16_<paper>_mechanism` 仅维持 M2 stata templates 命名一致性;
*   此文件内部实际是 dual outcome (短期 CAR + 长期 ROA 反转, 二者反向预期,
*   共同检验 W&Z 1994 实证机制).
*
*   short_run = car_3day_window_fintech_announcement (P3 spec outcome.short_run)
*   long_run  = long_run_roa_change_3yr            (P3 spec outcome.primary)
*   X         = {{MAIN_TREAT}}                     (innovation_substantiveness_full)
*
* W&Z 1994 预测:
*   - 象征性宣告 (substantiveness 低) → 短期 CAR 正反应 + 长期 ROA 反转 (negative)
*   - 实质性宣告 (substantiveness 高) → 短期反应平淡 + 长期 ROA 持续 / 正向
* ============================================================================

version 19
clear all
set more off
set maxvar 32767
set linesize 120

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"

use "$data_dir/_prepared_panel.dta", clear

set seed {{RANDOM_SEED}}

* Short-run outcome: car_3day_window_fintech_announcement ~ X
capture confirm variable car_3day_window_fintech_announcement
if !_rc {
    reghdfe car_3day_window_fintech_announcement {{MAIN_TREAT}} $controls, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    eststo short_run
}
else {
    display "  [WARN] car_3day_window_fintech_announcement not in panel (M0.5.11 enrichment pending)"
}

* Long-run outcome: long_run_roa_change_3yr ~ X (W&Z 1994 反转检验)
reghdfe {{MAIN_DV}} {{MAIN_TREAT}} $controls, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo long_run

* Joint test: SUR (seemingly unrelated regression) for cross-equation coefficient
* equality/reversal — short-run pos vs long-run neg.
capture confirm variable car_3day_window_fintech_announcement
if !_rc {
    sureg (car_3day_window_fintech_announcement {{MAIN_TREAT}} $controls) ///
          (long_run_roa_change_3yr {{MAIN_TREAT}} $controls)
    test [car_3day_window_fintech_announcement]_b[{{MAIN_TREAT}}] = ///
         -[long_run_roa_change_3yr]_b[{{MAIN_TREAT}}]
}

esttab short_run long_run using "$tables_dir/table3_dual_outcome.tex", replace ///
    star(* 0.10 ** 0.05 *** 0.01) se booktabs label compress b(3) ///
    title("Table 3 — Dual Outcome (W&Z 1994 — short-run CAR vs long-run ROA reversal)") ///
    mtitles("Short-run CAR" "Long-run ROA Δ") ///
    addnotes("W&Z 1994 prediction: symbolic substantiveness → short-run CAR + / long-run ROA −." ///
             "Joint reversal test via sureg + test (cross-equation coefficient reversal).")

display "[OK] Table 3 (dual outcome) → $tables_dir/table3_dual_outcome.tex"
