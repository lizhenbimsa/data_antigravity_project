* ============================================================================
* 01_data_prep.do — 加载 panel + xtset + 设定 globals (bank_fintech_substance / P3)
* Paper: {{PAPER_ID}}
* RR6-1: paper-specific globals + P3 双结果变量 (dual-outcome) 存在性检查
* ============================================================================

version 19
clear all
set more off

if "$data_dir" == ""  global data_dir "../data"
if "$panel_dta" == "" global panel_dta "$data_dir/40_panel_yearly.dta"

use "$panel_dta", clear

capture confirm variable bank_id
if _rc encode target_bank, gen(bank_id)
xtset bank_id year

* fix(omni-g-replication-01, 2026-06-11): 财务控制 (ln_assets 族) 为外部数据 sentinel
* (config/银行面板2007-2025年.xlsx 待接入) — 逐个 capture confirm 自校验, 只把面板中
* 实际存在的列拼入 $controls, 防下游 reghdfe `$controls` r(111) 硬崩 (主线 01_data_prep 同模式)。
local _ctrl ""
local _ctrl_missing ""
foreach v in {{CONTROLS}} {
    capture confirm variable `v'
    if !_rc local _ctrl "`_ctrl' `v'"
    else    local _ctrl_missing "`_ctrl_missing' `v'"
}
global controls "`_ctrl'"
if "`_ctrl_missing'" != "" {
    display as error "[WARN] controls 缺失:`_ctrl_missing' — 外部银行财务面板待接入 (config/银行面板2007-2025年.xlsx); 回归仅用现存 controls [$controls]"
}
* $bank_controls 保留为 $controls 的兼容性 alias (部分 robustness 模板引用)
global bank_controls "$controls"

* fix(omni-g-replication-04, 2026-06-11): treatment 改用 panel 真实聚合列。
* 原 foreach 要求 article-level 列 innovation_substantiveness_full — 该列只在
* stage 21 文章级输出, stage 45 聚合进 bank-year panel 的真名是 sub_frac (实质性
* 文章占比, = 新 MAIN_TREAT) / symb_frac (象征性占比) → 旧检查必 exit 198,
* 复现包零表产出 (R35-M02 locus 同 bug, 此处把已验证的修法传播到 P3)。
* P3 required variables: 实质性/象征性 panel 聚合占比 (treatment = {{MAIN_TREAT}})
foreach v in sub_frac symb_frac {
    capture confirm variable `v'
    if _rc {
        display as error "[ERROR] required P3 variable `v' missing — run stage 21 (tone_llms) substantiveness classification + stage 45 panel aggregation first"
        exit 198
    }
}

* P3 outcome (外部财务数据 sentinel, 与 treatment 分开诊断)
capture confirm variable {{MAIN_DV}}
if _rc {
    display as error "[ERROR] required P3 outcome {{MAIN_DV}} missing — 外部财务数据未接入 (M0.5.11 CSMAR 年报 ROA; 见 config/银行面板2007-2025年.xlsx 接入计划与 spec.outcome.enrichment_source)"
    exit 198
}

* fix(omni-g-replication-04): derive spec.treatment.alternative 连续 gap
* (substantive_minus_symbolic_gap = sub_frac - symb_frac ∈ [-1, +1], 与
* paper_spec.yaml alternative_construction 同步; 缺失守卫排除无 LLM 分类的 bank-year)。
capture drop substantive_minus_symbolic_gap
gen substantive_minus_symbolic_gap = sub_frac - symb_frac if !missing(sub_frac, symb_frac)

* 短期 outcome 可选检查 (按 spec.outcome.short_run; 外部财务数据接入前可能全为 NaN)
* fix(omni-g-templates-06, 2026-06-11): 旧 36 字符名超 Stata 32 字符硬限 (r(198)
* invalid name, confirm 永假) → 全链改 27 字符短名 car_3day_window_ft_announce。
capture confirm variable car_3day_window_ft_announce
if _rc display "  [WARN] car_3day_window_ft_announce not in panel; dual-outcome (Table 3) will be skipped"

capture which winsor2
if !_rc winsor2 {{MAIN_DV}}, cuts(1 99) suffix(_w)
else gen {{MAIN_DV}}_w = {{MAIN_DV}}

save "$data_dir/_prepared_panel.dta", replace
display "[OK] P3 data prep N=" _N
