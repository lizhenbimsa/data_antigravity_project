* ============================================================================
* 18_substance_robustness.do — Table 5 进阶稳健性 (P3 bank_fintech_substance)
* Paper: {{PAPER_ID}}
* Plan: §5.9.2 + R6-M02 — 7 通用维度 + paper-specific alternative substantiveness track
* ============================================================================

version 19
clear all
set more off
set maxvar 32767
set linesize 120

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"

use "$data_dir/_prepared_panel.dta", clear

set seed {{RANDOM_SEED}}

* (1) Oster (2019) δ
* 白话: 估算"看不见的遗漏变量要比已控制变量强多少倍才能把结论翻盘"的界值。
* psacalc delta {{MAIN_TREAT}}, rmax(1.3 r²) mcontrol($controls)

* (2) rwolf 多重假设校正 (Romano-Wolf 2005 ECMA; List-Shaikh-Xu 2019)
* 白话: 一次检验很多个假设时总会有几个"碰巧显著", rwolf 把 p 值整体调严防误报。
* INFER IV-1 修复 (2026-06-14): 把 claimed-but-never-run 的 rwolf 从注释转活跃。
* 测度农场族 (主 sub_frac + ctx 孪生 sub_frac_sc + sub-symb gap) 同时检验同一
* 机制的多个测度, 跨这族做 Romano-Wolf step-down FWER 校正, 把校正后 p 写进表。
* 全程 capture 守卫: rwolf 未装 / DV sentinel 缺 / T=2 退化时优雅跳过, 不丢表。
* 学术依据: Romano & Wolf 2005 ECMA; Clarke, Romano & Wolf 2020 (rwolf, Stata Journal 20(4):812-843); Anderson 2008 JASA。
local rw_p_main = .
local rw_p_ctx  = .
local rw_p_gap  = .
capture which rwolf
if _rc {
    display "  ⚠️ rwolf not installed (ssc install rwolf); Romano-Wolf FWER 校正跳过 (无校正 p)"
}
else {
    * rwolf 把 family 内每个 indepvar 各自单独回归后联合 step-down; 动态拼装实质性
    * 测度族 (主 sub_frac + ctx 孪生 sub_frac_sc + sub-symb gap), 仅纳入在盘的测度。
    capture confirm variable {{MAIN_DV}}
    if !_rc {
        local rw_treats {{MAIN_TREAT}}
        capture confirm variable sub_frac_sc
        if !_rc local rw_treats `rw_treats' sub_frac_sc
        * gap 列在 (8) 块才派生 → 此处即时派生临时列 _rw_gap 纳入 family
        capture confirm variable sub_frac symb_frac
        if !_rc {
            capture drop _rw_gap
            gen double _rw_gap = sub_frac - symb_frac
            local rw_treats `rw_treats' _rw_gap
        }
        capture noisily rwolf {{MAIN_DV}}, indepvar(`rw_treats') controls($controls) ///
            reps(1000) seed({{RANDOM_SEED}}) ///
            method(reghdfe) abs(bank_id year) cluster({{CLUSTER_VAR}})
        if _rc {
            display "  ⚠️ rwolf 执行失败 (rc=`=_rc'; 多为 T=2 退化/单测度); FWER 校正 p 缺失"
        }
        else {
            * D4-rwolf-ename 修复 (2026-06-16): 旧版逐个取 e(rw_<indepvar>) 系统性取空。
            * 根因 (亲读本机 rwolf.ado:494-571 + Stata /b 实证): rwolf 在【多 indepvar】
            * (nivars>1, 本族恒 2-3 个) 下的 ereturn 名约定 ≠ 单 indepvar:
            *   · 标量 = e(rw_<depvar>_<indepvar>) (ado:518)  ← NOT e(rw_<indepvar>)
            *   · 矩阵 = e(RW_<indepvar>) (ado:570), 维度 [n_outcome × 3], 第 3 列 = RW p
            * 旧名 e(rw_{{MAIN_TREAT}}) / e(rw_sub_frac_sc) / e(rw__rw_gap) 是【单 indepvar】
            * 约定 (e(rw_<depvar>)), 多 indepvar 下根本不存在 → 静读为 . (rc=0, 无报错), 故
            * Romano-Wolf p 行恒空。⚠ 本篇 {{MAIN_DV}}=cost_income_ratio_change_3yr (28 字符)
            * → 正确多元标量名 e(rw_<dv>_<treat>) 实长 ≥ 33 字符, 撞 Stata 32 字符名上限
            * (实测 r(198)/r(152), 读不出) → 标量轨对本篇不可用, 必须走【矩阵】轨取 [1,3]。
            * 取数策略 (镜像 attention/18 两层回退; 全 capture 守卫, 缺列优雅留 . 不丢表):
            *   ① 多 indepvar 矩阵 e(RW_<iv>)[1,3] (主路, 名长安全) →
            *   ② 单 indepvar 退化时 (family 只剩 {{MAIN_TREAT}}) 回退 e(RW)[1,3] →
            *   ③ 标量 e(rw_<dv>_<iv>) 兜底 (短名才读得出, 长名静默跳过) →
            *   ④ 仍取不到则 display [WARN] 并保持 . (不阻断后续表格)。
            * 学术不变量: 与 _full/_ctx 各自 just-ID 并排无关 — 这是 FWER 校正 p, 非 IV。
            tempname _rwm
            * --- 主测度 {{MAIN_TREAT}} ---
            capture matrix `_rwm' = e(RW_{{MAIN_TREAT}})
            if !_rc & rowsof(`_rwm') >= 1 & colsof(`_rwm') >= 3 {
                local rw_p_main = `_rwm'[1,3]
            }
            else {
                * 退化: family 仅单 indepvar → rwolf 存 e(RW) (无 _<iv> 后缀)
                capture matrix `_rwm' = e(RW)
                if !_rc & rowsof(`_rwm') >= 1 & colsof(`_rwm') >= 3 ///
                    local rw_p_main = `_rwm'[1,3]
                else capture local rw_p_main = e(rw_{{MAIN_DV}}_{{MAIN_TREAT}})
            }
            if missing(`rw_p_main') display ///
                "  [WARN] Romano-Wolf p({{MAIN_TREAT}}) 取不到 (e(RW_{{MAIN_TREAT}})/e(RW)/标量均缺); 该行留空"
            * --- ctx 孪生 sub_frac_sc (仅当它进了 family) ---
            capture matrix `_rwm' = e(RW_sub_frac_sc)
            if !_rc & rowsof(`_rwm') >= 1 & colsof(`_rwm') >= 3 {
                local rw_p_ctx = `_rwm'[1,3]
            }
            else capture local rw_p_ctx = e(rw_{{MAIN_DV}}_sub_frac_sc)
            * --- gap 临时列 _rw_gap (仅当它进了 family) ---
            capture matrix `_rwm' = e(RW__rw_gap)
            if !_rc & rowsof(`_rwm') >= 1 & colsof(`_rwm') >= 3 {
                local rw_p_gap = `_rwm'[1,3]
            }
            else capture local rw_p_gap = e(rw_{{MAIN_DV}}__rw_gap)
        }
        capture drop _rw_gap
    }
    else {
        display "  ⚠️ {{MAIN_DV}} 不在面板 (外部财务 sentinel); rwolf FWER 校正跳过"
    }
}

* (3) Honest DiD — NOT APPLICABLE 到本论文 (DID-3 裁决, PROJECT_REAUDIT 2026-06-14)
* 白话: HonestDiD (Rambachan-Roth 2023) 是针对"事件研究/DiD 平行趋势可能不完美"的
*       敏感性工具; 它需要事件时间 lead/lag 系数 (pre-period 趋势) 才能松弛平行趋势假设。
* 本论文主规格 = within-bank within-year 双固定效应连续暴露面板 (sub_frac → CIR),
*   不是事件研究/DiD, 没有 event-time lead/lag → HonestDiD 在此结构上不可定义, 刻意不接线。
*   平行趋势/pre-trend 敏感性属于事件研究伴侣表 (E1-E5, 见 locus/19 式 INLINE intensity-DiD);
*   本论文若未来加事件研究列, HonestDiD 应接到那张表而非本稳健性表。
* 学术依据: Rambachan & Roth 2023 RES (适用前提=事件研究 pre-period 系数)。

* (4) Wild cluster bootstrap (野聚类自助法)
* 白话: 聚类个数少时常规聚类标准误会偏小, wild bootstrap 用重抽样把 p 值算得更可信。
* fix(omni-g-templates-10, 2026-06-11): (i) boottest 补 capture which 守卫 (对齐
* collab/18; 未装机器上旧版裸调 r(199) 致本表整丢); (ii) boottest 按设计不改写
* e(b)/e(V) (wild p 在 r(p)), 旧 eststo 存的是 reghdfe 解析 cluster SE → "Wild boot"
* 列名实不符。现以 estadd 把 r(p) 注入 e(p_wild) 进表 stats 行, 缺 boottest 时如实告警。
* wild_boot 列展示的是 headline 双向 FE 规格 (bank+year FE), 与主表口径一致。
reghdfe {{MAIN_DV}} {{MAIN_TREAT}} $controls, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
local p_wild = .
capture which boottest
if !_rc {
    * fix(reaudit-t18-2026-06-14): boottest 在【两套及以上 absorb FE 的 reghdfe 后】
    *   直接报 "Doesn't work after reghdfe with more than one set of absorbed fixed
    *   effects" 并空手返回 r(p)=. (本机 StataNow 19.5 实测; rc=0 但 r(p) 永缺) →
    *   p_wild 行即便 boottest 已装也恒为空 (claimed-but-not-run)。改用 boottest 支持
    *   的单 absorb 承载回归 (absorb(bank_id) + i.year 显式哑变量, 与双向 FE 同识别)
    *   仅为算 wild p, 算完把 r(p) estadd 回写到上面的双向 FE wild_boot 估计 (表列不变)。
    capture noisily reghdfe {{MAIN_DV}} {{MAIN_TREAT}} $controls i.year, ///
        absorb(bank_id) vce(cluster {{CLUSTER_VAR}})
    if !_rc {
        capture noisily boottest {{MAIN_TREAT}}, reps(9999) seed({{RANDOM_SEED}}) nograph
        if !_rc & !missing(r(p)) local p_wild = r(p)
    }
    * 回到双向 FE 规格作展示列承载 (estadd 须挂在它上面)
    reghdfe {{MAIN_DV}} {{MAIN_TREAT}} $controls, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    if missing(`p_wild') display "  ⚠️ boottest 已装但 wild p 未算出 (退化/承载回归失败); p_wild 缺"
    else                 display "  [OK] wild-cluster bootstrap p({{MAIN_TREAT}}) = `p_wild' (boottest, single-absorb carrier)"
}
else {
    display "  ⚠️ boottest not installed (ssc install boottest); wild_boot 列仅含解析 cluster SE, wild p 缺失"
}
capture estadd scalar p_wild = `p_wild'
* INFER IV-1: 把主测度的 Romano-Wolf FWER 校正 p 注入 wild_boot 列 stats 行 (缺则 .)
capture estadd scalar rw_p = `rw_p_main'
eststo wild_boot

* (5) ritest 随机化推断 (randomization inference; Young 2019 QJE; MacKinnon-Webb 2020 Journal of Econometrics)
* v3.6.1 PR #7 启用; SSC 自动检测, 装不上则跳过 (G-C2.0 准入门控由 v2.3).
* 白话: 把"谁受处理"随机打乱上千次重新跑回归, 看真实系数是否明显超出乱排出来的分布。
capture which ritest
if _rc != 0 {
    capture ssc install ritest, replace
}
capture which ritest
if _rc == 0 {
    ritest {{MAIN_TREAT}} _b[{{MAIN_TREAT}}], reps(1000) seed({{RANDOM_SEED}}) ///
        cluster(bank_id) strata(year): ///
        reghdfe {{MAIN_DV}} {{MAIN_TREAT}} $controls, ///
            absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    eststo ritest_ri
}
else {
    display "  ⚠️ ritest not installed (ssc install ritest); randomization inference 跳过"
}

* (6) 溢出效应 SUTVA 检验
* (paper-specific: 银行 fintech 宣告经共现 network 的溢出)

* (7) 样本切除 — 剔除国有 6 大行 / 剔除农商行 / 剔除 pre_period
* st-did-05 fix (2026-06-03): bank_type 是字符串列 (str), 由 iv_did.py::load_bank_group_maps()
* 产出 'soe'/'joint'/'city'/'rural'/'private'/'foreign'/'other' (NFRA_TO_SHORT 映射,
* 见 runner.py:857 `is_soe = (panel['bank_type'] == 'soe')`). 旧 `if bank_type != 1`
* / `!= 4` 用数值与字符串列比较, StataNow 19.5 触发 r(109) type mismatch. 改为字符串
* 比较: excl 国有 6 = != "soe", excl 农商行 = != "rural" (对齐 attention/18:94 已修写法).
reghdfe {{MAIN_DV}} {{MAIN_TREAT}} $controls if bank_type != "soe", ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo excl_soe6
reghdfe {{MAIN_DV}} {{MAIN_TREAT}} $controls if bank_type != "rural", ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo excl_rural
reghdfe {{MAIN_DV}} {{MAIN_TREAT}} $controls if year >= 2013, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo excl_pre

* ============================================================================
* (8) Paper-specific: 替代实质性度量轨 (ctx 轨 + gap 差值)
* ============================================================================
* fix(omni-g-templates-09, 2026-06-11): 旧 foreach 引用幻影列
* innovation_substantiveness_ctx / substantive_minus_symbolic_gap (panel 上从未派生,
* 守卫永假) → "(8) alternative substantiveness track" 双轨稳健性永久静默跳过。
* panel 上 ctx 轨真名是 sub_frac_sc / symb_frac_sc (stage 45 聚合, 实测在产);
* gap 由真实列现场派生 (full 轨裸名 sub_frac/symb_frac, ctx 轨 _sc 后缀)。
capture confirm variable sub_frac_sc
if !_rc {
    reghdfe {{MAIN_DV}} sub_frac_sc $controls, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    * INFER IV-1: ctx 测度的 Romano-Wolf 校正 p (缺则 .)
    capture estadd scalar rw_p = `rw_p_ctx'
    eststo alt_ctx_track
}
capture confirm variable sub_frac symb_frac
if !_rc {
    gen sub_symb_gap_full = sub_frac - symb_frac
    reghdfe {{MAIN_DV}} sub_symb_gap_full $controls, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    * INFER IV-1: gap 测度的 Romano-Wolf 校正 p (缺则 .)
    capture estadd scalar rw_p = `rw_p_gap'
    eststo alt_gap_full
}
capture confirm variable sub_frac_sc symb_frac_sc
if !_rc {
    gen sub_symb_gap_ctx = sub_frac_sc - symb_frac_sc
    reghdfe {{MAIN_DV}} sub_symb_gap_ctx $controls, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    eststo alt_gap_ctx
}

* === Winsorization sensitivity (主回归用 raw DV: cost_income_ratio_change_3yr 为 3yr 差分 outcome, JF/JFE 惯例下差分/log/计数 outcome 主回归不缩尾; 缩尾仅作稳健性, 故与 cohort-A levels-ratio _w 基准口径不同) ===
reghdfe {{MAIN_DV}}_w {{MAIN_TREAT}} $controls, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo wsens_w1
reghdfe {{MAIN_DV}}_w5 {{MAIN_TREAT}} $controls, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo wsens_w5

* fix(omni-g-templates-07, 2026-06-11): esttab 名单动态化 — alt_* 通配可能空匹配,
* 旧版硬点名缺名即 r(111) 丢整表
* 2026-06-13: 缩尾敏感性 wsens_w1/wsens_w5 加入白名单 (否则新列静默不进表, MF9)
qui estimates dir
local stored `r(names)'
local models ""
foreach m of local stored {
    if inlist("`m'", "wild_boot", "excl_soe6", "excl_rural", "excl_pre", "wsens_w1", "wsens_w5") | strmatch("`m'", "alt_*") {
        local models `models' `m'
    }
}
esttab `models' using "$tables_dir/table5_robustness.tex", replace ///
    star(* 0.10 ** 0.05 *** 0.01) se booktabs label compress b(3) ///
    stats(N r2 p_wild rw_p, fmt(0 3 3 3) ///
          labels("N" "R²" "Wild cluster bootstrap p" "Romano-Wolf FWER p")) ///
    title("Table 5 — Advanced Robustness (P3 substance)") ///
    addnotes("Column 1 (wild_boot): analytic cluster SE shown; wild cluster bootstrap p (boottest, 9999 reps) reported in the p\_wild row." ///
             "Romano-Wolf FWER p (rw\_p row): step-down familywise-error-corrected p across the substantiveness measure family {sub\_frac, sub\_frac\_sc, sub-symb gap}, 1000 reps (Romano-Wolf 2005 ECMA; Anderson 2008 JASA). Blank when rwolf is unavailable or the cell degenerates (T=2)." ///
             "Alternative substantiveness track: sub_frac_sc (ctx) + sub-symb gap (full/ctx), derived from panel-real columns." ///
             "Honest DiD: see note below — substance baseline is a within-bank within-year FE panel (no event-time leads/lags), so Rambachan-Roth (2023) HonestDiD is not applicable here; pre-trend sensitivity belongs to the event-study companion (locus/19).")

* fix(omni-g-esttab-csv, 2026-06-11): CSV side-channel — tables.py:build_table5_robustness
* 经 read_paper_esttab(...,'table5_robustness.csv') 消费 (parse_esttab_csv 格式)
estout `models' using "$tables_dir/table5_robustness.csv", replace delimiter(",") ///
    cells(b(star fmt(3)) se(par fmt(3))) stats(N r2 p_wild rw_p, fmt(0 3 3 3)) ///
    starlevels(* 0.10 ** 0.05 *** 0.01)

display "[OK] Table 5 (robustness) → $tables_dir/table5_robustness.tex (+ .csv side-channel)"
