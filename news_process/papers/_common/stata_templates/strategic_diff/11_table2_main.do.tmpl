* ============================================================================
* 11_table2_main.do — 主回归 (strategic_diff)
* Paper: {{PAPER_ID}}
*
* Hoberg & Phillips (2016, JPE Table 3): 基于文本的产品差异化。
* Guzman & Li (2023, MS): 创业初始战略差异化。
*
* M1: 仅 strat_diff_n5
* M2: + fluidity (Hoberg-Phillips-Prabhala 2014 JF)
* M3: + sim_max + fluidity (完整规格)
* M4: + tone 交互项 (本项目 tone × diff 假设)
* M5: + coherence (text_coherence 伴随度量)
* ============================================================================

version 19
clear all
set more off

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"

use "$data_dir/_prepared_panel.dta", clear

reghdfe {{MAIN_DV}}_w {{MAIN_DIFF_VAR}} $controls, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo M1

reghdfe {{MAIN_DV}}_w {{MAIN_DIFF_VAR}} {{FLUIDITY_VAR}} $controls, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo M2

reghdfe {{MAIN_DV}}_w {{MAIN_DIFF_VAR}} {{SIM_MAX_VAR}} {{FLUIDITY_VAR}} $controls, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo M3

gen tone_x_diff = {{TONE_VAR}} * {{MAIN_DIFF_VAR}}
reghdfe {{MAIN_DV}}_w {{TONE_VAR}} {{MAIN_DIFF_VAR}} tone_x_diff $controls, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo M4

reghdfe {{MAIN_DV}}_w {{MAIN_DIFF_VAR}} {{COHERENCE_VAR}} $controls, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo M5

esttab M1 M2 M3 M4 M5 using "$tables_dir/table2_main.tex", replace ///
    star(* 0.10 ** 0.05 *** 0.01) se booktabs label compress b(3) ///
    title("Main Results --- strategic_diff") ///
    mtitles("Base" "+Fluid" "+Sim" "+Tone-Int" "+Coh") ///
    addnotes("Bank/year FE; SE clustered at {{CLUSTER_VAR}}.")

display "[OK] Table 2 → $tables_dir/table2_main.tex"
