* ============================================================================
* 00_master.do — strategic_diff 复现包编排主脚本 (replication orchestrator)
* Paper: {{PAPER_ID}}  (Guzman-Li 2023 + Hoberg-Phillips 2016)
* ============================================================================

version 19
clear all
set more off

if "$repl_root" == "" {
    global repl_root ".."
}
global data_dir   "$repl_root/data"
global out_dir    "$repl_root/output"
global tables_dir "$out_dir/tables"
global figures_dir "$out_dir/figures"
capture mkdir "$out_dir"
capture mkdir "$tables_dir"
capture mkdir "$figures_dir"

* fix(omni-g-replication-01, 2026-06-11): 01_data_prep 失败时 fail-loud 带可读原因
* (常见原因: 外部财务列未接入 — ROA/CAR/ln_assets 族, 见 config/银行面板2007-2025年.xlsx
* 接入计划与 paper_spec.yaml enrichment_source), 而非裸 r(198) 中断。
capture noisily do 01_data_prep.do
local _prep_rc = _rc
if `_prep_rc' {
    display as error "[FATAL] 01_data_prep.do failed (rc=`_prep_rc') — 复现包中止; 详见上方 [ERROR] 行 (多为外部财务数据未接入)"
    exit `_prep_rc'
}
do 10_table1_descriptives.do
do 11_table2_main.do
do 12_table3_mechanism.do
do 13_table4_heterogeneity.do
do 14_table5_robustness.do
* agg-toptier-audit 2026-06-13: 推断(双向cluster/boottest)+覆盖筛选 wire-ahead 桩 (财务接入后激活)
do 15_table6_agg_robustness.do
* 2026-06-14 顶刊稳健性扩充: FE 饱和/离群稳健估计/Oster δ (Table 7) / Hub·规模·类型子样本 (Table 8)
capture noisily do 16_table7_fe_robustness.do
if _rc display as error "[WARN] 16_table7_fe_robustness.do failed (rc=`=_rc'); Table 7 skipped"
capture noisily do 17_table8_subsample.do
if _rc display as error "[WARN] 17_table8_subsample.do failed (rc=`=_rc'); Table 8 skipped"
do 30_figure1_n_sensitivity.do

display "[OK] strategic_diff master.do complete"
