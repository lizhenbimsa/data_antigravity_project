* ============================================================================
* 01_data_prep.do — 数据准备 (strategic_diff)
* Paper: {{PAPER_ID}}
* ============================================================================

version 19
clear all
set more off

if "$data_dir" == ""  global data_dir "../data"
if "$panel_dta" == "" global panel_dta "$data_dir/40_panel_yearly.dta"

use "$panel_dta", clear
encode target_bank, gen(bank_id)
xtset bank_id year

global controls "{{CONTROLS}}"
* $bank_controls 保留为 $controls 的兼容性 alias (跨篇共享 boilerplate; strategic_diff 本篇原引用它的 25_tableA8_title 模板已删, 现为无害 dead alias)
global bank_controls "$controls"

* Pipeline 产出的必需变量 (stage 21/24/45 产出)
foreach v in {{MAIN_DIFF_VAR}} {{FLUIDITY_VAR}} {{SIM_MAX_VAR}} {{TONE_VAR}} {{BARTIK_IV}} {
    capture confirm variable `v'
    if _rc {
        display as error "[ERROR] required variable `v' missing — run stage 21 (tone_llms) + 24 (strategic similarity) + 45 (panel) first"
        exit 198
    }
}

* fix(omni-g-replication-01, 2026-06-11): MAIN_DV ({{MAIN_DV}}) 是外部财务列 sentinel
* (bank-year panel 无 tobin_q / roa 等财务列; 2026-06-13 outcome 重定位后 MAIN_DV =
* tobin_q 特许权价值, 哨兵机制不变); 缺失时给出明确指引而非裸 "missing" (00_master fail-loud)。
capture confirm variable {{MAIN_DV}}
if _rc {
    display as error "[ERROR] required outcome {{MAIN_DV}} missing — 外部银行财务面板未接入 (config/银行面板2007-2025年.xlsx 待接入)"
    exit 198
}

capture which winsor2
if !_rc winsor2 {{MAIN_DV}}, cuts(1 99) suffix(_w)
else gen {{MAIN_DV}}_w = {{MAIN_DV}}

save "$data_dir/_prepared_panel.dta", replace
display "[OK] data prep N=" _N
