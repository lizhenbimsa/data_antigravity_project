* --- OLS 对照 (用 estout 同表呈现) ---
eststo OLS: reghdfe `DV' `LOCUS' digital_frontier, absorb(bank_id year) vce(cluster bank_id)

* ============================================================================
* IV-3 Rotemberg 权重诊断 (GPSS 2020 AER §5 入场费)
* ----------------------------------------------------------------------------
* 落实 "声称走 GPSS 路线却不交 §5 入场费" 的整改: Bartik IV 的识别力来自基期
* share 的 Rotemberg 权重 α_k = Cov(share_k, BIV)/Var(BIV); 报告 (i) 各维度权重
* (ii) HHI 集中度 (iii) 负权重个数 (排他性约束违背提示) (iv) 对最高权重 share
* 跑 pre-period (基期前) placebo, 验证高权重 share 不预提示后期 outcome。
*
* 双路: ① 优先官方 bartik_weight ado (capture which 守卫); ② 缺 ado 时回退本表
* 内联 OLS 近似 (镜像 iv_did.py::diagnose_rotemberg_weights 同口径)。基期 share
* 列 bartik_<prefix>_share_* 已物化在面板 → 真实可算 (非占位)。
* T=2 退化 / share 列缺失时 capture 守卫优雅跳过。
* ============================================================================
* 选用与主 IV 同轨的 group_prefix: full→fintech_lf, ctx→fintech_lc
if "{{MAIN_SENT_TRACK}}" == "full" {
    local ROT_PREFIX fintech_lf
}
else {
    local ROT_PREFIX fintech_lc
}
local ROT_IV bartik_`ROT_PREFIX'_iv_{{MAIN_SENT_TRACK}}
capture confirm variable `ROT_IV'
if !_rc {
    * 收集已物化的基期 share 维度列
    capture ds bartik_`ROT_PREFIX'_share_*
    local share_cols `r(varlist)'
    if "`share_cols'" != "" {
        display ""
        display as text "── IV-3 Rotemberg 权重诊断 [`ROT_PREFIX'] (GPSS 2020 AER §5) ──"

        * ① 官方 GPSS bartik_weight ado 适用性说明 (方法学披露, 非缺陷):
        *    官方 bartik_weight (paulgp/bartik-weight, code/bartik_weight.ado) 的
        *    weightstub() 假设 national shift —— 每个 category 的 shift g_k 在所有
        *    单元间【不随单元变化】(collapse (first) weightstub), 对应 GPSS 2020 SSIV
        *    典范横截面布局。本项目是 bank-year LOO-Bartik: shift_{g,t}^{LOO(i)} 对每
        *    家银行【留一】各不相同 (iv_extensions.compute_bartik_shift_iv), 违反
        *    national-shift 假设, 且逐 category national-shift 列未物化在面板 (shift 已
        *    折进 IV)。故【刻意不】调用官方 ado (强行调用语义错误); 改报下方对本 LOO
        *    设计【正确】的 Rotemberg 投影权重 (GPSS 2020 §5 α_k 定义 / Borusyak-Hull-
        *    Jaravel 2022 REStud 投影等价)。
        capture which bartik_weight
        if !_rc {
            display as text "  (note: 官方 bartik_weight 已装, 但其 national-shift 假设不适配本 LOO-Bartik 设计 → 用设计正确的投影权重, 见下)"
        }

        * ② Rotemberg 投影权重 α_k = Cov(share_k, BIV)/Var(BIV) (GPSS 2020 §5 / BHJ 2022;
        *    本 LOO 设计的正确口径, 镜像 iv_did.py::diagnose_rotemberg_weights)
        quietly summarize `ROT_IV'
        local var_biv = r(Var)
        if `var_biv' > 0 & !missing(`var_biv') {
            local n_neg = 0
            local n_dim = 0
            local sum_abs = 0
            local maxabs = 0
            local max_share ""
            * 第一遍: 算权重 + 找绝对值最大的 share (top-weight, 供 placebo)
            * 注: correlate ..., covariance 把协方差矩阵存入 r(C); el(r(C),2,1) 取 Cov(share,BIV)。
            foreach sc of local share_cols {
                quietly correlate `sc' `ROT_IV', covariance
                local cov_k = el(r(C), 2, 1)
                if !missing(`cov_k') {
                    local alpha_k = `cov_k' / `var_biv'
                    local n_dim = `n_dim' + 1
                    local aabs = abs(`alpha_k')
                    local sum_abs = `sum_abs' + `aabs'
                    if `alpha_k' < 0 local n_neg = `n_neg' + 1
                    display as text "    `sc': alpha = " %9.6f `alpha_k'
                    if `aabs' > `maxabs' {
                        local maxabs = `aabs'
                        local max_share `sc'
                    }
                }
            }
            * 第二遍: HHI(|alpha|)
            local hhi = 0
            if `sum_abs' > 0 {
                foreach sc of local share_cols {
                    quietly correlate `sc' `ROT_IV', covariance
                    local cov_k = el(r(C), 2, 1)
                    if !missing(`cov_k') {
                        local alpha_k = `cov_k' / `var_biv'
                        local w = abs(`alpha_k') / `sum_abs'
                        local hhi = `hhi' + `w' * `w'
                    }
                }
            }
            display as text "    诊断: 维度数=`n_dim'  负权重=`n_neg'  HHI(|alpha|)=" %6.4f `hhi'
            if `n_neg' > 0 {
                display as text "    ⚠️ 负权重维度提示可能的排他性约束违背 (GPSS 2020 §5.2); 论文须报移除负权重后的稳健估计"
            }

            * ③ 对最高权重 share 跑 pre-period placebo: 高权重基期 share 不应预提示
            *    后期 outcome (基期 share 外生性的可证伪检验)。基期前年份子样本上回归
            *    DV ~ top-weight-share; 显著则警示该 share 的外生性。T<3 时优雅跳过。
            if "`max_share'" != "" {
                quietly summarize year
                local _ymin = r(min)
                * 取最早一年为 "基期前" 代理 (T=2 盘只有 2017-2018 → 优雅退化跳过)
                quietly count if year == `_ymin' & !missing(`DV') & !missing(`max_share')
                if r(N) > 10 {
                    display as text "  ── Top-weight share `max_share' pre-period placebo (year==`_ymin') ──"
                    capture noisily reghdfe `DV' `max_share' if year == `_ymin', noabsorb vce(cluster bank_id)
                    if !_rc {
                        display as text "    (该 share 在基期前对 DV 显著则警示其外生性; 见上方系数)"
                    }
                }
                else {
                    display as text "  ⚠️ 基期前样本过少 (N<=10, T=2 试跑盘正常), top-weight placebo 跳过 (全量 T=18 激活)"
                }
            }
        }
        else {
            display as text "  ⚠️ `ROT_IV' 方差为 0 (T=2 退化), Rotemberg 近似跳过"
        }
    }
    else {
        display as text "  ⚠️ bartik_`ROT_PREFIX'_share_* 基期 share 列未物化, Rotemberg 诊断跳过"
    }
}
else {
    display as text "  ⚠️ `ROT_IV' 不在面板, Rotemberg 权重诊断跳过 (GPSS §5 入场费待 share 列落盘)"
}

* 输出 + 报 KP F (恰好识别, 不报 Hansen J; 见顶部 st-bartik-iv fix 说明)
* fix(omni-g-templates-17, 2026-06-11): esttab 名单动态化 (IV_LF/IV_LC 被 confirm
* 守卫跳过时旧版硬点名 r(111) 丢整表); 脚注披露 IV 列 FE 规格 (含回退不对称情形)。
if `has_ivreghdfe' {
    local fe_note "IV columns: TWFE absorbed (bank + year FE via ivreghdfe), same specification as the OLS column."
}
else {
    local fe_note "CAUTION: ivreghdfe unavailable — IV columns estimated WITHOUT fixed effects (ivreg2 fallback), NOT comparable to the TWFE OLS column."
}
qui estimates dir
local stored `r(names)'
local cand_models OLS IV_LF IV_LC
local cand_titles `""OLS" "IV: locus full share" "IV: locus ctx share""'
local models ""
local mtitles `""'
local nmod : word count `cand_models'
forvalues i = 1/`nmod' {
    local m : word `i' of `cand_models'
    if `: list m in stored' {
        local models `models' `m'
        local t : word `i' of `cand_titles'
        local mtitles `"`mtitles' "`t'""'
    }
}
esttab `models' using "output/tables/tableA3_bartik_iv.tex", ///
    se star(* 0.10 ** 0.05 *** 0.01) ///
    booktabs replace fragment ///
    stats(N r2 widstat, ///
          fmt(0 3 3) ///
          labels("N" "R²" "KP F")) ///
    title("Table A3: Bartik IV — Locus Share Switch (lf vs lc)") ///
    mtitles(`mtitles') ///
    note("Bartik IV (Goldsmith-Pinkham et al. 2020 AER). " ///
         "`fe_note' " ///
         "KP F: Kleibergen-Paap rk Wald F (weak-ID test, threshold 10). " ///
         "Just-identified (1 endogenous = 1 instrument): Hansen J overid test not computable (df=0), not reported. " ///
         "If first-stage KP F < 10, instrument is weak; interpret 2SLS with Anderson-Rubin weak-IV-robust CI (weakiv). " ///
         "Rotemberg weight diagnostics (per-share alpha_k = Cov(share_k, Bartik)/Var(Bartik), HHI concentration, negative-weight count, and a top-weight-share pre-period placebo) are reported in the log following GPSS 2020 AER Section 5 / Borusyak-Hull-Jaravel 2022 REStud projection equivalence. The official GPSS bartik_weight ado assumes a national (unit-invariant) shift and is intentionally not invoked for this bank-year leave-one-out Bartik design (shifts vary by bank); the projection-based weights on the materialized base-period share columns are the design-appropriate diagnostic. " ///
         "Hassan 2019 QJE entity-proximity 同构 (lc share).")

display "✅ Table A3 written to output/tables/tableA3_bartik_iv.tex"
