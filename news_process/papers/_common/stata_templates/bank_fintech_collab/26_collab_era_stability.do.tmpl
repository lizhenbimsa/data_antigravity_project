* ============================================================================
* 26_collab_era_stability.do — 分时代稳定性 (era-stability, XYEAR/CY-2, P5)
* Paper: {{PAPER_ID}}  (Innovation Collaboration Mode — Chesbrough 2003)
*
* CY-2 修复 (2026-06-14): 2007-2024 跨 2013 余额宝 / 2016 P2P 整治 / 2019 DCEP 多
*   regime, pooled intensity-DiD 若关系在时代间断裂会把异质效应平均成有偏均值。
*   全代码库此前无结构性分时代稳定性检验 (唯一时间维稳健性 excl_pre2013 是其反面)。
*   本表移植 disagreement/clarity 13_table4 Panel B 的 regime 面板范式, 三时代:
*     ERA1 = 2007-2012  (前 fintech: 移动支付/余额宝前)
*     ERA2 = 2013-2018  (fintech 扩张: 余额宝→P2P 顶峰→整治)
*     ERA3 = 2019-2024  (强监管 / DCEP / 助贷规范)
*
* 三个面板:
*   A: 各时代分样本各跑一次主规格 (并排成列)
*   B: 全样本加 treatment × era 交乘 (era 哑变量 #c.treatment)
*   C: Wald 检验三时代 treatment 系数相等 (H0: 关系跨时代稳定)
*
* 估计量: bank + year FE TWFE (主规格); 处理 = collab_frac (连续外部协同占比,
*   era 交乘用连续量更干净) + 二元主导对 collab_open_full/collab_closed_full 作对照。
*
* golden-safe / $0: 仅消费在盘 collab_frac/year + 待接入 DV 哨兵; 全程 capture 守卫。
*   T=2 现盘只有 2017-2018 (单一时代 ERA2 有数据) → A 面板仅跑有 N 的时代, B/C
*   面板因交乘项缺乏跨时代变异自动退化/优雅跳过 (N 守卫 + capture), 不报错不弹框;
*   生产 T=18 三时代齐全后自动激活全部三面板。
*
* ⚠ 本文件被 00_master.do 以 `do` 调用 (子 .do), 末尾【绝不加】终端 exit (会中断 master 链)。
* ============================================================================

version 19
clear all
set more off
set maxvar 32767
set linesize 120

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"
capture mkdir "$tables_dir/.."
capture mkdir "$tables_dir"

use "$data_dir/_prepared_panel.dta", clear

eststo clear

local DV   {{MAIN_DV}}
local CL   {{CLUSTER_VAR}}
local TX   collab_frac
local XBIN collab_open_full collab_closed_full

* ── DV 解析 (缩尾 _w → 裸名 → 缺则整表 no-op wire-ahead 桩) ─────────────────
capture confirm variable `DV'_w
if !_rc {
    local DVUSE `DV'_w
}
else {
    capture confirm variable `DV'
    if !_rc {
        local DVUSE `DV'
    }
    else {
        display "  WARN 结果变量 `DV'(_w) 待接入财务面板; Table A-collab-ERA 整表 no-op (wire-ahead 桩)"
        exit 0
    }
}
capture confirm variable `CL'
if _rc local CL bank_id
capture confirm variable `TX'
if _rc {
    display "  WARN 主处理变量 `TX' 缺 (须先跑 01_data_prep); Table A-collab-ERA degrade"
    exit 0
}

* ── era 标记 (三时代; 仅用现存 year 列, golden-safe) ───────────────────────
capture drop _era
gen byte _era = .
replace _era = 1 if year >= 2007 & year <= 2012
replace _era = 2 if year >= 2013 & year <= 2018
replace _era = 3 if year >= 2019 & year <= 2024
label define _eralbl 1 "2007-2012" 2 "2013-2018" 3 "2019-2024", replace
label values _era _eralbl

* 有数据的时代清单 (T=2 盘只 ERA2; 防对空时代跑回归崩溃)
levelsof _era, local(_eras_present)

* ===========================================================================
* Panel A: 各时代分样本主规格 (并排; 仅跑有 N 的时代)
* ===========================================================================
local eracols ""
local eralabs ""
foreach e of local _eras_present {
    quietly count if _era == `e' & !missing(`DVUSE', `TX')
    if r(N) >= 10 {
        capture eststo eraA`e': reghdfe `DVUSE' `TX' $controls if _era == `e', ///
            absorb(bank_id year) vce(cluster `CL')
        if !_rc {
            local eracols "`eracols' eraA`e'"
            local _lbl : label _eralbl `e'
            local eralabs `"`eralabs' "`_lbl'""'
        }
        else display "  WARN Panel A era==`e' 回归失败 (共线/退化), 跳过"
    }
    else display "  WARN Panel A era==`e' 子样本 N<10 (T=2 退化), 跳过"
}

if "`eracols'" != "" {
    esttab `eracols' using "$tables_dir/tableA_collab_era_split.tex", replace ///
        keep(`TX') se star(* 0.10 ** 0.05 *** 0.01) booktabs label compress b(3) ///
        stats(N r2, fmt(0 3) labels("N" "R²")) ///
        title("Table A-collab-ERA Panel A: Sub-era main spec (collab_frac on outcome)") ///
        mtitles(`eralabs') ///
        addnotes("Eras: 2007-2012 (pre-fintech) / 2013-2018 (fintech expansion) / 2019-2024 (strong regulation, DCEP). bank/year FE; SE clustered at `CL'.")
    estout `eracols' using "$tables_dir/tableA_collab_era_split.csv", replace delimiter(",") ///
        keep(`TX') cells(b(star fmt(3)) se(par fmt(3))) stats(N r2, fmt(0 3)) ///
        starlevels(* 0.10 ** 0.05 *** 0.01) mlabels(`eralabs')
    display "[OK] Table A-collab-ERA Panel A → tableA_collab_era_split.tex (+ .csv)"
}
else {
    display "  WARN Panel A 无任何时代有足够样本 (T=2 单时代退化 / DV 哨兵未接入), 跳过"
}

* ===========================================================================
* Panel B: 全样本 treatment × era 交乘 (era 哑变量 #c.treatment)
* Panel C: Wald 检验三时代 treatment 系数相等 (H0: 跨时代稳定)
*   需 ≥2 个时代有数据才有意义; 否则交乘项无变异 → 优雅跳过。
* ===========================================================================
local n_era_present : word count `_eras_present'
if `n_era_present' >= 2 {
    quietly count if !missing(`DVUSE', `TX', _era)
    if r(N) >= 20 {
        * i._era#c.`TX' 给出各时代 treatment 斜率; 主效应 i._era 由 year FE 部分吸收,
        * 用 ib(#).era 设基组防共线 (取最早有数据时代为基)。
        local _base : word 1 of `_eras_present'
        capture eststo eraB: reghdfe `DVUSE' ib`_base'._era#c.`TX' $controls, ///
            absorb(bank_id year) vce(cluster `CL')
        if !_rc {
            esttab eraB using "$tables_dir/tableA_collab_era_interaction.tex", replace ///
                se star(* 0.10 ** 0.05 *** 0.01) booktabs label compress b(3) ///
                stats(N r2, fmt(0 3) labels("N" "R²")) ///
                title("Table A-collab-ERA Panel B: treatment x era interaction") ///
                mtitles("collab_frac x era") ///
                addnotes("Interaction of collab_frac with era dummies (base era = `_base'). bank/year FE; SE clustered at `CL'. A flat profile across eras = cross-era stability.")
            estout eraB using "$tables_dir/tableA_collab_era_interaction.csv", replace delimiter(",") ///
                cells(b(star fmt(3)) se(par fmt(3))) stats(N r2, fmt(0 3)) ///
                starlevels(* 0.10 ** 0.05 *** 0.01)
            display "[OK] Table A-collab-ERA Panel B → tableA_collab_era_interaction.tex (+ .csv)"

            * Panel C: Wald 三 (或现存) 时代 treatment 系数相等性检验。
            * 构造 test 表达式: 全样本无交乘的合并斜率 vs 各时代斜率 — 这里用各
            * 时代交乘项两两相等检验 (基组斜率为合并主项 c.`TX', 交乘项为偏移量;
            * H0: 所有非基时代交乘 = 0 ⇔ 斜率跨时代相等)。
            local _testterms ""
            foreach e of local _eras_present {
                if `e' != `_base' {
                    local _testterms "`_testterms' `e'._era#c.`TX'"
                }
            }
            if "`_testterms'" != "" {
                capture noisily test `_testterms'
                if !_rc {
                    capture file close _eraw
                    file open _eraw using "$tables_dir/tableA_collab_era_wald.txt", write replace
                    file write _eraw "Table A-collab-ERA Panel C: Wald test of cross-era coefficient equality" _n
                    file write _eraw "H0: collab_frac slope identical across eras (all non-base era interactions = 0)" _n
                    file write _eraw "Base era = `_base'; eras present = `_eras_present'" _n
                    file write _eraw "Wald chi2(" (r(df)) ") = " (r(chi2)) "   p = " (r(p)) _n
                    file write _eraw "Reject H0 (p<0.05) => relationship NOT stable across eras (pooled estimate biased toward heterogeneous mean)." _n
                    file close _eraw
                    display "[OK] Table A-collab-ERA Panel C (Wald equality) → tableA_collab_era_wald.txt"
                }
                else display "  WARN Panel C Wald 检验失败 (交乘项被 omit / 退化), 跳过"
            }
            else display "  WARN Panel C: 仅 1 个有数据时代, 无跨时代对比, 跳过 Wald"
        }
        else display "  WARN Panel B 交乘回归失败 (T=2 单时代无变异 / 共线), 跳过 B+C"
    }
    else display "  WARN Panel B 全样本 N<20, 跳过交乘 + Wald"
}
else {
    display "  WARN 仅 `n_era_present' 个时代有数据 (T=2 盘多为单一 ERA2) — 跨时代交乘/Wald 无变异, 优雅跳过 (生产 T=18 自动激活)"
}

capture drop _era
display "[OK] bank_fintech_collab 26_collab_era_stability 完成 (era split + interaction + Wald)"
