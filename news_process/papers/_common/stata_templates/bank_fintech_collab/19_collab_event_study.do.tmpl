* ============================================================================
* 19_collab_event_study.do — 事件研究 (Event study) E1/E3/E4 (P5)
* Paper: {{PAPER_ID}}
* v3.4.0: 与 P4 locus 同 events (per spec event_studies)
*   E1: 2013-06-13 yuebao_launch (fintech ecosystem 开启)
*   E3: 2017-04-27 asset_management_rules
*   E4: 2020-11-03 ant_ipo_pause
*
* 估计量声明 (DID-5 一致性, 2026-06-14):
*   主估计 = 截面强度 DiD (cross-sectional intensity DiD): collab_open_full 哑变量 ×
*     相对事件年时间哑变量的 TWFE 交乘 (bank + year FE)。E1/E3/E4 是 SYNCHRONOUS
*     同步政策 (所有银行同年受冲击), 非错时 cohort → 不存在 Goodman-Bacon 负权重
*     场景, plain TWFE 交乘是此设定下的正确估计量 (头注与估计量一致, 不引 Sun-Abraham
*     作主估计)。
*   稳健性 = 若处理强度的时序异质性可疑, 补 Sun-Abraham (2021 JoE) eventstudyinteract
*     交互加权估计量作对照列 (capture which 守卫; 缺 ado / 缺 cohort 列时优雅跳过)。
* ============================================================================

version 19
clear all
set more off
set maxvar 32767

if "$data_dir" == ""    global data_dir "../data"
if "$figures_dir" == "" global figures_dir "../output/figures"

use "$data_dir/_prepared_panel.dta", clear

set seed {{RANDOM_SEED}}

* Event flags (依赖 panel 中已有的 event_year 标记列; 若无则跳过)
local events  E1 E3 E4
local years   2013 2017 2020
local n_ev: word count `events'

forvalues i = 1/`n_ev' {
    local ev: word `i' of `events'
    local yr: word `i' of `years'

    * 相对事件年的 lead/lag (-3 ~ +3)
    capture drop event_t_*
    forvalues lag = -3/3 {
        gen byte event_t_`ev'_`=`lag'+3' = (year == `yr' + `lag')
    }

    * Treatment = collab_open_full × event flag (cross-sectional intensity DiD)
    * 白话: 把"开放协同主导"哑变量与事件年前后的时间哑变量相乘,
    * 比较事件冲击对开放协同型 vs 其他银行的差异化影响 (截面强度 DiD)。
    capture confirm variable collab_open_full
    if !_rc {
        * fix(audit-2026-06-16): 补全 lead 项 (_0/_1/_2 = t-3/-2/-1) — 原仅纳入 _3.._6 (t≥0)
        * 是 post-only dynamic DiD, 无平行趋势检验且无 omitted base period (名实不符)。现镜像
        * locus/19: omit _3 (t=0) 为基期, 纳入前趋 _0/_1/_2 + 后趋 _4/_5/_6, 并对前趋做联合 F 检验。
        capture noisily reghdfe {{MAIN_DV}} ///
                            c.collab_open_full#i.event_t_`ev'_0 ///
                            c.collab_open_full#i.event_t_`ev'_1 ///
                            c.collab_open_full#i.event_t_`ev'_2 ///
                            c.collab_open_full#i.event_t_`ev'_4 ///
                            c.collab_open_full#i.event_t_`ev'_5 ///
                            c.collab_open_full#i.event_t_`ev'_6 ///
                            $controls, ///
            absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
        if !_rc {
            eststo es_`ev'

            * pre-trend 联合检验 (lead −3/−2/−1 = 0): 平行趋势的正式 F 检验
            * reghdfe c.X#i.D 系数 Stata 规范化为 1.D#c.X; capture 兜底命名差异
            capture test (1.event_t_`ev'_0#c.collab_open_full = 0) ///
                         (1.event_t_`ev'_1#c.collab_open_full = 0) ///
                         (1.event_t_`ev'_2#c.collab_open_full = 0)
            if !_rc {
                estadd scalar pretrend_F = r(F): es_`ev'
                estadd scalar pretrend_p = r(p): es_`ev'
                display "  [PRE-TREND] `ev': joint F(leads)=" %6.3f r(F) " p=" %5.3f r(p)
            }

            * Coefplot
            capture which coefplot
            if !_rc {
                coefplot es_`ev', vertical drop(_cons $controls) ///
                    title("Event Study `ev' (`yr') --- bank_fintech_collab") ///
                    yline(0) saving("$figures_dir/event_`ev'.gph", replace)
            }
        }
    }
}

* ── DID-5 稳健性 (2026-06-14): Sun-Abraham 交互加权事件研究 (capture 守卫) ────
* 仅当面板存在错时 cohort 列 (DCEP/Sandbox 等差异化处理年, 生产 T=19 接入) +
* eventstudyinteract ado 时激活; 同步政策 E1/E3/E4 无跨 cohort 变异 → 该列在
* 当前盘 (T=2 / 无 cohort 列) 优雅跳过, 不报错。Sun & Abraham 2021 JoE。
capture which eventstudyinteract
if _rc {
    display "  [WARN] eventstudyinteract not installed (ssc install eventstudyinteract); 跳过 Sun-Abraham 稳健性列"
}
else {
    * 错时 cohort 列 (生产接入后激活; 首个存在者用作 SA cohort)
    local sa_cohort ""
    foreach c in dcep_treat_year sandbox_cohort collab_treat_year {
        capture confirm variable `c'
        if !_rc & "`sa_cohort'" == "" local sa_cohort `c'
    }
    if "`sa_cohort'" == "" {
        display "  [WARN] 无错时 cohort 列 (dcep_treat_year/sandbox_cohort/collab_treat_year); E1/E3/E4 为同步政策, Sun-Abraham 退化为 TWFE, 跳过"
    }
    else {
        * 相对处理期 + never-treated 对照 (cohort 缺失=从未处理)
        capture drop _rel_time _never_treat _g_*
        gen byte _never_treat = missing(`sa_cohort')
        gen _rel_time = year - `sa_cohort' if !_never_treat
        * eventstudyinteract 需相对期哑变量集 (各 lead/lag 一列), 非单连续 _rel_time;
        * 窗口 -3..+3 (含端点 binning), 省略 -1 作基期。生产 T=19 cohort 接入后激活。
        local _gterms ""
        forvalues k = -3/3 {
            if `k' != -1 {
                local _nm = cond(`k' < 0, "_g_m`=abs(`k')'", "_g_p`k'")
                capture drop `_nm'
                gen byte `_nm' = (_rel_time == `k') if !_never_treat
                local _gterms "`_gterms' `_nm'"
            }
        }
        capture noisily eventstudyinteract {{MAIN_DV}} `_gterms', ///
            cohort(`sa_cohort') control_cohort(_never_treat) ///
            covariates($controls) absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
        if !_rc {
            capture which coefplot
            if !_rc {
                matrix _sa_b = e(b_iw)
                matrix _sa_V = e(V_iw)
                coefplot matrix(_sa_b), vertical se(_sa_V) yline(0) ///
                    title("Sun-Abraham IW event study --- bank_fintech_collab") ///
                    saving("$figures_dir/event_sunab.gph", replace)
            }
            display "[OK] Sun-Abraham (eventstudyinteract) 稳健性 → cohort=`sa_cohort'"
        }
        else display "  [WARN] eventstudyinteract 失败 (cohort 无跨期变异 / T=2 退化), 跳过"
        capture drop _rel_time _never_treat _g_*
    }
}

display "[OK] Event study (E1/E3/E4) → $figures_dir/event_*.gph"
