* news_process v3.4.0 — Table A1: Inter-track κ (plan v14 §3.5 P5.1 / §9.2 + v3.4.0 §J)
*
* 双轨化核心新价值: 篇章级 + bank-year 级 κ for stage 3 字段双轨
* v3.4.0: 加入第三维度 innovation_collab_mode (Chesbrough 2003 + L&S 2006 SMJ)
* 阈值 (plan v14 §5.2 R5-B):
*   篇章级 locus κ ≥ 0.50 (Landis & Koch 1977 moderate)
*   篇章级 substantiveness κ ≥ 0.45 (fair-to-moderate)
*   篇章级 collab_mode κ ≥ 0.45 (mirrors substantiveness 标准, v3.4.0)
*   注: κ 不应过高 (>0.70 → 双轨设计冗余)
*
* Stata 必装包: ssc install kappa (或 kapci2 含 CI)

version 19

* --- Section 1: 篇章级 κ ---
* 注: 需先把 stage 21 输出 (article-bank pair) 加载, 不是 bank-year panel.
* 用户层 hookup: 实际复现包会加 stage 21 .parquet → .dta 桥接.
* 此处模板假定一个 article-level .dta 存在 (路径: data/processed/21_tone_llms.dta).

capture confirm file "data/processed/21_tone_llms.dta"
if !_rc {
    preserve
        use "data/processed/21_tone_llms.dta", clear
        * 仅 dual gate (双轨 verified=True) 子集计算 κ
        keep if llm_verified_dual_both == 1

        * 编码 stage 3 类别为 0/1 (与 stage 46 stata_export 编码一致)
        gen byte _loc_full  = innovation_locus_full == "应用场景"
        gen byte _loc_ctx   = innovation_locus_ctx  == "应用场景"
        gen byte _sub_full  = innovation_substantiveness_full == "象征性"
        gen byte _sub_ctx   = innovation_substantiveness_ctx  == "象征性"
        * v3.4.0: 第三维度 collab_mode (positive_class=外部协同, Chesbrough 2003)
        gen byte _cm_full   = innovation_collab_mode_full == "外部协同"
        gen byte _cm_ctx    = innovation_collab_mode_ctx  == "外部协同"

        display _newline "Article-level κ (篇章级 inter-track):"
        capture which kappa
        if !_rc {
            kappa _loc_full _loc_ctx
            kappa _sub_full _sub_ctx
            kappa _cm_full _cm_ctx
        }
        else {
            display "  ⚠️ kappa command 不可用 (Stata 内置 stat 模块); skip"
        }
    restore
}
else {
    display "  ⏭ data/processed/21_tone_llms.dta 不存在, 篇章级 κ 跳过"
}

* --- Section 2: Bank-year 级一致性 ---
* 用 frac 列做相关性 (Pearson + Spearman) 作 κ 的连续版本
* v3.4.0: 加入 indep_frac (full) × indep_frac_cm (ctx) 相关性
* fix(omni-g-templates-16, 2026-06-11): 旧 confirm 引用幻影列 tech_frac_lf/sub_frac_sf
* (面板 full 轨是裸名 tech_frac/sub_frac, 仅 ctx 轨带 _lc/_sc 后缀; 与 11_table2
* correctness-04 重映射同一事实) → 多变量 confirm 任一缺即 _rc≠0 → Locus/Subst 两行
* ρ 恒为缺失, 双轨效度表实际永远空表。改用裸名×ctx 名, 且 locus/subst 独立守卫;
* 同时去掉 `, c` (covariance) 选项 — 表头与 display 标的是 Pearson ρ, 旧版算的是协方差。
quietly {
    capture confirm variable tech_frac tech_frac_lc
    if !_rc {
        correlate tech_frac tech_frac_lc
        local corr_locus = r(rho)
    }
    else {
        local corr_locus  .
    }
    capture confirm variable sub_frac sub_frac_sc
    if !_rc {
        correlate sub_frac sub_frac_sc
        local corr_subst = r(rho)
    }
    else {
        local corr_subst  .
    }
    capture confirm variable indep_frac indep_frac_cm
    if !_rc {
        correlate indep_frac indep_frac_cm
        local corr_collab = r(rho)
    }
    else {
        local corr_collab .
    }
}

display _newline "Bank-year level correlations:"
display "  Locus full-ctx Pearson ρ      = `corr_locus'"
display "  Subst full-ctx Pearson ρ      = `corr_subst'"
display "  Collab_mode full-ctx Pearson ρ = `corr_collab'"

* --- Section 3: 表输出 (placeholder) ---
file open f1 using "output/tables/tableA1_inter_track_kappa.tex", write replace
file write f1 "\begin{table}[h]\centering" _newline
file write f1 "\caption{Table A1: Inter-track Agreement}" _newline
file write f1 "\begin{tabular}{lccc}\toprule" _newline
file write f1 "Field & Article-level κ & Bank-year ρ & N \\\\\midrule" _newline
file write f1 "Innovation Locus      &  &  `corr_locus' &  \\\\" _newline
file write f1 "Innovation Subst.     &  &  `corr_subst' &  \\\\" _newline
file write f1 "Innovation Collab Mode &  &  `corr_collab' &  \\\\" _newline
file write f1 "\bottomrule\end{tabular}\end{table}" _newline
file close f1

display _newline "✅ Table A1 written to output/tables/tableA1_inter_track_kappa.tex"
display "    (Article-level κ 见 log; bank-year correlations 入表)"
