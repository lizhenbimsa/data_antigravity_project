capture do "data/processed/46_panel_yearly_labels.do"

* 主变量 local (替换占位符 → main spec)
* ============================================================================
* V5 / st-table2-main-04 fix (2026-06-03); correctness-04 升级 (2026-06-03):
*   full-text track 在面板中是裸名 tech_frac / symb_frac (无 _lf / _sf 后缀);
*   ctx track 才是 tech_frac_lc / symb_frac_sc. 当 main spec 选 full 轨
*   (MAIN_LOCUS_TRACK=lf / MAIN_SUBST_TRACK=sf, 见 stata_runner.py:206
*   _VALID_SPEC_VALUES = {lf,lc} × {sf,sc}) 时, 早期 `tech_frac_<track>` 直拼会展开成
*   tech_frac_lf / symb_frac_sf — 这两列在面板中不存在 (幻影列), M4/M6 的 reghdfe
*   引用它们会 r(111) 整张 Table 2 崩 (full 轨数据其实以裸名存在, 只是无 _lf/_sf 后缀).
*   correctness-04: 不再丢控制 degrade, 而是把幻影 _lf/_sf 重映射到真实存在的裸名 —
*   lf → 裸名 tech_frac, sf → 裸名 symb_frac; lc → tech_frac_lc, sc → symb_frac_sc.
*   占位符在 instantiate 时被替换成字面量 lf/lc/sf/sc, 下面用字符串比较选列名.
*   保留 capture confirm 作二次兜底: 即使映射后列仍缺 (面板未物化) 也 degrade 不崩.
* ============================================================================
local DV     llm_vote_tone_{{MAIN_SENT_TRACK}}

* LOCUS: lf (full) → 裸名 tech_frac; lc (ctx) → tech_frac_lc
if "{{MAIN_LOCUS_TRACK}}" == "lf" {
    local LOCUS tech_frac
}
else {
    local LOCUS tech_frac_{{MAIN_LOCUS_TRACK}}
}

* SUBST: sf (full) → 裸名 symb_frac; sc (ctx) → symb_frac_sc
if "{{MAIN_SUBST_TRACK}}" == "sf" {
    local SUBST symb_frac
}
else {
    local SUBST symb_frac_{{MAIN_SUBST_TRACK}}
}

* LOCUS/SUBST 存在性守卫 (V5 防 r(111); 重映射后的二次兜底)
capture confirm variable `LOCUS' `SUBST'
if _rc {
    display "  ⚠️ LOCUS/SUBST 列缺 (`LOCUS' / `SUBST'): 重映射后仍未物化, M4-M6 degrade 为不含 LOCUS/SUBST 的回归"
    local LOCUS
    local SUBST
}

* M1: 仅 digital_frontier (主解释)
eststo M1: reghdfe `DV' digital_frontier, noabsorb vce(cluster bank_id)

* M2: + Bank FE
eststo M2: reghdfe `DV' digital_frontier, absorb(bank_id) vce(cluster bank_id)

* M3: + Bank FE + Year FE
eststo M3: reghdfe `DV' digital_frontier, absorb(bank_id year) vce(cluster bank_id)

* M4: + locus / subst 占比控制
eststo M4: reghdfe `DV' digital_frontier `LOCUS' `SUBST', ///
    absorb(bank_id year) vce(cluster bank_id)

* M5: + bank 属性控制
capture confirm variable bank_size bank_age
if !_rc {
    eststo M5: reghdfe `DV' digital_frontier `LOCUS' `SUBST' bank_size bank_age, ///
        absorb(bank_id year) vce(cluster bank_id)
}
else {
    display "  ⚠️ bank_size/bank_age 不存在, M5 跳过"
    eststo M5: reghdfe `DV' digital_frontier `LOCUS' `SUBST', ///
        absorb(bank_id year) vce(cluster bank_id)
}

* M6: + 交互项 (LOCUS × SUBST)
* V5 守卫: LOCUS/SUBST 均存在才加 c.#c. 交互 (缺列时已被上方 local 置空,
* 此时退化为 M5 同规格主回归, 避免 `c.#c.` 空宏语法错).
if "`LOCUS'" != "" & "`SUBST'" != "" {
    eststo M6: reghdfe `DV' digital_frontier `LOCUS' `SUBST' c.`LOCUS'#c.`SUBST', ///
        absorb(bank_id year) vce(cluster bank_id)
}
else {
    display "  ⚠️ LOCUS/SUBST 缺列, M6 交互项跳过, degrade 为主回归 (digital_frontier only)"
    eststo M6: reghdfe `DV' digital_frontier, ///
        absorb(bank_id year) vce(cluster bank_id)
}

* 输出 Table 2 (booktabs LaTeX)
esttab M1 M2 M3 M4 M5 M6 using "output/tables/table2_main.tex", ///
    se star(* 0.10 ** 0.05 *** 0.01) ///
    booktabs replace fragment ///
    title("Table 2: Bank Fintech Tone — Main Results (M1-M6)") ///
    mtitles("M1" "M2" "M3" "M4" "M5" "M6") ///
    note("Robust SEs clustered at bank level. Main spec: locus={{MAIN_LOCUS_TRACK}}, subst={{MAIN_SUBST_TRACK}}, sent={{MAIN_SENT_TRACK}}")

* fix(omni-g-esttab-csv, 2026-06-11): CSV side-channel (与 .tex 同模型同统计规格) —
* 供 python 侧 papers/_common/stata_postprocess.parse_esttab_csv 消费。
* 用 estout + delimiter(",") 而非 esttab csv: esttab csv 默认 ="..." Excel 包裹
* (plain 则丢 SE 括号), 两者都破坏 parse_esttab_csv 的 (se) 行正则。
estout M1 M2 M3 M4 M5 M6 using "output/tables/table2_main.csv", replace delimiter(",") ///
    cells(b(star fmt(3)) se(par fmt(3))) stats(N r2, fmt(0 3)) ///
    starlevels(* 0.10 ** 0.05 *** 0.01) ///
    mlabels("M1" "M2" "M3" "M4" "M5" "M6")

display "✅ Table 2 written to output/tables/table2_main.tex (+ .csv side-channel)"
