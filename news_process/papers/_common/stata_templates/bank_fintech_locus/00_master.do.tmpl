version 19
clear all
set more off

if "$repl_root" == "" {
    global repl_root ".."
}
global data_dir   "$repl_root/data"
global out_dir    "$repl_root/output"
global tables_dir "$out_dir/tables"
global figures_dir "$out_dir/figures"
capture mkdir "$out_dir"
capture mkdir "$tables_dir"
capture mkdir "$figures_dir"

* fix(omni-g-replication-01, 2026-06-11): 01_data_prep 失败时 fail-loud 带可读原因
* (常见原因: 外部财务列未接入 — ROA/CAR/ln_assets 族, 见 config/银行面板2007-2025年.xlsx
* 接入计划与 paper_spec.yaml enrichment_source), 而非裸 r(198) 中断。
capture noisily do 01_data_prep.do
local _prep_rc = _rc
if `_prep_rc' {
    display as error "[FATAL] 01_data_prep.do failed (rc=`_prep_rc') — 复现包中止; 详见上方 [ERROR] 行 (多为外部财务数据未接入)"
    exit `_prep_rc'
}
* fix(omni-g-templates-07, 2026-06-11): 15_* 主回归改 capture noisily + 显式 [ERROR] —
* 旧裸 do 在 15 内任一错误 (如 esttab 缺名 r(111)) 即中止 master, 16-19 全部不执行零表
* 白话: 主回归脚本出错时最多丢 Table 2, 后面的机制/异质性/稳健性表照常跑, 不让整条复现链半途而废。
capture noisily do 15_locus_main_regression.do
if _rc {
    display as error "[ERROR] 15_locus_main_regression.do failed (rc=`=_rc'); Table 2 缺失, 继续后续模板"
}
capture do 16_locus_mechanism.do
capture do 17_locus_heterogeneity.do
capture do 18_locus_robustness.do
capture do 19_locus_event_study.do

