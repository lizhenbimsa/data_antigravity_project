* ============================================================================
* 23_locus_subsample_extension.do — Table B (bank_fintech_locus / P4)
* Paper: {{PAPER_ID}}
*
* 子样本外部效度扩展 (subsample / external-validity extension)。
* 仅补 17_locus_heterogeneity / 18_locus_robustness 未覆盖的 2 个新切分:
*   (1) HUB-SPLIT   网络枢纽 vs 非枢纽 (bank_is_hub == 1 / 0)
*   (2) SIZE-SPLIT  大行 vs 小行 (bank_effective_size 中位数二分)
*
* ⚠ 刻意不重复已有切分:
*     三波 fintech 浪潮 .......... 已在 17_locus_heterogeneity (Panel a)
*     SOE × 非SOE split ......... 已在 17_locus_heterogeneity (Panel b, is_soe)
*     bank_type 4-split ......... 已在 17_locus_heterogeneity (Panel c)
*     excl-SOE6 / excl-rural ... 已在 18_locus_robustness (Panel 7)
*
* ── 大白话 ────────────────────────────────────────────────────────────────
*   是什么: 把样本按"是不是网络枢纽银行""规模大不大"各切两半, 分别重跑主回归
*           (底层技术占比 vs 应用场景占比), 看 locus 效应在两边是否都站得住。
*   为什么: 审稿人关心结论的外部效度——是不是只在某一类银行才成立。头部/枢纽
*           银行更可能引领底层技术投入 (技术轨); 规模异质性是创新产出文献的标配
*           切分。这是构成稳健性 (compositional robustness) 的标准做法。
*   影响:   只读在盘列 (bank_is_hub / bank_effective_size 已核 174 行 panel),
*           treatment 侧即可跑第一阶段; financial DV (citation_weighted_patent)
*           缺列时 capture 守卫优雅跳过 (wire-ahead), golden-safe, 接入后自动激活。
*
* ── 文献锚点 (DOI 已核验) ──────────────────────────────────────────────────
*   构成稳健性 / 子样本异质性为标准实证做法, 锚定:
*   Gormley, T. A., & Matsa, D. A. (2014). Common errors: How to (and not to)
*   control for unobserved heterogeneity. Review of Financial Studies, 27(2),
*   617-661. doi:10.1093/rfs/hht047
*   网络枢纽口径背景: Bramoullé, Y., Djebbari, H., & Fortin, B. (2009).
*   Identification of peer effects through social networks. Journal of
*   Econometrics, 150(1), 41-55. doi:10.1016/j.jeconom.2008.12.021
*
* 注: TIMING (treatment lead/lag) 不适用本篇 — locus 主处理无 _lag1 列
*   (has_lag=false); 故本扩展只补 hub / size 两个构成切分。
* ============================================================================

version 19
clear all
set more off
set maxvar 32767
set linesize 120
eststo clear

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"
* nested mkdir (主链 master 已建; 独立重跑/dry-run 防御)
capture mkdir "$tables_dir/.."
capture mkdir "$tables_dir"

* 载入已 prepped 面板; 独立重跑兜底回退原盘 + 现场 encode + 派生主处理。
capture confirm file "$data_dir/_prepared_panel.dta"
if !_rc {
    use "$data_dir/_prepared_panel.dta", clear
}
else {
    capture confirm file "data/processed/_prepared_panel.dta"
    if !_rc use "data/processed/_prepared_panel.dta", clear
    else    use "data/processed/46_panel_yearly_full.dta", clear
    capture confirm variable bank_id
    if _rc encode target_bank, gen(bank_id)
    capture confirm variable locus_layer_full
    if _rc {
        capture confirm variable tech_frac
        capture confirm variable app_frac
        capture gen locus_layer_full    = (tech_frac > app_frac) if !missing(tech_frac, app_frac)
        capture gen locus_scenario_full = (app_frac > tech_frac) if !missing(tech_frac, app_frac)
    }
    xtset bank_id year
}

set seed {{RANDOM_SEED}}

* ----------------------------------------------------------------------------
* 公共守卫: outcome / treatment 在不在盘
* ----------------------------------------------------------------------------
local have_dv = 0
capture confirm variable {{MAIN_DV}}
if !_rc local have_dv = 1
local have_treat = 0
capture confirm variable locus_layer_full
if !_rc local have_treat = 1
if `have_dv' == 0 {
    display as text "  [WIRE-AHEAD] {{MAIN_DV}} 不在盘 (外部财务面板待接入); Table B 子样本回归优雅跳过, 仅写空表占位"
}
if `have_treat' == 0 {
    display as error "  [WARN] locus_layer_full 不在盘 — 须先跑 01_data_prep 派生主处理, Table B 跳过"
}

* 每个子样本最低观测数门控 (小单元不跑, 对齐 17 的 R7-m01 small-cell 守卫)
local min_n = 10

* ============================================================================
* (1) HUB-SPLIT — 网络枢纽 vs 非枢纽
* 白话: bank_is_hub==1 的是网络枢纽银行 (媒体/同业关注集中度高), 看 locus 效应
*       在枢纽与非枢纽两类银行里是否一致 (枢纽行更可能引领底层技术轨)。
* ============================================================================
capture confirm variable bank_is_hub
if !_rc & `have_dv' & `have_treat' {
    foreach h in 1 0 {
        count if bank_is_hub == `h' & !missing(locus_layer_full, {{MAIN_DV}})
        if r(N) >= `min_n' {
            capture noisily reghdfe {{MAIN_DV}} locus_layer_full locus_scenario_full $controls if bank_is_hub == `h', ///
                absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
            if !_rc eststo hub_`h'
        }
        else {
            display as text "  [SKIP] HUB-SPLIT bank_is_hub==`h': N=" r(N) " < `min_n' (small-cell; production 全样本激活)"
        }
    }
}
else if _rc {
    display as text "  [SKIP] HUB-SPLIT: bank_is_hub 不在盘"
}

* ============================================================================
* (2) SIZE-SPLIT — 大行 vs 小行 (bank_effective_size 中位数二分)
* 白话: bank_effective_size 是银行有效规模, 按中位数切成大行/小行两组, 看 locus
*       效应是不是只在某个规模档成立。
* 实现: summarize 取 p50 → gen 二元 _size_big; 非缺失值上做 median split。
* ============================================================================
capture confirm variable bank_effective_size
if !_rc & `have_dv' & `have_treat' {
    quietly count if !missing(bank_effective_size)
    if r(N) >= (2 * `min_n') {
        quietly summarize bank_effective_size, detail
        local _med = r(p50)
        gen byte _size_big = .
        replace _size_big = 1 if bank_effective_size >  `_med' & !missing(bank_effective_size)
        replace _size_big = 0 if bank_effective_size <= `_med' & !missing(bank_effective_size)

        foreach s in 1 0 {
            count if _size_big == `s' & !missing(locus_layer_full, {{MAIN_DV}})
            if r(N) >= `min_n' {
                capture noisily reghdfe {{MAIN_DV}} locus_layer_full locus_scenario_full $controls if _size_big == `s', ///
                    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
                if !_rc eststo size_`s'
            }
            else {
                display as text "  [SKIP] SIZE-SPLIT _size_big==`s': N=" r(N) " < `min_n' (small-cell; production 全样本激活)"
            }
        }
    }
    else {
        display as text "  [SKIP] SIZE-SPLIT: bank_effective_size 非缺失 N=" r(N) " 不足二分 (< " (2*`min_n') "); production 全样本激活"
    }
}
else if _rc {
    display as text "  [SKIP] SIZE-SPLIT: bank_effective_size 不在盘"
}

* ============================================================================
* 输出: esttab 动态名单 (缺名不点名) + CSV side-channel
* ============================================================================
qui estimates dir
local stored `r(names)'
local models ""
foreach m of local stored {
    if strmatch("`m'", "hub_*") | strmatch("`m'", "size_*") {
        local models `models' `m'
    }
}

if "`models'" == "" {
    display as text "  [WIRE-AHEAD] Table B 无任何已存储估计 (financial DV 待接入 / 全子样本守卫跳过); 表跳过, 非失败"
}
else {
    esttab `models' using "$tables_dir/tableB_locus_subsample_extension.tex", replace ///
        star(* 0.10 ** 0.05 *** 0.01) se booktabs label compress b(3) ///
        stats(N r2, fmt(0 3) labels("N" "R\textsuperscript{2}")) ///
        title("Table B --- Subsample Extension: Hub \& Size Splits (P4 locus)") ///
        addnotes("Hub split: bank\_is\_hub network-centrality indicator (1 = hub)." ///
                 "Size split: bank\_effective\_size median split (1 = large)." ///
                 "Excludes splits already in Table 4 (fintech waves, SOE, bank type) and Table 5 (excl-SOE6, excl-rural)." ///
                 "TIMING (treatment lead/lag) n/a: locus treatment has no _lag1 column." ///
                 "Cells with N < 10 skipped (R7-m01 small-cell warning).")

    * CSV side-channel — parse_esttab_csv 消费 (tables.py read_paper_esttab)
    estout `models' using "$tables_dir/tableB_locus_subsample_extension.csv", replace ///
        delimiter(",") cells(b(star fmt(3)) se(par fmt(3))) ///
        stats(N r2, fmt(0 3)) starlevels(* 0.10 ** 0.05 *** 0.01)

    display "[OK] Table B (subsample: hub / size) → $tables_dir/tableB_locus_subsample_extension.tex (+ .csv side-channel)"
}
