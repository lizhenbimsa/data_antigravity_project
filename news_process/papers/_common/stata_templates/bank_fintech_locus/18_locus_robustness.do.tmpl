version 19
clear all
set more off
set maxvar 32767
set linesize 120

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"

use "$data_dir/_prepared_panel.dta", clear

set seed {{RANDOM_SEED}}

* (1) Oster (2019) δ
* 白话: 估算"看不见的遗漏变量得有多强, 才能把结论推翻", 衡量选择性偏误的稳健性。
* RB-2 修复 (2026-06-14): Oster δ 的真实 psacalc 命令 (含 mcontrol = year-FE 哑变量、
* rmax = min(1, 1.3×R²)、materialized 年度哑变量绕过 psacalc 不解析 i.year 的 r(5001))
* 已在 22_locus_fe_saturation_oster.do (Panel C) 完整落地并进表; 此处不再留死注释。

* (2) rwolf 多重假设 FWER 校正 (INFER IV-1 修复 2026-06-14): 注释脚手架转真实命令。
* family = 两个 locus 处理 (layer / scenario), Romano-Wolf step-down 控制族内 FWER。
* 白话: 同时检验"底层技术主导"与"应用场景主导"两个处理时, 总有一个可能碰巧显著;
*       rwolf 用自助 step-down 法把 p 值整体调严, 防多重检验误报。capture which 守卫:
*       缺 rwolf ado / T=2 退化时优雅跳过, 不报错; production T=19 自动激活。
capture which rwolf
if _rc {
    capture ssc install rwolf, replace
}
capture which rwolf
if !_rc {
    capture noisily rwolf {{MAIN_DV}}, indepvar(locus_layer_full locus_scenario_full) ///
        controls($controls) reps(1000) seed({{RANDOM_SEED}}) ///
        method(reghdfe) absorb(bank_id year) cluster({{CLUSTER_VAR}})
    if !_rc {
        * rwolf 把 family-wise p 存进 e(rw)/返回矩阵; 注入 stats 行供脚注引用
        capture scalar _rw_layer = e(rw_locus_layer_full)
        display "  [RWOLF] Romano-Wolf FWER-adjusted p (locus family, 1000 reps): see r()/e(rw_*)"
    }
    else {
        display "  ⚠️ rwolf 运行失败 (T=2 退化 / within 变异不足); production T=19 激活"
    }
}
else {
    display "  ⚠️ rwolf not installed (ssc install rwolf); FWER 校正跳过"
}

* (3) Honest DiD (DID-3 修复 2026-06-14): 注释脚手架转真实命令。
* 白话: 允许"平行趋势"假设有一定程度偏离 (M-grid 控制最大偏离幅度), 看 layer 效应
*       在多大违背下仍然显著。依赖事件研究 (19_locus_event_study) 保存的 leads/lags
*       事件时间系数; honestdid 在其上做平滑度/相对幅度的部分识别敏感性。
* 实现: 先复刻 19 的 INLINE 截面强度事件研究 (E1=2013, 余额宝, 窗口最长), 保存 e(),
*       再对 leads/lags 系数向量跑 honestdid。capture 全程守卫 (缺 ado / T=2 退化跳过)。
capture confirm variable locus_layer_full
if !_rc {
    * 事件 E1 (2013) 相对年哑变量 (镜像 19_locus_event_study INLINE 写法)
    capture drop _hd_et_*
    forvalues lag = -3/3 {
        gen byte _hd_et_`=`lag'+3' = (year == 2013 + `lag')
    }
    * INLINE 事件研究 (参照 = 事件当年 index 3 省略); 保存 e() 供 honestdid 与 pre-trend F
    * fix(2026-06-14 二轮): 交乘用 c.#c. (连续×0/1 哑变量) 而非 c.#i. (因子) — 因子展开
    *   在 e(b) 产 0b. base + 1o. omitted 交错 12 列, 位置/名称抽取均易错位; c.#c. 每项产
    *   单干净列 (顺序即 RHS 顺序), 供下方 honestdid 位置切片前 6 列。0/1 哑变量下两写法
    *   event-study 系数等价 (Stata /b 合成 T=19 实测)。
    capture noisily reghdfe {{MAIN_DV}} ///
            c.locus_layer_full#c._hd_et_0 c.locus_layer_full#c._hd_et_1 ///
            c.locus_layer_full#c._hd_et_2 c.locus_layer_full#c._hd_et_4 ///
            c.locus_layer_full#c._hd_et_5 c.locus_layer_full#c._hd_et_6 ///
            $controls, absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    if !_rc {
        eststo es_honest_E1
        * pre-trend 联合 F (DID-3): leads −3/−2/−1 交乘 = 0
        * (c.#c. 写法系数名 = c.locus_layer_full#c._hd_et_K, 与 RHS 同名)
        capture test (c.locus_layer_full#c._hd_et_0 = 0) ///
                     (c.locus_layer_full#c._hd_et_1 = 0) ///
                     (c.locus_layer_full#c._hd_et_2 = 0)
        if !_rc {
            estadd scalar pretrend_F = r(F): es_honest_E1
            estadd scalar pretrend_p = r(p): es_honest_E1
            display "  [PRE-TREND] E1 joint F(leads)=" %6.3f r(F) " p=" %5.3f r(p)
        }
        * HonestDiD 部分识别敏感性 (Rambachan-Roth 2023 RES 相对幅度 M-grid; 缺 ado / 退化时跳过)
        * RB-3 修复 (2026-06-14): 旧版用 honestdid 不存在的用户级选项 pre()/post() (本机 ado
        * Caceres Bravo 1.3.4 的 syntax 行只接受 numpreperiods() 或 preperiodindices()+
        * postperiodindices(); pre/post 仅 HonestSanityChecks 内部子程序参数, 用户调用必 r(198))
        * → capture noisily 永久吞掉 → 即便 T=19 数据齐全也从不真跑 (claimed-but-not-run 病灶)。
        * 改两处: (1) pre()/post() → numpreperiods(3) (前 3 lead = pre-period);
        * (2) reghdfe e(b) 含 6 event-time 交乘 + $controls + _cons → 不能直喂 e(b)/e(V)
        *     (numpreperiods 会从首列切到 control 系数), 先用 Mata 按列名抽出 6 个 event-time
        *     交乘子向量 b_es 与对应 6×6 vcov 子块 V_es, 再 honestdid, b(b_es) vcov(V_es)。
        * 列序 = 3 lead (_hd_et_0/1/2 = year-3/-2/-1) + 3 lag (_hd_et_4/5/6 = year+1/+2/+3),
        * 参照年 index 3 (=2013) 省略; reghdfe 把 c.X#i.D 规范化为 1.D#c.X (与 pre-trend test 同名)。
        capture which honestdid
        if !_rc {
            * 6 个 event-time 交乘 = reghdfe RHS 前 6 列 (顺序 _hd_et_0/1/2 leads, _hd_et_4/5/6 lags),
            * $controls/_cons 在其后。位置抽取前 6 列 b_es + 6×6 vcov 子块 V_es。
            * fix(2026-06-14 二轮): 旧多行 Mata 名称匹配在本机 r(3000) 永不成形 (claimed-but-not-run);
            *   且 c.#i. 因子展开在 e(b) 产 0b./1o. 交错列致名称/位置均错位 → 已改 c.#c. (上方) +
            *   位置切片 (与 attention/18 同口径, Stata /b 合成 T=19 实测 honestdid 产 .gph rc=0)。
            *   守卫: 前 6 列名均含 _hd_et (退化丢列时跳过)。
            tempname b_es V_es
            local hd_ok = 0
            matrix _hb = e(b)
            matrix _hV = e(V)
            local _bn : colnames _hb
            local _nw : word count `_bn'
            if `_nw' >= 6 {
                local _ok6 = 1
                forvalues p = 1/6 {
                    local _nm : word `p' of `_bn'
                    if strpos("`_nm'", "_hd_et") == 0 local _ok6 = 0
                }
                if `_ok6' {
                    capture {
                        mata: st_matrix(st_local("b_es"), st_matrix("e(b)")[1, 1..6])
                        mata: st_matrix(st_local("V_es"), st_matrix("e(V)")[1..6, 1..6])
                    }
                    if !_rc local hd_ok = 1
                }
            }
            if `hd_ok' == 1 {
                * numpreperiods(3): 前 3 列 (lead -3/-2/-1) 作 pre-period; 余 3 列作 post;
                * mvec = 相对幅度 M-grid (delta(rm) 默认); coefplot 透传 saving() 落 .gph。
                capture noisily honestdid, b(`b_es') vcov(`V_es') ///
                    numpreperiods(3) mvec(0 0.5 1 1.5 2) delta(rm) ///
                    coefplot saving("$tables_dir/honestdid_locus_E1.gph", replace)
                if !_rc display "  [HONESTDID] E1 relative-magnitude sensitivity (M=0..2) → honestdid_locus_E1.gph"
                else    display "  ⚠️ honestdid 运行失败 (T=2 退化 / OSQP-ECOS plugin / coefplot 版本); production T=19 激活"
            }
            else {
                display "  [SKIP] event-time 子向量抽取失败 (退化样本部分交乘被 drop); production T=19 激活"
            }
        }
        else {
            display "  ⚠️ honestdid not installed (ssc install honestdid + coefplot); 平行趋势敏感性跳过 (真未运行)"
        }
    }
    else {
        display "  [SKIP] HonestDiD 前置事件研究退化 (T=2 仅 2017-2018, E1=2013 窗外); production T=19 激活"
    }
}

* (4) Wild cluster bootstrap (野聚类自举)
* fix(omni-g-templates-10, 2026-06-11): (i) boottest 补 capture which 守卫 (对齐
* collab/18; 未装机器上旧版裸调 r(199) 致本表整丢); (ii) boottest 按设计不改写
* e(b)/e(V) (wild p 在 r(p)), 旧 eststo 存的是 reghdfe 解析 cluster SE → "Wild boot"
* 列名实不符。现以 estadd 把 r(p) 注入 e(p_wild) 进表 stats 行, 缺 boottest 时如实告警。
* 白话: 银行聚类数偏少时常规标准误偏小、容易假显著; 用 wild bootstrap 重算 p 值并如实写进表里。
reghdfe {{MAIN_DV}} locus_layer_full locus_scenario_full $controls, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
capture which boottest
if !_rc {
    boottest locus_layer_full, reps(9999) seed({{RANDOM_SEED}})
    estadd scalar p_wild = r(p)
}
else {
    display "  ⚠️ boottest not installed (ssc install boottest); wild_boot 列仅含解析 cluster SE, wild p 缺失"
}
eststo wild_boot

* (5) ritest randomization inference (Young 2019 QJE; MacKinnon-Webb 2020 Journal of Econometrics)
* v3.6.1 PR #7 启用; SSC 自动检测, 装不上则跳过 (G-C2.0 准入门控由 v2.3).
* 白话: 把处理变量随机打乱很多次构造"纯随机"分布, 看真实系数是否明显超出该分布 (随机化推断)。
capture which ritest
if _rc != 0 {
    capture ssc install ritest, replace
}
capture which ritest
if _rc == 0 {
    ritest locus_layer_full _b[locus_layer_full], reps(1000) seed({{RANDOM_SEED}}) ///
        cluster(bank_id) strata(year): ///
        reghdfe {{MAIN_DV}} locus_layer_full locus_scenario_full $controls, ///
            absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    eststo ritest_ri
}
else {
    display "  ⚠️ ritest not installed (ssc install ritest); randomization inference 跳过"
}

* (6) 溢出效应 SUTVA 检验 (本模板未实现, 仅为维度占位)

* (7) 样本切分 (Sample cuts)
* st-did-05 fix (2026-06-03): bank_type 是字符串列 (str), 由 iv_did.py::load_bank_group_maps()
* 产出 'soe'/'joint'/'city'/'rural'/'private'/'foreign'/'other' (NFRA_TO_SHORT 映射,
* 见 runner.py:857 `is_soe = (panel['bank_type'] == 'soe')`). 旧 `if bank_type != 1`
* / `!= 4` 用数值与字符串列比较, StataNow 19.5 触发 r(109) type mismatch. 改为字符串
* 比较: excl 国有 6 = != "soe", excl 农商行 = != "rural" (对齐 attention/18:94 已修写法).
reghdfe {{MAIN_DV}} locus_layer_full locus_scenario_full $controls if bank_type != "soe", ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo excl_soe6
reghdfe {{MAIN_DV}} locus_layer_full locus_scenario_full $controls if bank_type != "rural", ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo excl_rural
reghdfe {{MAIN_DV}} locus_layer_full locus_scenario_full $controls if year >= 2013, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo excl_pre

* ============================================================================
* (8) Paper-specific: 替代 locus 分类器 (ctx 轨)
* ============================================================================
* fix(omni-g-templates-09, 2026-06-11): locus_layer_ctx/locus_scenario_ctx 现由
* 01_data_prep 从 panel 真实 ctx 孪生 tech_frac_lc/app_frac_lc 派生 (与 _full 对同构;
* 旧版从未派生 → 本块守卫永假、双轨稳健性永久静默跳过)。守卫保留作 _lc 列缺失兜底。
* 白话: 用 ctx 轨 (标题+实体上下文窗口) 重新分类得到的占比再跑一遍, 验证结论不依赖归因窗口的选法。
capture confirm variable locus_layer_ctx locus_scenario_ctx
if !_rc {
    reghdfe {{MAIN_DV}} locus_layer_ctx locus_scenario_ctx $controls, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    eststo alt_ctx
}
else {
    display "  [WARN] locus_layer_ctx/locus_scenario_ctx 未派生 (tech_frac_lc/app_frac_lc 缺); alt_ctx 跳过"
}

* ============================================================================
* (9) Borusyak-Jaravel-Spiess imputation DiD (额外 robustness per spec)
* 白话: 用"插补法"做双重差分, 避免传统双向固定效应在各银行处理时点不同时产生的加权偏误。
* ============================================================================
capture confirm variable treat_year
if !_rc {
    * did_imputation 需先 ssc install did_imputation (per §5.7.3)
    * did_imputation {{MAIN_DV}} bank_id year treat_year, ///
    *     fe(bank_id year) controls($controls) autosample
    display "  [TODO] did_imputation requires SSC; see §5.7.3 prereqs"
}

* === Winsorization sensitivity (主回归用 raw DV: citation_weighted_patent 为专利计数 outcome, JF/JFE 惯例下计数/log/差分 outcome 主回归不缩尾; 缩尾仅作稳健性, 故与 cohort-A levels-ratio _w 基准口径不同) ===
reghdfe {{MAIN_DV}}_w locus_layer_full locus_scenario_full $controls, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo wsens_w1
reghdfe {{MAIN_DV}}_w5 locus_layer_full locus_scenario_full $controls, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo wsens_w5

* fix(omni-g-templates-07, 2026-06-11): esttab 名单动态化 — alt_ctx 在守卫块内,
* 旧版硬点名缺名 → r(111) 丢整张 Table 5; ritest_ri 仍按原设计只留 log 不进表。
* 2026-06-13: 缩尾敏感性 wsens_w1/wsens_w5 加入 inlist 白名单 (此过滤器无 strmatch 兜底, 不加则新列静默不进表, MF9)
qui estimates dir
local stored `r(names)'
local models ""
foreach m of local stored {
    if inlist("`m'", "wild_boot", "excl_soe6", "excl_rural", "excl_pre", "alt_ctx") | ///
       inlist("`m'", "wsens_w1", "wsens_w5", "es_honest_E1") {
        local models `models' `m'
    }
}
esttab `models' ///
    using "$tables_dir/table5_robustness.tex", replace ///
    star(* 0.10 ** 0.05 *** 0.01) se booktabs label compress b(3) ///
    stats(N r2 p_wild pretrend_F pretrend_p, fmt(0 3 3 3 3) ///
          labels("N" "R²" "Wild cluster bootstrap p" "Pre-trend joint F" "Pre-trend p")) ///
    title("Table 5 — Advanced Robustness (P4 locus + alternative classifier + Borusyak DiD)") ///
    addnotes("Column wild_boot: analytic cluster SE shown; wild cluster bootstrap p (boottest, 9999 reps) reported in the p\_wild row." ///
             "Column es_honest_E1: INLINE intensity event study (E1=2013 yuebao); Pre-trend joint F = test(leads −3/−2/−1 = 0). HonestDiD relative-magnitude (M=0..2) sensitivity (Rambachan-Roth 2023) runs on the extracted 6-coefficient event-time subvector via honestdid, b()/vcov() numpreperiods(3): activates in production T=19 (real command) and gracefully skips under T=2 degeneracy → honestdid_locus_E1.gph." ///
             "Romano-Wolf FWER-adjusted p over the locus treatment family (rwolf, 1000 reps) actually run → supplemental log e(rw_*). Borusyak DiD output to robustness.log." ///
             "All advanced estimators capture-guarded: absent ado / T=2 degeneracy ⇒ graceful skip; production T=19 activates.")

* fix(omni-g-esttab-csv, 2026-06-11): CSV side-channel — papers/bank_fintech_locus/
* tables.py:build_table5_robustness 经 read_paper_esttab(..., 'table5_robustness.csv') 消费。
estout `models' using "$tables_dir/table5_robustness.csv", replace delimiter(",") ///
    cells(b(star fmt(3)) se(par fmt(3))) stats(N r2 p_wild, fmt(0 3 3)) ///
    starlevels(* 0.10 ** 0.05 *** 0.01)

display "[OK] Table 5 (robustness) → $tables_dir/table5_robustness.tex (+ .csv side-channel)"
