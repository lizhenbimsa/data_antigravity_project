* ============================================================================
* 17_locus_heterogeneity.do — Table 4 heterogeneity (P4 bank_fintech_locus)
* Paper: {{PAPER_ID}}
* Plan: §5.5.2 P4 heterogeneity (R6-M03/M04 + R4-M03 三波严格对称)
*
* Heterogeneity dimensions:
*   (a) 三波 fintech 浪潮 (wave_1 2013-2015 / wave_2 2016-2018 / wave_3 2022-2024)
*       + consolidation period (2019-2021, 对照组)
*   (b) SOE × non-SOE
*   (c) 4 bank types
* ============================================================================

version 19
clear all
set more off
set maxvar 32767
set linesize 120

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"

use "$data_dir/_prepared_panel.dta", clear

set seed {{RANDOM_SEED}}

* ============================================================================
* (a) 三波 fintech 浪潮 + consolidation
* ============================================================================
foreach w in pre_period wave_1 wave_2 consolidation wave_3 {
    capture confirm variable `w'
    if !_rc {
        count if `w' == 1 & !missing(locus_layer_full, {{MAIN_DV}})
        if r(N) >= 10 {
            reghdfe {{MAIN_DV}} locus_layer_full locus_scenario_full $controls if `w' == 1, ///
                absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
            eststo wave_`w'
        }
        else {
            display "  [SKIP] wave `w' has " r(N) " obs (< 10; R7-m01)"
        }
    }
}

* Layer × wave interaction (main spec per R10-m03)
capture confirm variable wave_1 wave_2 consolidation wave_3
if !_rc {
    foreach w in wave_1 wave_2 consolidation wave_3 {
        gen layer_x_`w' = locus_layer_full * `w'
    }
    reghdfe {{MAIN_DV}} locus_layer_full wave_1 wave_2 consolidation wave_3 ///
        layer_x_wave_1 layer_x_wave_2 layer_x_consolidation layer_x_wave_3 ///
        $controls, absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    eststo layer_x_wave_interact
}

* ============================================================================
* (b) SOE × non-SOE split
* ============================================================================
* fix(omni-g-templates-08, 2026-06-11): SOE 二元列在面板中实名 is_soe (int64,
* runner.py:909 `is_soe = (bank_type=='soe')`), 旧 `confirm variable soe` 引用幻影列
* → SOE×非SOE 切分在任何 T 下永久静默跳过 (st-did-05 修复已在 substance/17 改对,
* 漏本站; 现对齐)。
capture confirm variable is_soe
if !_rc {
    reghdfe {{MAIN_DV}} locus_layer_full locus_scenario_full $controls if is_soe == 1, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    eststo soe_1
    reghdfe {{MAIN_DV}} locus_layer_full locus_scenario_full $controls if is_soe == 0, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    eststo soe_0
}

* ============================================================================
* (c) 4 bank types
* ============================================================================
capture confirm variable bank_type
if !_rc {
    * st-did-05 fix (2026-06-03): bank_type 是字符串列 (str), levelsof 产出字符串 token
    * ('soe'/'joint'/'city'/'rural'/...; 见 iv_did.py::load_bank_group_maps + runner.py:857).
    * 旧 `bank_type == `t'` 宏未加引号 → 字符串值无法解析为数值表达式, StataNow 19.5
    * 触发 r(198) invalid syntax. 改为 `bank_type == "`t'"` (宏外加双引号, 对齐 attention/17:37,39).
    levelsof bank_type, local(types)
    foreach t of local types {
        count if bank_type == "`t'" & !missing(locus_layer_full, {{MAIN_DV}})
        if r(N) >= 10 {
            reghdfe {{MAIN_DV}} locus_layer_full locus_scenario_full $controls if bank_type == "`t'", ///
                absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
            eststo type_`t'
        }
    }
}

* fix(omni-g-templates-07, 2026-06-11): esttab 名单动态化 — layer_x_wave_interact 在
* 守卫块内 (wave_* 缺失即跳过), 旧版硬点名缺名 → r(111) 丢整表; 通配 wave_*/soe_*/
* type_* 零匹配同样 r(111)。本文件开头 clear all 已清空估计命名空间。
qui estimates dir
local models `r(names)'
if "`models'" == "" {
    display as error "  [WARN] Table 4 无任何已存储估计 (全部切分被守卫跳过), 表跳过"
}
else {
    esttab `models' ///
        using "$tables_dir/table4_heterogeneity.tex", replace ///
        star(* 0.10 ** 0.05 *** 0.01) se booktabs label compress b(3) ///
        title("Table 4 — Heterogeneity (P4 locus; 三波 fintech 浪潮 × SOE × 4 bank types)") ///
        addnotes("Wave definition (R4-M03 三波严格对称): pre/wave_1/wave_2/consolidation/wave_3." ///
                 "Small-cell warning (R7-m01): cell N<10 skipped.")

    * fix(omni-g-esttab-csv, 2026-06-11): CSV side-channel — papers/bank_fintech_locus/
    * tables.py:build_table4_heterogeneity 经 read_paper_esttab(..., 'table4_heterogeneity.csv') 消费。
    estout `models' using "$tables_dir/table4_heterogeneity.csv", replace delimiter(",") ///
        cells(b(star fmt(3)) se(par fmt(3))) stats(N r2, fmt(0 3)) ///
        starlevels(* 0.10 ** 0.05 *** 0.01)

    display "[OK] Table 4 (heterogeneity) → $tables_dir/table4_heterogeneity.tex (+ .csv side-channel)"
}
