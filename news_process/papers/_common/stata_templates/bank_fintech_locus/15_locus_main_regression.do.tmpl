* ============================================================================
* 15_locus_main_regression.do — Table 2 M1→M6 progressive (P4 bank_fintech_locus)
* Paper: {{PAPER_ID}}
* Plan: §5.5.2 + §B.4 P4 spec
*
*   DV  = {{MAIN_DV}}          (car_5day_window per spec.outcome.primary)
*   X   = locus_layer_full / locus_scenario_full  (primary_pair, R35-M02 derived)
*
*   Theory anchor: Gomber 2018 JMIS (taxonomy: technology vs business function) +
*                  Kogan 2017 QJE (market-value weighted innovation).
*
* M1-M6: layer × event study baseline (per spec.identification.baseline).
* ============================================================================

version 19
clear all
set more off
set maxvar 32767
set linesize 120

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"

use "$data_dir/_prepared_panel.dta", clear

set seed {{RANDOM_SEED}}

* M1: bare (locus pair only)
reghdfe {{MAIN_DV}} locus_layer_full locus_scenario_full, ///
    noabsorb vce(cluster {{CLUSTER_VAR}})
eststo M1

* M2: + bank FE
reghdfe {{MAIN_DV}} locus_layer_full locus_scenario_full, ///
    absorb(bank_id) vce(cluster {{CLUSTER_VAR}})
eststo M2

* M3: + bank FE + year FE
reghdfe {{MAIN_DV}} locus_layer_full locus_scenario_full, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo M3

* M4: + bank-level controls
reghdfe {{MAIN_DV}} locus_layer_full locus_scenario_full $controls, ///
    absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
eststo M4

* M5: + macro
capture confirm variable gdp_growth m2_growth
if !_rc {
    reghdfe {{MAIN_DV}} locus_layer_full locus_scenario_full $controls gdp_growth m2_growth, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    eststo M5
}
else {
    * fix(omni-g-replication-05, 2026-06-11): 显式披露 — 宏观列缺失时 M5 复用 M4 规格 (非真 "+macro")
    display "  [INFO] gdp_growth / m2_growth 不存在 (宏观 enrichment pending); M5 复用 M4 规格"
    eststo M5: reghdfe {{MAIN_DV}} locus_layer_full locus_scenario_full $controls, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
}

* M6: locus_gap (∈ {-1, +1}) as compact alternative
capture confirm variable locus_gap
if !_rc {
    reghdfe {{MAIN_DV}} locus_gap $controls, ///
        absorb(bank_id year) vce(cluster {{CLUSTER_VAR}})
    eststo M6_gap
}

* Test layer ≠ scenario coefficient (formal layer-vs-scenario differential)
test locus_layer_full = locus_scenario_full

* fix(omni-g-templates-07, 2026-06-11): esttab 名单动态化 — M6_gap 在守卫块内
* (locus_gap 缺失即跳过), 旧版硬点名缺名 → r(111) 丢整表且 master 链中止。
qui estimates dir
local stored `r(names)'
local cand_models M1 M2 M3 M4 M5 M6_gap
local cand_titles `""M1 bare" "M2 +bankFE" "M3 +yearFE" "M4 +ctrl" "M5 +macro" "M6 locus_gap""'
local models ""
local mtitles `""'
local nmod : word count `cand_models'
forvalues i = 1/`nmod' {
    local m : word `i' of `cand_models'
    if `: list m in stored' {
        local models `models' `m'
        local t : word `i' of `cand_titles'
        local mtitles `"`mtitles' "`t'""'
    }
}
esttab `models' using "$tables_dir/table2_main.tex", replace ///
    star(* 0.10 ** 0.05 *** 0.01) se booktabs label compress b(3) ///
    title("Main Results --- bank_fintech_locus (P4)") ///
    mtitles(`mtitles') ///
    addnotes("bank / year FE; SE clustered at {{CLUSTER_VAR}}; layer × event study baseline (per spec)." ///
             "Wald test layer = scenario in log.")

* fix(omni-g-esttab-csv, 2026-06-11): CSV side-channel — papers/bank_fintech_locus/
* tables.py:build_table2_main 经 read_paper_esttab(..., 'table2_main.csv') 消费;
* estout+delimiter(",") 防 esttab csv 的 ="..." Excel 包裹破坏 parse_esttab_csv 解析。
estout `models' using "$tables_dir/table2_main.csv", replace delimiter(",") ///
    cells(b(star fmt(3)) se(par fmt(3))) stats(N r2, fmt(0 3)) ///
    starlevels(* 0.10 ** 0.05 *** 0.01) mlabels(`mtitles')

display "[OK] Table 2 (M1-M6) → $tables_dir/table2_main.tex (+ .csv side-channel)"
