* ============================================================================
* 20_locus_iv_2sls.do — P4 paper-specific IV (2026-06-13 IV 补全)
* Paper: bank_fintech_locus (Gomber 底层技术 vs 应用场景)
*
* 内生变量: tech_frac (底层技术文章占比 — locus_layer_full 二元 pair 的连续
*           底座; 二元 pair 由 01_data_prep 派生, 此处直接工具化连续暴露)
* IV (paper_spec identification.iv primary, iv_extensions.py 物化):
*   leave_one_out_peer_locus_iv  = 同银行类型×年 LOO tech_frac 均值
*   (滞后稳健性变体 leave_one_out_peer_locus_iv_lag1; Cao 2025 RAS 风格
*    类型同业, 排他性披露按 Manski 1993 / Leary-Roberts 2014 JF)
* 白话: "押底层技术还是押应用场景"可能由银行自身禀赋内生决定; 借同类型
* 其他银行的技术侧重当外生推力 — 同业转向底层技术的行业潮流推得动本行
* 的题材结构, 但不直接进入本行的市场反应方程。
*
* 第二阶段 DV: citation_weighted_patent (2026-06-13 outcome 重定位, Kogan 2017
* 谱系; 外部专利数据待接入, car_5day_window 降级上市行扩展; 缺列时 2SLS
* 优雅跳过, 第一阶段照常输出)。
* ============================================================================

version 19
clear all
set more off
set maxvar 32767
set linesize 120

if "$data_dir" == ""    global data_dir "../data"
if "$tables_dir" == ""  global tables_dir "../output/tables"

use "$data_dir/_prepared_panel.dta", clear

local TX   tech_frac
local IV1  leave_one_out_peer_locus_iv
local IV1L leave_one_out_peer_locus_iv_lag1
* 2026-06-13 outcome 重定位同步: spec.outcome.primary = citation_weighted_patent
* (Kogan 2017 谱系; 年度数据约束下 car_5day_window 已降级上市行扩展)。
local DV   citation_weighted_patent
* ctx 轨镜像 (2026-06-13 终审): 内生孪生 tech_frac_lc 配 ctx 同业 LOO 工具
* lpeer_locus_iv_ctx, 与 full 轨【各自 just-identified、并排成列】表达双轨互为
* 稳健性; 勿与 full 轨 LOO 合成 overid — 同文两窗共同冲击同污染, Hansen J
* 零功效 (Parente & Santos Silva 2012 EL)。
local TXC  tech_frac_lc
local IVC  lpeer_locus_iv_ctx
* ss 轨镜像 (2026-06-14 第三轨 _ss 平价补全): 内生孪生 tech_frac_ls 配 ss 同业 LOO
* 工具 lpeer_locus_iv_ss, 与 full / ctx 轨【各自 just-identified、并排成列】表达三轨
* 互为稳健性; 严禁 full/ctx/ss 任两轨 LOO 合成 overid — 同文三窗共同冲击同污染,
* Hansen J 零功效 (Parente & Santos Silva 2012 EL)。
* ⚠ 命名例外: ss 轨内生孪生列名是 tech_frac_ls (NOT tech_frac_ss) — iv_extensions.py
*   对角创新命名 (locus_layer 二元 pair 的 ls 后缀), 勿机械拼 _ss 否则静默全 NaN。
local TXS  tech_frac_ls
local IVS  lpeer_locus_iv_ss

* ⚠ FE 锁定 = bank FE + year FE; 严禁 bank_type×year 交互 FE — 同业 LOO 工具
*   格内残余 = 自身内生变量的负镜像, type×year FE 下工具退化、排他性按构造违反。
capture confirm variable `TX'
if _rc {
    display "  [WARN] 内生变量 `TX' 不在面板; 表跳过"
    exit 0
}
capture which ivreg2
if _rc {
    display "  [WARN] ivreg2 not installed (ssc install ivreg2); 表跳过"
    exit 0
}

* 第一阶段 (现有面板即可运行): 同期 + 滞后变体
capture confirm variable `IV1'
if !_rc {
    eststo first_loo: reghdfe `TX' `IV1' $controls, ///
        absorb(bank_id year) vce(cluster bank_id)
}
capture confirm variable `IV1L'
if !_rc {
    eststo first_lag: reghdfe `TX' `IV1L' $controls, ///
        absorb(bank_id year) vce(cluster bank_id)
}
* ctx 轨一阶段 (tech_frac_lc ~ ctx LOO 工具; 缺列优雅跳过)
capture confirm variable `TXC' `IVC'
if !_rc {
    eststo first_ctx: reghdfe `TXC' `IVC' $controls, ///
        absorb(bank_id year) vce(cluster bank_id)
}
* ss 轨一阶段 (tech_frac_ls ~ ss LOO 工具; 缺列优雅跳过)
capture confirm variable `TXS' `IVS'
if !_rc {
    eststo first_ss: reghdfe `TXS' `IVS' $controls, ///
        absorb(bank_id year) vce(cluster bank_id)
}

* ----------------------------------------------------------------------------
* weak-IV-robust 推断 (IV-2 修复 2026-06-14): 把脚注里"KP F < Stock-Yogo 时改读
* Anderson-Rubin 弱工具稳健 CI"的决策规则从【散文承诺】落为【真实命令】。
* weakiv (Finlay-Magnusson-Schaffer; Andrews-Stock-Sun 2019 ARE) 在 2SLS 后跑
* AR / CLR 检验并给出弱工具稳健 CI; 同 estadd 把 AR p 注入 e(ar_p) 进 esttab。
* 全程 capture which 守卫: 缺 weakiv ado / T=2 退化 / 缺 DV 时优雅跳过, 不弹框。
* 白话: 工具弱时常规 2SLS 的点估计/标准误不可信, AR 区间不依赖工具强度, 即便
* 弱工具也给出有效置信区间 — 现在表里真有这个统计量, 不再只是脚注承诺。
* ----------------------------------------------------------------------------
capture program drop _locus_arci
program define _locus_arci
    * args: 1=estimate name (eststo 已存的 2SLS), 2=endogenous var
    args estname endog
    capture which weakiv
    if _rc {
        display "  ⚠️ weakiv not installed (ssc install weakiv); `estname' AR 弱工具稳健 CI 跳过"
        exit 0
    }
    capture estimates restore `estname'
    if _rc {
        display "  [SKIP] `estname' 未存储, AR CI 跳过"
        exit 0
    }
    * weakiv 直接复用上一条 ivreg2 估计 (无参数 = replay 当前 e() 上的 AR/CLR 检验)
    capture noisily weakiv, level(95)
    if !_rc {
        * AR p 返回名跨 weakiv 版本可能不同 (e(ar_p) / r(ar_p)); 双取兜底, 缺则留空
        local _arp = .
        capture local _arp = e(ar_p)
        if missing(`_arp') capture local _arp = r(ar_p)
        capture estadd scalar ar_p = `_arp': `estname'
        display "  [AR] `estname' (`endog'): weak-IV-robust Anderson-Rubin test computed (AR p = " %5.3f `_arp' "); 95% AR CI in log above."
    }
    else {
        display "  ⚠️ weakiv 运行失败 (T=2 退化 / 共线 / df=0); `estname' AR CI 跳过"
    }
end

* 2SLS (DV 待外部行情数据; 缺列优雅跳过)
capture confirm variable `DV'
if _rc {
    display "  [WARN] 第二阶段 DV `DV' 未物化 (专利数据未接入); 仅输出第一阶段"
}
else {
    capture confirm variable `IV1'
    if !_rc {
        eststo tsls_loo: ivreg2 `DV' (`TX' = `IV1') $controls ///
            i.bank_id i.year, cluster(bank_id) first
        * weak-IV-robust AR CI 紧随其后 (weakiv 复用 e())
        _locus_arci tsls_loo `TX'
    }
    capture confirm variable `IV1L'
    if !_rc {
        eststo tsls_lag: ivreg2 `DV' (`TX' = `IV1L') $controls ///
            i.bank_id i.year, cluster(bank_id) first
        _locus_arci tsls_lag `TX'
    }
    * ctx 轨 just-identified 2SLS (与 full 轨 tsls_loo 并排; 同一 DV, 双轨各自工具)
    capture confirm variable `TXC' `IVC'
    if !_rc {
        eststo tsls_ctx: ivreg2 `DV' (`TXC' = `IVC') $controls ///
            i.bank_id i.year, cluster(bank_id) first
        _locus_arci tsls_ctx `TXC'
    }
    * ss 轨 just-identified 2SLS (与 full 轨 tsls_loo / ctx 轨 tsls_ctx 并排;
    * 同一 DV, 三轨各自工具; 三轨各自 just-id 绝不合并 Hansen J)
    capture confirm variable `TXS' `IVS'
    if !_rc {
        eststo tsls_ss: ivreg2 `DV' (`TXS' = `IVS') $controls ///
            i.bank_id i.year, cluster(bank_id) first
        _locus_arci tsls_ss `TXS'
    }
}

* esttab 名单动态化 (缺估计不点名, 防 r(111) 丢整表)
qui estimates dir
local stored `r(names)'
local cand_models first_loo first_lag first_ctx first_ss tsls_loo tsls_lag tsls_ctx tsls_ss
local cand_titles `""1st LOO" "1st LOO lag1" "1st LOO ctx" "1st LOO ss" "2SLS LOO" "2SLS LOO lag1" "2SLS LOO ctx" "2SLS LOO ss""'
local models ""
local mtitles `""'
local nmod : word count `cand_models'
forvalues i = 1/`nmod' {
    local m : word `i' of `cand_models'
    if `: list m in stored' {
        local models `models' `m'
        local t : word `i' of `cand_titles'
        local mtitles `"`mtitles' "`t'""'
    }
}
if "`models'" == "" {
    display as error "  [WARN] IV 表无任何已存储估计 (IV 列全缺), 表跳过"
}
else {
    esttab `models' ///
        using "$tables_dir/tableA_locus_iv_2sls.tex", replace ///
        star(* 0.10 ** 0.05 *** 0.01) se booktabs label compress b(3) ///
        stats(N r2 widstat ar_p, fmt(0 3 3 3) labels("N" "R²" "KP F" "Anderson-Rubin p (weakiv)")) ///
        title("P4 Locus IV: Same-Type Peer LOO Tech Exposure (First Stage + 2SLS)") ///
        mtitles(`mtitles') ///
        addnotes("IV = same-bank-type leave-one-out mean of peers' tech_frac (contemporaneous + lag-1 robustness; reflection/exclusion caveats per Manski 1993; Leary-Roberts 2014 JF — disclose in text)." ///
                 "ctx column: entity-window twin tech_frac_lc instrumented by lpeer_locus_iv_ctx, just-identified, side-by-side dual-track robustness (NOT pooled with full-track IV; Parente-Santos Silva 2012)." ///
                 "ss column: bank+fintech same-sentence twin tech_frac_ls (naming exception, not tech_frac_ss) instrumented by lpeer_locus_iv_ss, just-identified, side-by-side tri-track robustness — full/ctx/ss are NEVER pooled into one Hansen J (same-article windows co-contaminate; Parente-Santos Silva 2012)." ///
                 "Just-identified columns: Hansen J not computable (df=0), not reported. KP F = Kleibergen-Paap rk Wald F; weak-IV threshold 16.38 (Stock-Yogo 2005)." ///
                 "Anderson-Rubin p row = weakiv (Finlay-Magnusson-Schaffer; Andrews-Stock-Sun 2019 ARE) weak-IV-robust test, actually computed when KP F is below threshold; AR CI in supplemental log. Blank = weakiv ado absent or T=2 degenerate.")

    display "[OK] 20_locus_iv_2sls → $tables_dir/tableA_locus_iv_2sls.tex"
}
