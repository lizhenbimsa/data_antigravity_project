* news_process v3.2.0 — Figure 1: 事件研究 Event Study (plan v14 §9.2)
*
* DID 平行趋势 + 动态处理效应 (Sun & Abraham 2021 JoE):
*   y_{i,t} = Σ_τ β_τ × D_{i, t=τ} + α_i + γ_t + ε_{i,t}
* 白话: 事件研究图把处理前后各年的效应分别画出来 — 处理前各年的系数应接近 0
* (说明处理组与对照组事前走势平行, DiD 前提成立), 处理后的系数轨迹则展示效应随时间的演变。
* 注 (2026-06-14 DID-5 修复): 头注—估计量不一致已修 — 若装 eventstudyinteract 则真跑
* Sun-Abraham (2021) interaction-weighted 估计 (异质处理效应稳健); 未装才回退标准 TWFE
* lead/lag, 并在图脚注如实标注实际所用估计量。下方 has_es 探测结果现已被消费。
* 注 (2026-06-14 DID-6 修复): lead/lag 窗口不再硬编码 ±3 — 据样本实有年份跨度动态设定
* (T=19 用 ±5, 小样本退化到可用宽度), 不浪费 T=19 功效, 早期试跑 T=2 仍优雅退化。
* 设计披露 (2026-06-16 S1-04): digital_frontier 是【基年截面固定分组】(runner.py:1138,
* _base_year_median_split, "组员资格跨年固定"), 非交错采纳事件 — 故 _first_treat (line 33)
* 对每家处理组银行都坍缩为面板首年, 全部处理观测 _rel_time ≥ 0: 无处理前 lead、单一
* cohort、即便满 T=19 也无交错时变。因此本图本质是【固定分组 × 时间 DiD】, 而非 Sun-Abraham
* 交错事件研究; 上方"处理前各年系数≈0 / 平行趋势"(line 5-6) 在此变量下结构性无法产出
* (无 lead 可画)。eventstudyinteract 路径无 cohort 异质可加权, 多退回 TWFE。如需真正的
* 事件研究, 应把相对时间锚到面板已构建的真实时变政策日 (如 dcep_post/sandbox_post/
* depins_post 的年阈值), 而非锚到基年分组指示符 digital_frontier。
*
* 主 spec: locus={{MAIN_LOCUS_TRACK}} subst={{MAIN_SUBST_TRACK}} sent={{MAIN_SENT_TRACK}}

version 19

local DV     llm_vote_tone_{{MAIN_SENT_TRACK}}

* 检查 eventstudyinteract / did_imputation 可用性 (Sun-Abraham 2021 / Borusyak-Jaravel-Spiess 2024)
capture which eventstudyinteract
local has_es = !_rc

* 处理时点 (假定 digital_frontier 作处理变量, 用户层可改)
capture confirm variable digital_frontier
if _rc {
    display "  ⏭ digital_frontier 不存在, Event Study 跳过"
    exit 0
}

* 处理时点 (绝对相对时间 = year - first_treat_year)
preserve
    bysort bank_id (year): gen byte _ever_treat = sum(digital_frontier) > 0
    bysort bank_id (year): egen _first_treat = min(cond(digital_frontier == 1, year, .))
    gen _rel_time = year - _first_treat if !missing(_first_treat)

    * DID-6: 窗口宽度据样本实有年份跨度动态设定 (T=19 用 ±5, 小样本退化), 不硬编码 ±3。
    quietly summarize year
    local _yspan = r(max) - r(min)
    local W = min(5, max(1, `_yspan'))   // 上限 5 (避免极稀疏边角), 下限 1
    display as text "── Event-study 窗口宽度 W = `W' (年份跨度=`_yspan') ──"

    * 截尾 ±W
    replace _rel_time = -`W' if _rel_time < -`W'
    replace _rel_time = `W' if _rel_time > `W' & !missing(_rel_time)

    * 创建 lead/lag dummies (动态宽度) + 动态拼 coefplot 名单与标签
    local es_terms ""
    local cp_rename ""
    forvalues t = -`W'/`W' {
        if `t' != -1 {
            local sign = cond(`t' < 0, "L", "F")
            local absT = abs(`t')
            cap drop _`sign'`absT'
            gen byte _`sign'`absT' = _rel_time == `t'
            local es_terms "`es_terms' _`sign'`absT'"
            local cp_rename `cp_rename' _`sign'`absT'="`t'"
        }
    }

    * DID-5: 优先 Sun-Abraham (eventstudyinteract) 异质稳健估计; 未装回退标准 TWFE。
    local est_label ""
    if `has_es' {
        * eventstudyinteract 需 never-treated / last-treated 控制 cohort + 相对时间哑变量。
        * cohort = _first_treat (never-treated 为 missing); control_cohort = never-treated 指示。
        cap drop _never_treat
        gen byte _never_treat = missing(_first_treat)
        capture noisily eventstudyinteract `DV' `es_terms', ///
            absorb(bank_id year) cohort(_first_treat) control_cohort(_never_treat) vce(cluster bank_id)
        if !_rc {
            local est_label "Sun-Abraham (2021) interaction-weighted, heterogeneity-robust"
            display as text "  ✅ eventstudyinteract (Sun-Abraham) 估计完成"
        }
        else {
            display as text "  ⚠️ eventstudyinteract 退化 (早期试跑 T=2 无 never-treated/cohort 变异?), 回退 TWFE"
            local has_es = 0
        }
    }
    if !`has_es' {
        * 标准 TWFE 回退
        reghdfe `DV' `es_terms', absorb(bank_id year) vce(cluster bank_id)
        local est_label "Standard TWFE lead/lag (eventstudyinteract not installed/degraded)"
    }

    * coefplot (ssc install coefplot)
    * DID-5 修复 (2026-06-14): 头注—图内容一致。eventstudyinteract 把 IW 聚合估计存在
    * e(b_iw)/e(V_iw) (非标准 e(b)/e(V) — 后者是底层 cohort×相对时间饱和系数, 名也不是
    * _L1/_F1), 故 SA 成功路径必须画 matrix(e(b_iw)) (镜像 collab/19:108-112); 只有
    * TWFE 回退路径才用 keep(es_terms)+rename(cp_rename) 画标准 e(b) 的 lead/lag。
    * 此前两路径共用 keep(es_terms) → SA 时取错系数 (空图/画非 IW 结果, 与头注不符)。
    capture which coefplot
    if !_rc {
        local _cp_done = 0
        if `has_es' {
            * Sun-Abraham 成功路径: 画 interaction-weighted 聚合估计 (e(b_iw)/e(V_iw))
            capture matrix _sa_b = e(b_iw)
            capture matrix _sa_V = e(V_iw)
            capture noisily coefplot matrix(_sa_b), se(_sa_V) ///
                vertical yline(0, lpattern(dash)) xtitle("Years from treatment") ///
                ytitle("β (effect on Tone)") ///
                title("Figure 1: Event Study — Digital Frontier Treatment") ///
                note("Dynamic effects (`est_label'). Reference: t=-1. Window ±`W'." ///
                     "digital_frontier is a time-invariant base-year group (single cohort," ///
                     "no leads): fixed-group-by-time DiD, not a staggered event study.")
            if !_rc local _cp_done = 1
        }
        if !`_cp_done' {
            * TWFE 回退路径 (或 SA 的 IW 矩阵绘图退化): 画标准 e(b) 的 lead/lag 系数
            capture noisily coefplot, ///
                keep(`es_terms') ///
                rename(`cp_rename') ///
                vertical yline(0, lpattern(dash)) xtitle("Years from treatment") ///
                ytitle("β (effect on Tone)") ///
                title("Figure 1: Event Study — Digital Frontier Treatment") ///
                note("Dynamic effects (`est_label'). Reference: t=-1. Window ±`W'." ///
                     "digital_frontier is a time-invariant base-year group (single cohort," ///
                     "no leads): fixed-group-by-time DiD, not a staggered event study.")
            if !_rc local _cp_done = 1
        }
        if `_cp_done' {
            graph export "output/figures/figure1_event_study.pdf", replace
            display "✅ Figure 1 saved to output/figures/figure1_event_study.pdf (`est_label')"
        }
        else {
            display "  ⚠️ coefplot 退化跳过 (rc=`=_rc'); Figure 1 未导出"
        }
    }
    else {
        display "  ⚠️ coefplot not installed (ssc install coefplot); Figure 1 跳过"
    }
restore
