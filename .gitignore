# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.egg-info/
*.egg
dist/
build/
.pytest_cache/
.tmp/
.test_tmp/
/tmp*/
news_process/.pytest_cache/
news_process/.test_tmp/

# ============================================================
# 虚拟环境
# ============================================================
.venv/

# ============================================================
# 敏感文件
# ============================================================
.env
.env.*
# Phase 1: ``.env.example`` is a tracked template (variable names only, no values).
!.env.example
!**/.env.example

# ============================================================
# IDE / 编辑器配置
# ============================================================
.idea/
.vscode/
.claude/
*.swp
*.swo
*~

# ============================================================
# 数据文件 (全局排除大型二进制/数据文件)
# ============================================================
*.csv
*.parquet
*.xlsx
*.xls
*.db
*.sqlite
*.sqlite3
~$*.xlsx

# ============================================================
# 特殊包含 -- 配置目录下的必要字典/数据文件
# ============================================================
!news_process/config/*.json
!news_process/config/*.xlsx
!news_process/config/dicts_excel/**

# ============================================================
# 模型文件
# ============================================================
news_process/models/
*.bin
*.onnx
*.pt
*.pth
*.h5
*.pkl

# ============================================================
# 日志文件
# ============================================================
news_process/logs/
*.log

# ============================================================
# 处理后的数据 & 原始数据
# ============================================================
# Phase 8 (2026-05-04): data_processed/ 重命名为 data/processed/
news_process/data/
news_process/data_excel/

# ============================================================
# 备份/旧版本存档
# ============================================================
news_process/yback/
*.zip

# ============================================================
# 子仓库 (FinBERT 有自己独立的 .git)
# ============================================================
FinBERT/

# ============================================================
# 论文 / 参考资料 (非代码, 二进制文件)
# ============================================================
# Phase 1/3 注: ``news_process/papers/`` 同名目录现引入为 Python 子包。
# 不能整目录 ignore (否则后续 .py 无法重新包含)；改为按内容类型排除二进制
# 而保留代码与子包结构。
news_process/papers/**/*.pdf
news_process/papers/**/*.docx
news_process/papers/**/*.doc
news_process/papers/**/*.zip
news_process/papers/**/*.epub
news_process/papers/**/*.md
*.pdf

# ============================================================
# Phase 3: papers_assets/ — 非代码研究资产
# ============================================================
# 文献库为纯参考材料 (35MB+ PDF/MD)，永不入仓
news_process/papers_assets/literature/
# 论文产出二进制 (生成文件)，默认忽略
news_process/papers_assets/**/output/
news_process/papers_assets/**/drafts/*.pdf
news_process/papers_assets/**/drafts/*.docx
news_process/papers_assets/**/drafts/*.doc
news_process/papers_assets/**/drafts/*.zip
# 显式白名单 (即使匹配上面规则也予以追踪)：
!news_process/papers_assets/**/*.do
!news_process/papers_assets/**/*.do.tmpl
!news_process/papers_assets/**/*.tex
!news_process/papers_assets/**/*.bib
!news_process/papers_assets/**/README.md

# ============================================================
# 操作系统生成文件
# ============================================================
Thumbs.db
Desktop.ini
.DS_Store

