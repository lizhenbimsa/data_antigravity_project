# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.egg-info/
*.egg
dist/
build/
.pytest_cache/
.tmp/
.test_tmp/
/tmp*/
news_process/.pytest_cache/
news_process/.test_tmp/

# Scratch / coverage artifacts (F-12, 2026-05-16):
# Root-level scratch files (e.g. .tmp_round3.py during audit/debug sessions)
# and coverage outputs must not leak via `git add -A`.
/.tmp_*
/.coverage
/.coverage.*

# ============================================================
# 虚拟环境
# ============================================================
.venv/

# ============================================================
# 敏感文件
# ============================================================
.env
.env.*
# Phase 1: ``.env.example`` is a tracked template (variable names only, no values).
!.env.example
!**/.env.example

# ============================================================
# IDE / 编辑器配置
# ============================================================
.idea/
.vscode/
.claude/
.gemini/
.cursor/
*.swp
*.swo
*~

# ============================================================
# 数据文件 (全局排除大型二进制/数据文件)
# ============================================================
*.csv
*.parquet
*.xlsx
*.xls
*.db
*.sqlite
*.sqlite3
~$*.xlsx

# ============================================================
# 特殊包含 -- 配置目录下的必要字典/数据文件
# ============================================================
!news_process/config/*.json
!news_process/config/*.xlsx
!news_process/config/dicts_excel/**

# 四权源商业 dta (~4.4GB, 商业许可) 恒不入库 (COMPANY_BANK_COOC_PANEL 计划 v33 J2/WP4)
news_process/config/*.dta

# ============================================================
# 模型文件
# ============================================================
news_process/models/
*.bin
*.onnx
*.pt
*.pth
*.h5
*.pkl

# ============================================================
# 日志文件
# ============================================================
news_process/logs/
news_process/company_listed_bank/logs/
*.log

# ============================================================
# 处理后的数据 & 原始数据
# ============================================================
# Phase 8 (2026-05-04): data_processed/ 重命名为 data/processed/
news_process/data/
news_process/data_excel/
# 2026-07-07: 银企共现面板流水线产物 (~13GB dta/parquet, 镜像 data/processed 不入库惯例)
news_process/company_listed_bank/data/
# 2026-06-26 (A6 修复): stage 70 prompt_sensitivity 等验证诊断产物的落点已统一对齐到
# data/processed/eval_reports/ (受 news_process/data/ 整树忽略); 历史误落源码树的
# validation/eval_reports/ 一律忽略, 杜绝研究产物再泄漏进版本库。
news_process/validation/eval_reports/

# ============================================================
# 文档构建输出 (Phase D, 2026-05-04)
# ============================================================
docs/_build/
docs/api/_autosummary/
docs/api/generated/

# ============================================================
# 备份/旧版本存档
# ============================================================
news_process/yback/
*.zip

# ============================================================
# FinBERT（原嵌套仓库；纳入主仓跟踪源码与配置，权重大文件不入库）
# 上游: https://github.com/valuesimplex/FinBERT.git
# ============================================================
FinBERT/**/*.safetensors
!FinBERT/**/*.csv
# v3.2.0 M4 P5.6 (plan v14 §3.5): 方法学迁移文档 CSV 允许入库
!news_process/docs/methodology/migrations/*.csv

# ============================================================
# 论文 / 参考资料 (非代码, 二进制文件)
# ============================================================
# Phase 1/3 注: ``news_process/papers/`` 同名目录现引入为 Python 子包。
# 不能整目录 ignore (否则后续 .py 无法重新包含)；改为按内容类型排除二进制
# 而保留代码与子包结构。
news_process/papers/**/*.pdf
news_process/papers/**/*.docx
news_process/papers/**/*.doc
news_process/papers/**/*.zip
news_process/papers/**/*.epub
news_process/papers/**/*.md
# v3.2.0 M6/M7 (plan v14 §9.2): Stata 模板 README (双语) 允许入库
!news_process/papers/_common/stata_templates/README.md
*.pdf

# ============================================================
# Phase 3: papers_assets/ — 非代码研究资产
# ============================================================
# 文献库为纯参考材料 (35MB+ PDF/MD)，永不入仓
news_process/papers_assets/literature/
# 论文产出二进制 (生成文件)，默认忽略
news_process/papers_assets/**/output/
news_process/papers_assets/**/drafts/*.pdf
news_process/papers_assets/**/drafts/*.docx
news_process/papers_assets/**/drafts/*.doc
news_process/papers_assets/**/drafts/*.zip
# 显式白名单 (即使匹配上面规则也予以追踪)：
!news_process/papers_assets/**/*.do
!news_process/papers_assets/**/*.do.tmpl
!news_process/papers_assets/**/*.tex
!news_process/papers_assets/**/*.bib
!news_process/papers_assets/**/README.md

